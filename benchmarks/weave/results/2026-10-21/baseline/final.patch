diff --git a/tests/test_core.py b/tests/test_core.py
index e642534..b0b5bb0 100644
--- a/tests/test_core.py
+++ b/tests/test_core.py
@@ -1,6 +1,67 @@
+import copy
 import unittest
 from configkit import merge
 
 class CoreTests(unittest.TestCase):
     def test_existing_scalar(self):
         self.assertEqual(merge({'x': 1}, {'x': 2}), {'x': 2})
+
+    def test_recursive_merge_replacements_and_deletions(self):
+        base = {'nested': {'keep': 1, 'replace': 2, 'remove': 3},
+                'list': [1, 2], 'scalar': 5, 'remove': 9}
+        override = {'nested': {'replace': 4, 'remove': None, 'absent': None},
+                    'list': [3], 'scalar': {'new': 6, 'absent': None},
+                    'remove': None, 'absent': None}
+        self.assertEqual(merge(base, override), {
+            'nested': {'keep': 1, 'replace': 4}, 'list': [3],
+            'scalar': {'new': 6}})
+
+    def test_dictionary_can_be_replaced_by_scalar_or_list(self):
+        self.assertEqual(merge({'a': {'x': 1}, 'b': {'y': 2}},
+                               {'a': 3, 'b': [4]}), {'a': 3, 'b': [4]})
+
+    def test_result_is_detached_and_inputs_are_unchanged(self):
+        base = {'unchanged': [{'a': [1]}], 'nested': {'old': [2]}}
+        override = {'nested': {'new': [{'b': [3]}]}, 'added': [4]}
+        original_base, original_override = copy.deepcopy((base, override))
+        result = merge(base, override)
+        self.assertEqual(base, original_base)
+        self.assertEqual(override, original_override)
+        result['unchanged'][0]['a'].append(9)
+        result['nested']['old'].append(9)
+        result['nested']['new'][0]['b'].append(9)
+        result['added'].append(9)
+        self.assertEqual(base, original_base)
+        self.assertEqual(override, original_override)
+
+    def test_invalid_roots_raise_value_error(self):
+        for invalid in (None, [], 'text', 1, True):
+            with self.subTest(invalid=invalid):
+                with self.assertRaises(ValueError):
+                    merge(invalid, {})
+                with self.assertRaises(ValueError):
+                    merge({}, invalid)
+
+    def test_reserved_keys_are_rejected_in_both_inputs(self):
+        invalid_values = [
+            {'__secret': 1},
+            {'nested': {'__secret': 1}},
+            {'items': [{'nested': [{'__secret': 1}]}]},
+        ]
+        for invalid in invalid_values:
+            with self.subTest(invalid=invalid):
+                with self.assertRaises(ValueError):
+                    merge(invalid, {})
+                with self.assertRaises(ValueError):
+                    merge({}, invalid)
+
+    def test_validate_base_branches_before_replacing_or_deleting(self):
+        for replacement in (None, 1, [], {}):
+            with self.subTest(replacement=replacement):
+                with self.assertRaises(ValueError):
+                    merge({'branch': [{'__hidden': 1}]},
+                          {'branch': replacement})
+
+    def test_non_reserved_underscore_keys_are_allowed(self):
+        self.assertEqual(merge({'_private': 1}, {'normal__key': 2}),
+                         {'_private': 1, 'normal__key': 2})
