 import copy
 
-def merge(base, override):
+
+def _validate(value):
+    if isinstance(value, dict):
+        for key, child in value.items():
+            if isinstance(key, str) and key.startswith('__'):
+                raise ValueError(f'reserved configuration key: {key}')
+            _validate(child)
+    elif isinstance(value, list):
+        for child in value:
+            _validate(child)
+
+
+def _merge(base, override):
     result = copy.deepcopy(base)
-    result.update(override)
+    for key, value in override.items():
+        if value is None:
+            result.pop(key, None)
+        elif isinstance(value, dict):
+            previous = result.get(key)
+            result[key] = _merge(previous if isinstance(previous, dict) else {},
+                                 value)
+        else:
+            result[key] = copy.deepcopy(value)
     return result
+
+
+def merge(base, override):
+    """Merge detached configurations, using null overrides to delete keys."""
+    if not isinstance(base, dict) or not isinstance(override, dict):
+        raise ValueError('configuration roots must be dictionaries')
+    # Validate both complete inputs before replacement can hide invalid branches.
+    _validate(base)
+    _validate(override)
+    return _merge(base, override)
