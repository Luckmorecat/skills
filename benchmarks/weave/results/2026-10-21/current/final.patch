 import copy
 
-def merge(base, override):
+
+def _validate(value):
+    if isinstance(value, dict):
+        for key, child in value.items():
+            if isinstance(key, str) and key.startswith('__'):
+                raise ValueError(f'reserved configuration key: {key!r}')
+            _validate(child)
+    elif isinstance(value, list):
+        for child in value:
+            _validate(child)
+
+
+def _merge(base, override):
     result = copy.deepcopy(base)
-    result.update(override)
+    for key, value in override.items():
+        if value is None:
+            result.pop(key, None)
+        elif isinstance(value, dict):
+            prior = result.get(key)
+            result[key] = _merge(prior if isinstance(prior, dict) else {}, value)
+        else:
+            result[key] = copy.deepcopy(value)
     return result
+
+
+def merge(base, override):
+    """Merge dictionary layers, deleting null overrides and detaching the result."""
+    if not isinstance(base, dict) or not isinstance(override, dict):
+        raise ValueError('base and override must both be dictionaries')
+    # Validate complete inputs before merging so replaced branches cannot hide keys.
+    _validate(base)
+    _validate(override)
+    return _merge(base, override)
