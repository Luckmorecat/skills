@@ -13,3 +24,60 @@ class CliTests(unittest.TestCase):
             r = subprocess.run([sys.executable, '-m', 'configkit', str(p)], capture_output=True, text=True)
             self.assertEqual(r.returncode, 0)
             self.assertEqual(json.loads(r.stdout), {'x': 1})
+            self.assertEqual(r.stderr, '')
+
+    def test_layered_files(self):
+        with tempfile.TemporaryDirectory() as d:
+            base = pathlib.Path(d) / 'base.json'
+            override = pathlib.Path(d) / 'override.json'
+            base.write_text(json.dumps({'nested': {'keep': 1, 'drop': 2},
+                                        'items': [1], 'drop': 3}))
+            override.write_text(json.dumps({'nested': {'drop': None, 'add': 4},
+                                            'items': [2], 'drop': None}))
+            result = self.run_cli(base, override)
+            self.assertEqual(result.returncode, 0)
+            self.assertEqual(json.loads(result.stdout),
+                             {'nested': {'keep': 1, 'add': 4}, 'items': [2]})
+            self.assertEqual(result.stderr, '')
+
+    def test_invalid_file_contents_in_either_layer(self):
+        cases = [('{', 'Expecting'), ('[]', 'dictionaries'),
+                 ('null', 'dictionaries'),
+                 ('{"items": [{"__hidden": 1}]}', 'reserved')]
+        with tempfile.TemporaryDirectory() as d:
+            valid = pathlib.Path(d) / 'valid.json'
+            invalid = pathlib.Path(d) / 'invalid.json'
+            valid.write_text('{}')
+            for contents, diagnostic in cases:
+                invalid.write_text(contents)
+                for args in ((invalid,), (valid, invalid)):
+                    with self.subTest(contents=contents, args=args):
+                        self.assert_cli_error(self.run_cli(*args), diagnostic)
+
+    def test_replaced_base_branch_is_validated(self):
+        with tempfile.TemporaryDirectory() as d:
+            base = pathlib.Path(d) / 'base.json'
+            override = pathlib.Path(d) / 'override.json'
+            base.write_text('{"branch": {"__hidden": 1}}')
+            override.write_text('{"branch": null}')
+            self.assert_cli_error(self.run_cli(base, override), 'reserved')
+
+    def test_unreadable_files_in_either_layer(self):
+        with tempfile.TemporaryDirectory() as d:
+            valid = pathlib.Path(d) / 'valid.json'
+            missing = pathlib.Path(d) / 'missing.json'
+            valid.write_text('{}')
+            for args in ((missing,), (valid, missing), (pathlib.Path(d),)):
+                with self.subTest(args=args):
+                    self.assert_cli_error(self.run_cli(*args), str(args[-1]))
+
+    def test_invalid_encoding(self):
+        with tempfile.TemporaryDirectory() as d:
+            invalid = pathlib.Path(d) / 'invalid.json'
+            invalid.write_bytes(b'\xff')
+            self.assert_cli_error(self.run_cli(invalid), 'decode')
+
+    def test_invalid_argument_counts(self):
+        for args in ((), ('one', 'two', 'three')):
+            with self.subTest(args=args):
+                self.assert_cli_error(self.run_cli(*args), 'usage:')
diff --git a/tests/test_core.py b/tests/test_core.py
index e642534..2e8b1ff 100644
--- a/tests/test_core.py
+++ b/tests/test_core.py
@@ -4,3 +4,74 @@ from configkit import merge
 class CoreTests(unittest.TestCase):
     def test_existing_scalar(self):
         self.assertEqual(merge({'x': 1}, {'x': 2}), {'x': 2})
+
+    def test_recursive_merge_and_replacements(self):
+        base = {'nested': {'keep': 1, 'change': 2}, 'list': [1], 'scalar': 4,
+                'dict': {'old': 1}}
+        override = {'nested': {'change': 3, 'add': 4}, 'list': [2, 3],
+                    'scalar': {'new': 5}, 'dict': 'replacement'}
+        self.assertEqual(merge(base, override), {
+            'nested': {'keep': 1, 'change': 3, 'add': 4}, 'list': [2, 3],
+            'scalar': {'new': 5}, 'dict': 'replacement'})
+
+    def test_null_deletes_at_every_depth(self):
+        self.assertEqual(merge(
+            {'remove': 1, 'nested': {'remove': 2, 'keep': 3}},
+            {'remove': None, 'absent': None,
+             'nested': {'remove': None, 'absent': None},
+             'new': {'absent': None, 'keep': 4},
+             'replaced': {'absent': None}}),
+            {'nested': {'keep': 3}, 'new': {'keep': 4}, 'replaced': {}})
+        self.assertEqual(merge({'x': 1}, {'x': {'delete': None}}), {'x': {}})
+
+    def test_result_is_detached_from_both_inputs(self):
+        base = {'unchanged': [{'nested': [1]}], 'merged': {'keep': [2]}}
+        override = {'added': [{'nested': [3]}], 'merged': {'add': [4]}}
+        result = merge(base, override)
+        result['unchanged'][0]['nested'].append(10)
+        result['added'][0]['nested'].append(30)
+        result['merged']['keep'].append(20)
+        result['merged']['add'].append(40)
+        self.assertEqual(base, {'unchanged': [{'nested': [1]}],
+                                'merged': {'keep': [2]}})
+        self.assertEqual(override, {'added': [{'nested': [3]}],
+                                    'merged': {'add': [4]}})
+
+    def test_merge_does_not_mutate_inputs(self):
+        base = {'nested': {'remove': 1, 'keep': [2]}}
+        override = {'nested': {'remove': None, 'add': [3]}}
+        merge(base, override)
+        self.assertEqual(base, {'nested': {'remove': 1, 'keep': [2]}})
+        self.assertEqual(override, {'nested': {'remove': None, 'add': [3]}})
+
+    def test_both_roots_must_be_dicts(self):
+        for invalid in (None, [], 'text', 1, True):
+            for base, override in ((invalid, {}), ({}, invalid)):
+                with self.subTest(base=base, override=override):
+                    with self.assertRaises(ValueError):
+                        merge(base, override)
+
+    def test_reserved_keys_are_rejected_throughout_both_inputs(self):
+        invalid_values = [
+            {'__hidden': 1},
+            {'nested': {'__hidden': None}},
+            {'items': [0, [{'__hidden': 1}]]},
+        ]
+        for invalid in invalid_values:
+            for base, override in ((invalid, {}), ({}, invalid)):
+                with self.subTest(base=base, override=override):
+                    with self.assertRaises(ValueError):
+                        merge(base, override)
+
+    def test_replaced_and_deleted_branches_still_get_validated(self):
+        for replacement in (None, 0, [], {'safe': 1}):
+            with self.subTest(replacement=replacement):
+                with self.assertRaises(ValueError):
+                    merge({'branch': [{'__hidden': 1}]},
+                          {'branch': replacement})
+
+    def test_normal_keys_and_null_list_elements_are_preserved(self):
+        self.assertEqual(merge({'_allowed': 1, 'inside__allowed': 2},
+                               {'items': [None, {'value': None}]}),
+                         {'_allowed': 1, 'inside__allowed': 2,
+                          'items': [None, {'value': None}]})


