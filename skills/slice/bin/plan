#!/usr/bin/env python3
"""plan: owns a slice plan's mechanical state.

Python 3.9+, standard library only. Agents keep every judgment; this tool
keeps status, dependencies, eligibility, and run state consistent.
"""
from __future__ import annotations

import argparse
import contextlib
import datetime
import fcntl
import functools
import json
import os
import re
import shutil
import subprocess
import sys

SCHEMA_VERSION = 1
STATE_FILE = "state.json"
LOCK_FILE = ".plan.lock"
PLAN_FILE = "plan.md"
LOG_FILE = "log.md"
CHECKPOINT_DIR = "checkpoints"

STATUSES = ("ready", "in-progress", "blocked", "complete")
EDITABLE_STATUSES = ("ready", "blocked")
MAX_REPORTED_CYCLES = 50
ID_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

BLOCK_START = "<!-- plan:status:start — generated by `plan`; edit it through `plan`, not by hand -->"
BLOCK_START_PREFIX = "<!-- plan:status:start"
BLOCK_END = "<!-- plan:status:end -->"

STATE_FIELDS = """\
state.json fields (written only by `plan`):
  schema               State format version (currently 1).
  repo                 Absolute path of the Git repository root.
  run.target           Target branch the plan lands on.
  run.target_tip       Target branch tip read from Git at init (null when unborn).
  slices.<ID>.file     Slice description file, relative to the plan directory.
  slices.<ID>.outcome  One-line observable outcome.
  slices.<ID>.status   One of: ready, in-progress, blocked, complete.
  slices.<ID>.reason   Why the slice is blocked (null unless blocked).
  slices.<ID>.blocked_by
                       Dependencies: list of {"id": <ID>, "supplies": <text>}.

Other files in the plan directory:
  plan.md              Prose; `plan` regenerates only the marked status block.
  log.md               History; `plan` appends forced overrides and their reasons.
  checkpoints/<ID>.md  Current checkpoint prose of an in-progress slice.
  .plan.lock           flock target held by every write.
"""

FORCE_HELP = """\
Guarded refusals (status changes outside ready/blocked) are overridden with
--force --reason <text>; the override and reason are appended to log.md.
Integrity errors (duplicate IDs, missing dependencies, cycles) are never
overridden.
"""


class PlanError(Exception):
    """A refusal or failure reported on stderr with a non-zero exit."""


# ---------------------------------------------------------------- files


def atomic_write(path, text):
    """Replaces path with text so readers see the old or new file, never a mix."""
    tmp = path + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        if os.path.exists(path):
            shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.remove(tmp)
        raise


def read_text(path):
    with open(path, encoding="utf-8") as handle:
        return handle.read()


@contextlib.contextmanager
def locked(plan_dir):
    """Holds an exclusive flock on the plan directory's lock file.

    The kernel releases the lock when the holder exits, so a crashed writer
    never leaves a stale lock behind.
    """
    fd = os.open(os.path.join(plan_dir, LOCK_FILE), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


# ---------------------------------------------------------------- git


def run_git(repo, *args):
    try:
        result = subprocess.run(
            ["git", "-C", repo, *args], capture_output=True, text=True
        )
    except FileNotFoundError:
        raise PlanError("git is not installed")
    return result.returncode, result.stdout.strip()


def repo_root(path):
    if not os.path.isdir(path):
        raise PlanError(f"repository {path} does not exist")
    code, out = run_git(path, "rev-parse", "--show-toplevel")
    if code != 0:
        raise PlanError(f"{path} is not inside a Git work tree")
    return os.path.realpath(out)


def branch_tip(repo, branch):
    """Returns the branch tip, or None when it is the unborn current branch."""
    code, _ = run_git(repo, "check-ref-format", "--branch", branch)
    if code != 0:
        raise PlanError(f"invalid branch name {branch!r}")
    code, out = run_git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}")
    if code == 0:
        return out
    code, head = run_git(repo, "symbolic-ref", "--quiet", "HEAD")
    unborn = run_git(repo, "rev-parse", "--verify", "--quiet", "HEAD")[0] != 0
    if code == 0 and head == f"refs/heads/{branch}" and unborn:
        return None
    raise PlanError(f"target branch {branch!r} does not exist in {repo}")


# ---------------------------------------------------------------- state


@functools.lru_cache(maxsize=None)
def natural_key(slice_id):
    return tuple((0, int(part), "") if part.isdigit() else (1, 0, part)
                 for part in re.split(r"(\d+)", slice_id) if part)


def sorted_ids(slices):
    return sorted(slices, key=natural_key)


def state_path(plan_dir):
    return os.path.join(plan_dir, STATE_FILE)


def require_state(plan_dir):
    if not os.path.isfile(state_path(plan_dir)):
        raise PlanError(f"no {STATE_FILE} in {plan_dir}; run `plan init` first")


def load_state(plan_dir):
    require_state(plan_dir)
    path = state_path(plan_dir)
    try:
        state = json.loads(read_text(path))
    except ValueError as exc:
        raise PlanError(f"{path} is not valid JSON: {exc}")
    version = state.get("schema") if isinstance(state, dict) else None
    if version != SCHEMA_VERSION:
        raise PlanError(f"{path} has schema {version!r}; this plan tool reads schema {SCHEMA_VERSION}")
    shape = shape_problems(state)
    if shape:
        raise PlanError(f"{path} is malformed: " + "; ".join(shape))
    return state


def shape_problems(state):
    """Names fields whose type does not match the documented state.json layout."""
    def wrong(value, kinds):
        return not isinstance(value, kinds)

    problems = []
    if wrong(state.get("repo"), str):
        problems.append("repo must be a string")
    run = state.get("run")
    if wrong(run, dict) or wrong(run.get("target"), str) or wrong(run.get("target_tip"), (str, type(None))):
        problems.append("run must hold target (string) and target_tip (string or null)")
    slices = state.get("slices")
    if wrong(slices, dict):
        return problems + ["slices must be an object keyed by slice ID"]
    for sid, s in slices.items():
        if wrong(s, dict):
            problems.append(f"slices.{sid} must be an object")
            continue
        for field, kinds in (("file", str), ("outcome", str), ("status", str), ("reason", (str, type(None)))):
            if wrong(s.get(field), kinds):
                problems.append(f"slices.{sid}.{field} is missing or has the wrong type")
        deps = s.get("blocked_by")
        if wrong(deps, list) or any(
            wrong(d, dict) or wrong(d.get("id"), str) or wrong(d.get("supplies"), str) for d in deps
        ):
            problems.append(f"slices.{sid}.blocked_by must be a list of {{id, supplies}} strings")
    return problems


def save_state(plan_dir, state):
    ordered = dict(state)
    ordered["slices"] = {sid: state["slices"][sid] for sid in sorted_ids(state["slices"])}
    atomic_write(state_path(plan_dir), json.dumps(ordered, indent=2, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- status block


def table_cell(text):
    return " ".join(str(text).split()).replace("|", "\\|")


def format_dependencies(deps):
    if not deps:
        return "None"
    return "; ".join(f"{d['id']}: {d['supplies']}" if d["supplies"] else d["id"] for d in deps)


def slice_rows(slices):
    return [dict(id=sid, **slices[sid]) for sid in sorted_ids(slices)]


def render_table(rows):
    lines = ["| ID | File | Outcome | Blocked by | Status |", "| --- | --- | --- | --- | --- |"]
    for row in rows:
        cells = [row["id"], row["file"], row["outcome"], format_dependencies(row["blocked_by"]), row["status"]]
        lines.append("| " + " | ".join(table_cell(c) for c in cells) + " |")
    return lines


def render_block(state):
    return "\n".join([BLOCK_START] + render_table(slice_rows(state["slices"])) + [BLOCK_END])


def locate_block(text, path):
    """Returns (start, end) offsets of the status block, or None when absent."""
    starts = [m.start() for m in re.finditer(re.escape(BLOCK_START_PREFIX), text)]
    ends = [m.start() for m in re.finditer(re.escape(BLOCK_END), text)]
    if not starts and not ends:
        return None
    if len(starts) != 1 or len(ends) != 1 or ends[0] < starts[0]:
        raise PlanError(
            f"{path} must contain exactly one status block between "
            f"{BLOCK_START_PREFIX} … and {BLOCK_END}; fix the markers by hand"
        )
    return starts[0], ends[0] + len(BLOCK_END)


def check_plan_file(plan_dir):
    path = os.path.join(plan_dir, PLAN_FILE)
    if os.path.exists(path):
        locate_block(read_text(path), path)


def write_plan_file(plan_dir, state):
    path = os.path.join(plan_dir, PLAN_FILE)
    block = render_block(state)
    if not os.path.exists(path):
        atomic_write(path, f"# Plan\n\n## Slices\n\n{block}\n")
        return
    text = read_text(path)
    span = locate_block(text, path)
    if span is None:
        separator = "" if text == "" else ("\n" if text.endswith("\n") else "\n\n")
        atomic_write(path, f"{text}{separator}{block}\n")
    else:
        atomic_write(path, text[: span[0]] + block + text[span[1]:])


# ---------------------------------------------------------------- graph


def dependency_edges(slices):
    return {
        sid: sorted({d["id"] for d in s["blocked_by"] if d["id"] in slices}, key=natural_key)
        for sid, s in slices.items()
    }


def strong_components(edges, nodes):
    """Tarjan's algorithm over the subgraph on nodes, iterative so long chains cannot overflow."""
    index, low, on_stack, stack, components = {}, {}, set(), [], []

    def visit(node):
        index[node] = low[node] = len(index)
        stack.append(node)
        on_stack.add(node)
        return node, iter([d for d in edges[node] if d in nodes])

    for root in sorted(nodes, key=natural_key):
        if root in index:
            continue
        work = [visit(root)]
        while work:
            node, deps = work[-1]
            for dep in deps:
                if dep not in index:
                    work.append(visit(dep))
                    break
                if dep in on_stack:
                    low[node] = min(low[node], index[dep])
            else:
                work.pop()
                if work:
                    parent = work[-1][0]
                    low[parent] = min(low[parent], low[node])
                if low[node] == index[node]:
                    component = set()
                    while True:
                        member = stack.pop()
                        on_stack.discard(member)
                        component.add(member)
                        if member == node:
                            break
                    components.append(component)
    return components


def find_cycles(slices, limit=MAX_REPORTED_CYCLES):
    """Returns (cycles, truncated): every elementary dependency cycle as an ID path.

    Johnson's algorithm: each cycle is found once, from its lowest ID, inside a
    strongly connected component; blocked nodes keep the search linear per
    cycle found. That ID is then removed and the rest of the component split
    again. Stops after limit cycles, so the time stays bounded.
    """
    edges = dependency_edges(slices)
    pending = strong_components(edges, set(slices))
    cycles = []
    while pending:
        component = pending.pop()
        start = min(component, key=natural_key)
        if len(component) == 1 and start not in edges[start]:
            continue
        cycles += circuits_from(start, {n: [d for d in edges[n] if d in component] for n in component},
                                limit + 1 - len(cycles))
        if len(cycles) > limit:
            return sorted(cycles, key=lambda c: [natural_key(i) for i in c])[:limit], True
        pending.extend(strong_components(edges, component - {start}))
    return sorted(cycles, key=lambda c: [natural_key(i) for i in c]), False


def circuits_from(start, edges, limit):
    """Johnson's CIRCUIT search for cycles through start, iterative, up to limit."""
    found, path, blocked, waiting = [], [start], {start}, {n: set() for n in edges}

    def unblock(node):
        todo = [node]
        while todo:
            current = todo.pop()
            if current in blocked:
                blocked.discard(current)
                todo.extend(waiting[current])
                waiting[current].clear()

    work = [[start, iter(edges[start]), False]]
    while work and len(found) < limit:
        frame = work[-1]
        for dep in frame[1]:
            if dep == start:
                found.append(path + [start])
                frame[2] = True
            elif dep not in blocked:
                path.append(dep)
                blocked.add(dep)
                work.append([dep, iter(edges[dep]), False])
                break
        else:
            node, _, closed = work.pop()
            if closed:
                unblock(node)
            else:
                for dep in edges[node]:
                    waiting[dep].add(node)
            path.pop()
            if work and closed:
                work[-1][2] = True
    return found


def graph_problems(slices):
    problems = []
    for sid in sorted_ids(slices):
        for dep in slices[sid]["blocked_by"]:
            if dep["id"] not in slices:
                problems.append(f"slice {sid} is blocked by {dep['id']}, which does not exist")
    cycles, truncated = find_cycles(slices)
    for cycle in cycles:
        problems.append("dependency cycle: " + " -> ".join(cycle))
    if truncated:
        problems.append(f"more than {MAX_REPORTED_CYCLES} dependency cycles; only the first are listed")
    return problems


def id_collisions(ids):
    """Names IDs that sort identically, such as 1 and 01."""
    seen, problems = {}, []
    for sid in sorted(ids):
        key = natural_key(sid)
        if key in seen:
            problems.append(f"slice IDs {seen[key]} and {sid} collide in ID order")
        else:
            seen[key] = sid
    return problems


def state_problems(state):
    problems = []
    for sid in sorted_ids(state["slices"]):
        s = state["slices"][sid]
        if not ID_PATTERN.match(sid):
            problems.append(f"slice ID {sid!r} is malformed")
        if s.get("status") not in STATUSES:
            problems.append(f"slice {sid} has unknown status {s.get('status')!r}")
        elif s["status"] == "blocked" and not s.get("reason"):
            problems.append(f"slice {sid} is blocked without a reason")
    return problems + id_collisions(state["slices"]) + graph_problems(state["slices"])


# ---------------------------------------------------------------- writes


class Guard:
    """Collects guarded refusals that --force --reason overrode."""

    def __init__(self, args):
        if args.force and not args.reason:
            raise PlanError("--force requires --reason <text>")
        self.force = args.force
        self.reason = args.reason
        self.overridden = []

    def check(self, allowed, refusal):
        if allowed:
            return
        if not self.force:
            raise PlanError(f"{refusal}; pass --force --reason <text> to override")
        self.overridden.append(refusal)


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def append_log(plan_dir, title, body):
    path = os.path.join(plan_dir, LOG_FILE)
    text = read_text(path) if os.path.exists(path) else ""
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    atomic_write(path, f"{text}## {utc_now()} — {title}\n\n{body.rstrip()}\n")


def write_plan(plan_dir, label, change, guard):
    """Applies change(state) under the lock, then writes log, state, and status block.

    A forced override reaches log.md before state.json changes, so no override
    can land unrecorded.
    """
    require_state(plan_dir)
    with locked(plan_dir):
        state = load_state(plan_dir)
        check_plan_file(plan_dir)
        change(state)
        problems = id_collisions(state["slices"]) + graph_problems(state["slices"])
        if problems:
            raise PlanError("refused: " + "; ".join(problems))
        if guard.overridden:
            lines = [f"Reason: {guard.reason}"] + [f"Overrode: {o}" for o in guard.overridden]
            append_log(plan_dir, f"forced `plan {label}`", "\n".join(lines))
        save_state(plan_dir, state)
        write_plan_file(plan_dir, state)


def plan_dir_of(args):
    return os.path.abspath(args.plan or os.getcwd())


def check_id(slice_id):
    if not ID_PATTERN.match(slice_id):
        raise PlanError(f"slice ID {slice_id!r} must match {ID_PATTERN.pattern}")


def parse_dependencies(values):
    if len(values) == 1 and values[0].strip().lower() == "none":
        return []
    deps = []
    for value in values:
        dep_id, _, supplies = value.partition(":")
        dep_id = dep_id.strip()
        check_id(dep_id)
        if any(d["id"] == dep_id for d in deps):
            raise PlanError(f"dependency {dep_id} is listed twice")
        deps.append({"id": dep_id, "supplies": supplies.strip()})
    return deps


def settle_status(sid, current, current_reason, requested, reason, guard):
    """Returns (status, blocked reason) after guarding a requested status change.

    current is None for a new slice. A blocked slice keeps its reason unless a
    new one is given; any other status clears it.
    """
    status = requested or current
    if status != current:
        guard.check(
            current in (None,) + EDITABLE_STATUSES and status in EDITABLE_STATUSES,
            f"slice {sid} status {current or 'new'} -> {status} is outside ready/blocked",
        )
    if status == "blocked":
        reason = reason or (current_reason if current == "blocked" else None)
        if not reason:
            raise PlanError("--status blocked requires --reason <text>")
        return status, reason
    if reason and not guard.force:
        raise PlanError("--reason applies only to a blocked slice or with --force")
    return status, None


# ---------------------------------------------------------------- commands


def cmd_init(args):
    plan_dir = os.path.abspath(args.dir)
    repo = repo_root(os.path.abspath(args.repo))
    tip = branch_tip(repo, args.target)
    os.makedirs(plan_dir, exist_ok=True)
    with locked(plan_dir):
        if os.path.exists(state_path(plan_dir)):
            raise PlanError(f"{state_path(plan_dir)} already exists; this directory already holds a plan")
        check_plan_file(plan_dir)
        state = {
            "schema": SCHEMA_VERSION,
            "repo": repo,
            "run": {"target": args.target, "target_tip": tip},
            "slices": {},
        }
        save_state(plan_dir, state)
        log_path = os.path.join(plan_dir, LOG_FILE)
        if not os.path.exists(log_path):
            atomic_write(log_path, "")
        write_plan_file(plan_dir, state)
    print(f"Initialized plan in {plan_dir}")


def cmd_slice_add(args):
    check_id(args.id)
    guard = Guard(args)
    deps = parse_dependencies(args.blocked_by or [])

    def change(state):
        if args.id in state["slices"]:
            raise PlanError(f"slice {args.id} already exists")
        status, reason = settle_status(args.id, None, None, args.status or "ready", args.reason, guard)
        state["slices"][args.id] = {
            "file": args.file,
            "outcome": args.outcome,
            "status": status,
            "reason": reason,
            "blocked_by": deps,
        }

    write_plan(plan_dir_of(args), f"slice add {args.id}", change, guard)
    print(f"Added slice {args.id}")


def cmd_slice_edit(args):
    guard = Guard(args)
    deps = None if args.blocked_by is None else parse_dependencies(args.blocked_by)
    reason_change = None if args.force else args.reason
    if all(v is None for v in (args.file, args.outcome, deps, args.status, reason_change)):
        raise PlanError("nothing to change; pass --file, --outcome, --blocked-by, --status, or --reason")

    def change(state):
        s = state["slices"].get(args.id)
        if s is None:
            raise PlanError(f"slice {args.id} does not exist")
        status, reason = settle_status(args.id, s["status"], s["reason"], args.status, args.reason, guard)
        if args.file is not None:
            s["file"] = args.file
        if args.outcome is not None:
            s["outcome"] = args.outcome
        if deps is not None:
            s["blocked_by"] = deps
        s["status"], s["reason"] = status, reason

    write_plan(plan_dir_of(args), f"slice edit {args.id}", change, guard)
    print(f"Updated slice {args.id}")


def eligible_ids(slices):
    return [
        sid for sid in sorted_ids(slices)
        if slices[sid]["status"] == "ready"
        and all(slices.get(d["id"], {}).get("status") == "complete" for d in slices[sid]["blocked_by"])
    ]


def checkpoint_path(plan_dir, sid):
    return os.path.join(plan_dir, CHECKPOINT_DIR, f"{sid}.md")


def status_view(plan_dir, state):
    slices = state["slices"]
    return {
        "plan": plan_dir,
        "repo": state["repo"],
        "run": state["run"],
        "slices": slice_rows(slices),
        "eligible": eligible_ids(slices),
        "in_progress": [
            {"id": sid, "checkpoint": checkpoint_path(plan_dir, sid)}
            for sid in sorted_ids(slices) if slices[sid]["status"] == "in-progress"
        ],
        "blocked": [
            {"id": sid, "reason": slices[sid]["reason"]}
            for sid in sorted_ids(slices) if slices[sid]["status"] == "blocked"
        ],
    }


def render_status(view):
    run = view["run"]
    tip = f"at {run['target_tip']}" if run["target_tip"] else "(unborn)"
    lines = [f"Plan: {view['plan']}", f"Repository: {view['repo']}", f"Target: {run['target']} {tip}", ""]
    lines += render_table(view["slices"]) + [""]
    lines.append("Eligible: " + (", ".join(view["eligible"]) or "none"))
    for title, rows, key in (("In progress", view["in_progress"], "checkpoint"), ("Blocked", view["blocked"], "reason")):
        if not rows:
            lines.append(f"{title}: none")
            continue
        lines.append(f"{title}:")
        lines += [f"  {row['id']}  {row[key]}" for row in rows]
    return "\n".join(lines)


def cmd_status(args):
    plan_dir = plan_dir_of(args)
    state = load_state(plan_dir)
    view = status_view(plan_dir, state)
    if args.json:
        print(json.dumps(view, indent=2, ensure_ascii=False))
    else:
        print(render_status(view))


def cmd_next(args):
    if args.limit is not None and args.limit < 1:
        raise PlanError("--limit must be at least 1")
    state = load_state(plan_dir_of(args))
    for sid in eligible_ids(state["slices"])[: args.limit]:
        s = state["slices"][sid]
        print(f"{sid}\t{s['file']}\t{s['outcome']}")


def cmd_validate(args):
    plan_dir = plan_dir_of(args)
    problems = state_problems(load_state(plan_dir))
    if problems:
        raise PlanError(f"{len(problems)} problem(s) in {state_path(plan_dir)}:\n  " + "\n  ".join(problems))
    print("Plan is valid")


# ---------------------------------------------------------------- parser


def build_parser():
    parser = argparse.ArgumentParser(
        prog="plan",
        description="Own a slice plan's mechanical state: status, dependencies, "
        "eligibility, and run state. Run it as `python3 <path>/plan`.",
        epilog=STATE_FIELDS + "\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[plan_option()],
    )
    parser.set_defaults(plan=None)
    sub = parser.add_subparsers(dest="command", metavar="<command>")
    sub.required = True

    init = sub.add_parser(
        "init",
        help="create a plan's state.json, log.md, and status block",
        description="Create state.json in DIR (refused when it already exists), an "
        "empty log.md when absent, and the generated status block in plan.md, "
        "creating plan.md when absent and keeping its prose otherwise.",
        epilog="Writes state.json fields: schema, repo, run.target, run.target_tip, slices.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    init.add_argument("dir", help="plan directory (created when absent)")
    init.add_argument("--repo", required=True, help="Git repository the plan changes")
    init.add_argument("--target", required=True, help="branch the plan lands on")
    init.set_defaults(func=cmd_init)

    slice_cmd = sub.add_parser(
        "slice",
        help="add or edit a slice",
        description="Add or edit a slice's file, outcome, dependencies, or status.",
    )
    slice_sub = slice_cmd.add_subparsers(dest="slice_command", metavar="<add|edit>")
    slice_sub.required = True
    for name, func in (("add", cmd_slice_add), ("edit", cmd_slice_edit)):
        adding = name == "add"
        p = slice_sub.add_parser(
            name,
            parents=[plan_option(), force_options()],
            help=("record a new slice" if adding else "change an existing slice"),
            description=(
                "Record a new slice; duplicate IDs are refused."
                if adding
                else "Change an existing slice's file, outcome, dependencies, or status."
            )
            + " Refuses a change that leaves a missing dependency or a cycle.",
            epilog="Writes state.json fields: slices.<ID>.file, outcome, status, reason, "
            "blocked_by; regenerates the plan.md status block.\n\n" + FORCE_HELP,
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        p.add_argument("id", metavar="ID", help="stable slice ID, e.g. 01")
        p.add_argument("--file", required=adding, help="slice description file, relative to the plan directory")
        p.add_argument("--outcome", required=adding, help="one-line observable outcome")
        p.add_argument(
            "--blocked-by",
            nargs="+",
            action="extend",
            metavar="ID[:SUPPLIES]",
            help="dependency and the behavior it supplies; repeatable"
            + ("" if adding else "; replaces the list, `None` clears it"),
        )
        p.add_argument(
            "--status",
            choices=STATUSES,
            help="ready (default for add) or blocked; in-progress and complete need --force",
        )
        p.set_defaults(func=func)

    validate = sub.add_parser(
        "validate",
        parents=[plan_option()],
        help="check statuses, dependencies, and cycles",
        description="Exit 0 on a valid plan; otherwise exit 1 naming each unknown status, "
        "blocked slice without a reason, missing dependency, and dependency cycle.",
        epilog="Reads state.json fields: slices.<ID>.status, reason, blocked_by.",
    )
    validate.set_defaults(func=cmd_validate)

    status = sub.add_parser(
        "status",
        parents=[plan_option()],
        help="show slices, eligible work, in-progress and blocked slices, and run state",
        description="Print the slice table, eligible slices, in-progress slices with their "
        "checkpoint path, blocked slices with their reason, and the run state.",
        epilog="--json prints one object with keys: plan, repo, run, slices (each with id and "
        "the state.json slice fields), eligible, in_progress ({id, checkpoint}), blocked ({id, reason}).",
    )
    status.add_argument("--json", action="store_true", help="print the view as one JSON object")
    status.set_defaults(func=cmd_status)

    next_cmd = sub.add_parser(
        "next",
        parents=[plan_option()],
        help="list slices ready to start",
        description="List ready slices whose dependencies are all complete, in ID order, "
        "one per line as ID<TAB>file<TAB>outcome.",
        epilog="Reads state.json fields: slices.<ID>.status, blocked_by, file, outcome.",
    )
    next_cmd.add_argument("--limit", type=int, metavar="N", help="list at most N slices")
    next_cmd.set_defaults(func=cmd_next)
    return parser


def plan_option():
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument(
        "--plan",
        default=argparse.SUPPRESS,
        metavar="DIR",
        help="plan directory (default: the current directory)",
    )
    return parent


def force_options():
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument("--force", action="store_true", help="override a guarded refusal (needs --reason)")
    parent.add_argument(
        "--reason",
        metavar="TEXT",
        help="why the slice is blocked (with --status blocked) and/or why --force overrides a guard",
    )
    return parent


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except (PlanError, OSError, UnicodeDecodeError) as exc:
        print(f"plan: error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
