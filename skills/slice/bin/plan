#!/usr/bin/env python3
"""plan: owns a slice plan's mechanical state.

Python 3.9+, standard library only. Agents keep every judgment; this tool
keeps status, dependencies, eligibility, and run state consistent.
"""
from __future__ import annotations

import argparse
import contextlib
import datetime
import fcntl
import functools
import json
import os
import re
import shutil
import subprocess
import sys

SCHEMA_VERSION = 1
STATE_FILE = "state.json"
LOCK_FILE = ".plan.lock"
PLAN_FILE = "plan.md"
LOG_FILE = "log.md"
CHECKPOINT_DIR = "checkpoints"

STATUSES = ("ready", "in-progress", "blocked", "complete")
TABLE_COLUMNS = ("ID", "File", "Outcome", "Blocked by", "Status")
TABLE_HEADER_TEXT = "| " + " | ".join(TABLE_COLUMNS) + " |"
EDITABLE_STATUSES = ("ready", "blocked")
DECISION_STATUSES = ("pending-review", "approved")
UNDO_COSTS = ("low", "medium", "high", "irreversible")  # cheapest to costliest
DECISION_ID = re.compile(r"R[1-9][0-9]*")  # used with fullmatch
# A line that records a decision in prose: `### R3 …`, `## <time> — R3 …`, `- R3 …`, `- **R3** …`, or a
# plain line starting `R3:` or `R3 (`.
DECISION_LINE = re.compile(
    r"^[ \t]*(#{1,6}[ \t]+(?:[^\n—]*—[ \t]+)?|[-*+][ \t]+|\d+[.)][ \t]+)?(?:\*\*|__)?R([1-9][0-9]*)"
    r"(?:\*\*|__)?(?![A-Za-z0-9_])(.?.?)"
)
MAX_REPORTED_CYCLES = 50
ID_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

BLOCK_START = "<!-- plan:status:start — generated by `plan`; edit it through `plan`, not by hand -->"
BLOCK_START_PREFIX = "<!-- plan:status:start"
BLOCK_END = "<!-- plan:status:end -->"

STATE_FIELDS = """\
state.json fields (written only by `plan`):
  schema               State format version (currently 1).
  repo                 Absolute path of the Git repository root.
  planning_revision    Revision the plan was written against: the target tip at
                       init, or plan.md's "Planning revision" at import (null
                       when unknown or unborn).
  run.target           Target branch the plan lands on.
  run.target_tip       Recorded target branch tip: read from Git at init (null
                       when unborn); `plan complete` moves it to the live tip
                       when that tip descends from it and every commit between
                       them is one of the slice's landed revisions.
  run.grant            Autonomy grant for the run: {"granted": <UTC time>,
                       "note": <text or null>} from `plan grant`; null when not
                       granted or after `plan revoke`.
  run.constraints      Scheduling constraints from `plan constrain`: a list of
                       {"slices": [<ID>, <ID>], "reason": <text>}, each pair in
                       ID order, meaning the two never run at once.
  slices.<ID>.file     Slice description file, relative to the plan directory.
  slices.<ID>.outcome  One-line observable outcome.
  slices.<ID>.status   One of: ready, in-progress, blocked, complete.
  slices.<ID>.reason   Why the slice is blocked (null unless blocked).
  slices.<ID>.blocked_by
                       Dependencies: list of {"id": <ID>, "supplies": <text>}.
  slices.<ID>.fixed_point
                       Revision the slice started from (null when not recorded).
  slices.<ID>.snapshot `git status --porcelain` output when the slice started,
                       "" when clean (null when not recorded).
  slices.<ID>.landed   Revisions `plan complete` or `plan land` recorded as
                       landed: full shas, or the text given under --force (null
                       until complete).
  slices.<ID>.worktree Worktree from `plan start --worktree`: {"path": <absolute
                       path>, "branch": <name>, "base": <sha>, "notes": [<text>]}
                       with the resource notes; null for a slice in the
                       repository checkout and after `plan land` removes it.
  decisions            Decision index keyed R1, R2, … in the order `plan decide`
                       allocated them; each decision's prose is in log.md under
                       its `R<n>` entry.
  decisions.<R>.status pending-review or approved.
  decisions.<R>.undo_cost
                       One of: low, medium, high, irreversible.
  decisions.<R>.slices Dependent slice IDs.
  decisions.<R>.recorded
                       UTC time `plan decide` recorded the decision.
  decisions.<R>.updated
                       UTC time of its last update (null until updated).

planning_revision, fixed_point, snapshot, landed, worktree, and run.grant may
be absent from a state.json written by an earlier `plan`; they read as null,
an absent decisions reads as {}, and an absent run.constraints as [].

Other files in the plan directory:
  plan.md              Prose; `plan` regenerates only the marked status block.
  log.md               History; `plan` appends dated entries for imports,
                       slices added or revised with --note (with the note),
                       start, block, resume, complete and land (with the
                       evidence and the folded checkpoint), worktree removal,
                       constraints, target-tip changes, decisions (`R<n>`
                       entries with their prose), grants and revocations, and
                       forced overrides with their reasons.
  checkpoints/<ID>.md  Checkpoint prose of a started slice, or of a blocked
                       slice paused before it started, written by agents;
                       `plan start` creates it, `plan complete` and `plan land`
                       fold it into log.md and delete it.
  worktrees/<ID>       A slice's worktree when the plan directory is outside the
                       repository (see `plan start --help`).
  .plan.lock           flock target held by every write.
"""

FORCE_HELP = """\
Guarded refusals (`slice add|edit` status changes outside ready/blocked, and
each refusal of start, block, resume, complete, land, constrain, target-tip,
decide, grant, and revoke that is not marked otherwise) are overridden with
--force --reason <text>; the override and reason are appended to log.md.
Integrity errors (duplicate IDs, missing dependencies, cycles, unknown
decisions, decisions or constraints naming missing slices) are never
overridden.
"""


class PlanError(Exception):
    """A refusal or failure reported on stderr with a non-zero exit."""


# ---------------------------------------------------------------- files


def atomic_write(path, text):
    """Replaces path with text so readers see the old or new file, never a mix."""
    tmp = path + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        if os.path.exists(path):
            shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.remove(tmp)
        raise


def restore(path, original):
    """Puts back a file's original bytes, or removes it when it did not exist; returns an error or None."""
    try:
        if original is None:
            if os.path.exists(path):
                os.remove(path)
        else:
            with open(path, "wb") as handle:
                handle.write(original)
    except OSError as exc:
        return exc
    return None


def restore_all(originals):
    """Restores each path to its original bytes (None: removes it), reporting failures on stderr."""
    for path, original in originals.items():
        error = restore(path, original)
        if error:
            print(f"plan: error: could not restore {path}: {error}", file=sys.stderr)


def read_text(path):
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def open_lock(path):
    """Opens the lock file, creating it when absent; returns (fd, created)."""
    while True:
        try:
            return os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o644), True
        except FileExistsError:
            pass
        try:
            return os.open(path, os.O_RDWR), False
        except FileNotFoundError:
            continue


def holds_current_file(fd, path):
    try:
        on_disk = os.stat(path)
    except FileNotFoundError:
        return False
    held = os.fstat(fd)
    return (held.st_dev, held.st_ino) == (on_disk.st_dev, on_disk.st_ino)


@contextlib.contextmanager
def locked(plan_dir, discard_on_error=False):
    """Holds an exclusive flock on the plan directory's lock file.

    The kernel releases the lock when the holder exits, so a crashed writer
    never leaves a stale lock behind. After flock the holder checks that its
    file is still the one at the lock path and retries otherwise, so a holder
    may delete the lock file safely. With discard_on_error, a lock file this
    holder created is deleted when the body raises, leaving no trace.
    """
    path = os.path.join(plan_dir, LOCK_FILE)
    while True:
        fd, created = open_lock(path)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            if holds_current_file(fd, path):
                break
        except BaseException:
            os.close(fd)
            raise
        os.close(fd)
    try:
        yield
    except BaseException:
        if discard_on_error and created:
            with contextlib.suppress(OSError):
                os.remove(path)
        raise
    finally:
        os.close(fd)


# ---------------------------------------------------------------- git


def run_git(repo, *args, strip=True):
    code, out, _ = run_git_full(repo, *args)
    return code, out.strip() if strip else out


def run_git_full(repo, *args):
    """Returns (exit code, stdout, stderr) of `git -C repo args`."""
    try:
        result = subprocess.run(
            ["git", "-C", repo, *args], capture_output=True, text=True
        )
    except FileNotFoundError:
        raise PlanError("git is not installed")
    return result.returncode, result.stdout, result.stderr


def git_or_fail(repo, *args):
    """Runs a Git command that changes the repository, raising PlanError with Git's message on failure."""
    code, out, err = run_git_full(repo, *args)
    if code != 0:
        message = " ".join((err + "\n" + out).split())
        raise PlanError(f"`git {' '.join(args)}` failed in {repo} with exit code {code}"
                        + (f": {message}" if message else " and no message (a Git hook may have failed)"))
    return out


def repo_root(path):
    if not os.path.isdir(path):
        raise PlanError(f"repository {path} does not exist")
    code, out = run_git(path, "rev-parse", "--show-toplevel")
    if code != 0:
        raise PlanError(f"{path} is not inside a Git work tree")
    return os.path.realpath(out)


def branch_tip(repo, branch):
    """Returns the branch tip, or None when it is the unborn current branch."""
    code, _ = run_git(repo, "check-ref-format", "--branch", branch)
    if code != 0:
        raise PlanError(f"invalid branch name {branch!r}")
    code, out = run_git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}")
    if code == 0:
        return out
    code, head = run_git(repo, "symbolic-ref", "--quiet", "HEAD")
    unborn = run_git(repo, "rev-parse", "--verify", "--quiet", "HEAD")[0] != 0
    if code == 0 and head == f"refs/heads/{branch}" and unborn:
        return None
    raise PlanError(f"target branch {branch!r} does not exist in {repo}")


# ---------------------------------------------------------------- state


@functools.lru_cache(maxsize=None)
def natural_key(slice_id):
    return tuple((0, int(part), "") if part.isdigit() else (1, 0, part)
                 for part in re.split(r"(\d+)", slice_id) if part)


def sorted_ids(slices):
    return sorted(slices, key=natural_key)


def state_path(plan_dir):
    return os.path.join(plan_dir, STATE_FILE)


def require_state(plan_dir):
    if not os.path.isfile(state_path(plan_dir)):
        raise PlanError(f"no {STATE_FILE} in {plan_dir}; run `plan init` first")


def load_state(plan_dir):
    require_state(plan_dir)
    path = state_path(plan_dir)
    try:
        state = json.loads(read_text(path))
    except ValueError as exc:
        raise PlanError(f"{path} is not valid JSON: {exc}")
    version = state.get("schema") if isinstance(state, dict) else None
    if version != SCHEMA_VERSION:
        raise PlanError(f"{path} has schema {version!r}; this plan tool reads schema {SCHEMA_VERSION}")
    fill_later_fields(state)
    shape = shape_problems(state)
    if shape:
        raise PlanError(f"{path} is malformed: " + "; ".join(shape))
    return state


def fill_later_fields(state):
    """Reads fields added after schema 1 was first written as null (decisions as {}) when absent."""
    state.setdefault("planning_revision", None)
    state.setdefault("decisions", {})
    if isinstance(state.get("run"), dict):
        state["run"].setdefault("grant", None)
        state["run"].setdefault("constraints", [])
    slices = state.get("slices")
    for s in slices.values() if isinstance(slices, dict) else ():
        if isinstance(s, dict):
            s.setdefault("fixed_point", None)
            s.setdefault("snapshot", None)
            s.setdefault("landed", None)
            s.setdefault("worktree", None)


def new_slice(file, outcome, status, reason, blocked_by):
    return {"file": file, "outcome": outcome, "status": status, "reason": reason,
            "blocked_by": blocked_by, "fixed_point": None, "snapshot": None, "landed": None, "worktree": None}


def shape_problems(state):
    """Names fields whose type does not match the documented state.json layout."""
    def wrong(value, kinds):
        return not isinstance(value, kinds)

    problems = []
    if wrong(state.get("repo"), str):
        problems.append("repo must be a string")
    if wrong(state.get("planning_revision", 0), (str, type(None))):
        problems.append("planning_revision must be a string or null")
    optional = (str, type(None))
    run = state.get("run")
    if wrong(run, dict) or wrong(run.get("target"), str) or wrong(run.get("target_tip"), optional):
        problems.append("run must hold target (string) and target_tip (string or null)")
    elif run.get("grant") is not None and (
        wrong(run["grant"], dict) or wrong(run["grant"].get("granted"), str)
        or "note" not in run["grant"] or wrong(run["grant"]["note"], optional)
    ):
        problems.append("run.grant must be null or {granted (string), note (string or null)}")
    if isinstance(run, dict) and (wrong(run.get("constraints", []), list) or any(
        wrong(c, dict) or wrong(c.get("slices"), list) or len(c["slices"]) != 2
        or any(wrong(i, str) for i in c["slices"]) or wrong(c.get("reason"), str)
        for c in run.get("constraints", [])
    )):
        problems.append("run.constraints must be a list of {slices: [ID, ID], reason (string)}")
    problems += decision_shape_problems(state.get("decisions", {}))
    slices = state.get("slices")
    if wrong(slices, dict):
        return problems + ["slices must be an object keyed by slice ID"]
    for sid, s in slices.items():
        if wrong(s, dict):
            problems.append(f"slices.{sid} must be an object")
            continue
        for field, kinds in (("file", str), ("outcome", str), ("status", str), ("reason", optional),
                             ("fixed_point", optional), ("snapshot", optional)):
            if field not in s or wrong(s[field], kinds):
                problems.append(f"slices.{sid}.{field} is missing or has the wrong type")
        deps = s.get("blocked_by")
        if wrong(deps, list) or any(
            wrong(d, dict) or wrong(d.get("id"), str) or wrong(d.get("supplies"), str) for d in deps
        ):
            problems.append(f"slices.{sid}.blocked_by must be a list of {{id, supplies}} strings")
        landed = s.get("landed")
        if landed is not None and (wrong(landed, list) or any(wrong(r, str) for r in landed)):
            problems.append(f"slices.{sid}.landed must be a list of strings or null")
        tree = s.get("worktree")
        if tree is not None and (
            wrong(tree, dict) or any(wrong(tree.get(f), str) for f in ("path", "branch", "base"))
            or wrong(tree.get("notes"), list) or any(wrong(n, str) for n in tree["notes"])
        ):
            problems.append(f"slices.{sid}.worktree must be null or {{path, branch, base, notes}}")
    return problems


def decision_shape_problems(decisions):
    if not isinstance(decisions, dict):
        return ["decisions must be an object keyed by decision ID"]
    problems = []
    for did, d in decisions.items():
        if not DECISION_ID.fullmatch(did):
            problems.append(f"decision ID {did!r} must be R<n>")
        if not isinstance(d, dict):
            problems.append(f"decisions.{did} must be an object")
            continue
        for field, kinds in (("status", str), ("undo_cost", str), ("recorded", str), ("updated", (str, type(None)))):
            if field not in d or not isinstance(d[field], kinds):
                problems.append(f"decisions.{did}.{field} is missing or has the wrong type")
        if not isinstance(d.get("slices"), list) or any(not isinstance(i, str) for i in d["slices"]):
            problems.append(f"decisions.{did}.slices must be a list of slice IDs")
    return problems


def state_text(state):
    ordered = dict(state)
    ordered["slices"] = {sid: state["slices"][sid] for sid in sorted_ids(state["slices"])}
    ordered["decisions"] = {did: state["decisions"][did] for did in sorted_decision_ids(state["decisions"])}
    return json.dumps(ordered, indent=2, ensure_ascii=False) + "\n"


def save_state(plan_dir, state):
    atomic_write(state_path(plan_dir), state_text(state))


# ---------------------------------------------------------------- status block


def table_cell(text):
    return " ".join(str(text).split()).replace("|", "\\|")


def format_dependencies(deps):
    """Renders `01: what; 02, 03: shared`, grouping neighbors that supply the same thing."""
    if not deps:
        return "None"
    groups = []
    for d in deps:
        if groups and groups[-1][1] == d["supplies"]:
            groups[-1][0].append(d["id"])
        else:
            groups.append(([d["id"]], d["supplies"]))
    return "; ".join(", ".join(ids) + (f": {supplies}" if supplies else "") for ids, supplies in groups)


def slice_rows(slices):
    return [dict(id=sid, **slices[sid]) for sid in sorted_ids(slices)]


def render_table(rows):
    lines = [TABLE_HEADER_TEXT, "| --- | --- | --- | --- | --- |"]
    for row in rows:
        cells = [row["id"], row["file"], row["outcome"], format_dependencies(row["blocked_by"]), row["status"]]
        lines.append("| " + " | ".join(table_cell(c) for c in cells) + " |")
    return lines


def render_block(state):
    return "\n".join([BLOCK_START] + render_table(slice_rows(state["slices"])) + [BLOCK_END])


def locate_block(text, path):
    """Returns (start, end) offsets of the status block, or None when absent."""
    starts = [m.start() for m in re.finditer(re.escape(BLOCK_START_PREFIX), text)]
    ends = [m.start() for m in re.finditer(re.escape(BLOCK_END), text)]
    if not starts and not ends:
        return None
    if len(starts) != 1 or len(ends) != 1 or ends[0] < starts[0]:
        raise PlanError(
            f"{path} must contain exactly one status block between "
            f"{BLOCK_START_PREFIX} … and {BLOCK_END}; fix the markers by hand"
        )
    return starts[0], ends[0] + len(BLOCK_END)


def check_plan_file(plan_dir):
    path = os.path.join(plan_dir, PLAN_FILE)
    if os.path.exists(path):
        locate_block(read_text(path), path)


def write_plan_file(plan_dir, state):
    path = os.path.join(plan_dir, PLAN_FILE)
    block = render_block(state)
    if not os.path.exists(path):
        atomic_write(path, f"# Plan\n\n## Slices\n\n{block}\n")
        return
    text = read_text(path)
    span = locate_block(text, path)
    if span is None:
        separator = "" if text == "" else ("\n" if text.endswith("\n") else "\n\n")
        atomic_write(path, f"{text}{separator}{block}\n")
    else:
        atomic_write(path, text[: span[0]] + block + text[span[1]:])


# ---------------------------------------------------------------- graph


def dependency_edges(slices):
    return {
        sid: sorted({d["id"] for d in s["blocked_by"] if d["id"] in slices}, key=natural_key)
        for sid, s in slices.items()
    }


def strong_components(edges, nodes):
    """Tarjan's algorithm over the subgraph on nodes, iterative so long chains cannot overflow."""
    index, low, on_stack, stack, components = {}, {}, set(), [], []

    def visit(node):
        index[node] = low[node] = len(index)
        stack.append(node)
        on_stack.add(node)
        return node, iter([d for d in edges[node] if d in nodes])

    for root in sorted(nodes, key=natural_key):
        if root in index:
            continue
        work = [visit(root)]
        while work:
            node, deps = work[-1]
            for dep in deps:
                if dep not in index:
                    work.append(visit(dep))
                    break
                if dep in on_stack:
                    low[node] = min(low[node], index[dep])
            else:
                work.pop()
                if work:
                    parent = work[-1][0]
                    low[parent] = min(low[parent], low[node])
                if low[node] == index[node]:
                    component = set()
                    while True:
                        member = stack.pop()
                        on_stack.discard(member)
                        component.add(member)
                        if member == node:
                            break
                    components.append(component)
    return components


def find_cycles(slices, limit=MAX_REPORTED_CYCLES):
    """Returns (cycles, truncated): every elementary dependency cycle as an ID path.

    Johnson's algorithm: each cycle is found once, from its lowest ID, inside a
    strongly connected component; blocked nodes keep the search linear per
    cycle found. That ID is then removed and the rest of the component split
    again. Stops after limit cycles, so the time stays bounded.
    """
    edges = dependency_edges(slices)
    pending = strong_components(edges, set(slices))
    cycles = []
    while pending:
        component = pending.pop()
        start = min(component, key=natural_key)
        if len(component) == 1 and start not in edges[start]:
            continue
        cycles += circuits_from(start, {n: [d for d in edges[n] if d in component] for n in component},
                                limit + 1 - len(cycles))
        if len(cycles) > limit:
            return sorted(cycles, key=lambda c: [natural_key(i) for i in c])[:limit], True
        pending.extend(strong_components(edges, component - {start}))
    return sorted(cycles, key=lambda c: [natural_key(i) for i in c]), False


def circuits_from(start, edges, limit):
    """Johnson's CIRCUIT search for cycles through start, iterative, up to limit."""
    found, path, blocked, waiting = [], [start], {start}, {n: set() for n in edges}

    def unblock(node):
        todo = [node]
        while todo:
            current = todo.pop()
            if current in blocked:
                blocked.discard(current)
                todo.extend(waiting[current])
                waiting[current].clear()

    work = [[start, iter(edges[start]), False]]
    while work and len(found) < limit:
        frame = work[-1]
        for dep in frame[1]:
            if dep == start:
                found.append(path + [start])
                frame[2] = True
            elif dep not in blocked:
                path.append(dep)
                blocked.add(dep)
                work.append([dep, iter(edges[dep]), False])
                break
        else:
            node, _, closed = work.pop()
            if closed:
                unblock(node)
            else:
                for dep in edges[node]:
                    waiting[dep].add(node)
            path.pop()
            if work and closed:
                work[-1][2] = True
    return found


def graph_problems(slices):
    problems = []
    for sid in sorted_ids(slices):
        for dep in slices[sid]["blocked_by"]:
            if dep["id"] not in slices:
                problems.append(f"slice {sid} is blocked by {dep['id']}, which does not exist")
    cycles, truncated = find_cycles(slices)
    for cycle in cycles:
        problems.append("dependency cycle: " + " -> ".join(cycle))
    if truncated:
        problems.append(f"more than {MAX_REPORTED_CYCLES} dependency cycles; only the first are listed")
    return problems


def id_collisions(ids):
    """Names IDs that sort identically, such as 1 and 01."""
    seen, problems = {}, []
    for sid in sorted(ids):
        key = natural_key(sid)
        if key in seen:
            problems.append(f"slice IDs {seen[key]} and {sid} collide in ID order")
        else:
            seen[key] = sid
    return problems


def state_problems(state):
    problems = []
    for sid in sorted_ids(state["slices"]):
        s = state["slices"][sid]
        if not ID_PATTERN.match(sid):
            problems.append(f"slice ID {sid!r} is malformed")
        if s.get("status") not in STATUSES:
            problems.append(f"slice {sid} has unknown status {s.get('status')!r}")
        elif s["status"] == "blocked" and not s.get("reason"):
            problems.append(f"slice {sid} is blocked without a reason")
    for did in sorted_decision_ids(state["decisions"]):
        d = state["decisions"][did]
        if d["status"] not in DECISION_STATUSES:
            problems.append(f"decision {did} has unknown status {d['status']!r}")
        if d["undo_cost"] not in UNDO_COSTS:
            problems.append(f"decision {did} has unknown undo cost {d['undo_cost']!r}")
    return problems + integrity_problems(state)


def integrity_problems(state):
    """Problems no write may leave behind, --force or not."""
    return (id_collisions(state["slices"]) + graph_problems(state["slices"]) + decision_references(state)
            + constraint_references(state))


def sorted_decision_ids(decisions):
    return sorted(decisions, key=lambda did: int(did[1:]))


def decision_references(state):
    return [
        f"decision {did} names slice {sid}, which does not exist"
        for did in sorted_decision_ids(state["decisions"])
        for sid in state["decisions"][did]["slices"] if sid not in state["slices"]
    ]


def constraint_references(state):
    problems = []
    for c in state["run"]["constraints"]:
        a, b = c["slices"]
        if a == b:
            problems.append(f"constraint {a}, {b} names one slice twice")
        problems += [f"constraint {a}, {b} names slice {sid}, which does not exist"
                     for sid in (a, b) if sid not in state["slices"]]
    return problems


# ---------------------------------------------------------------- writes


class Guard:
    """Collects guarded refusals that --force --reason overrode."""

    def __init__(self, args):
        if args.force and not args.reason:
            raise PlanError("--force requires --reason <text>")
        self.force = args.force
        self.reason = args.reason
        self.overridden = []

    def check(self, allowed, refusal):
        if allowed:
            return
        if not self.force:
            raise PlanError(f"{refusal}; pass --force --reason <text> to override")
        self.overridden.append(refusal)


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def with_log_entry(text, title, body):
    """Returns log text with a `## <UTC time> — <title>` entry appended."""
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    return f"{text}## {utc_now()} — {title}\n\n{body.rstrip()}\n"


class Effects:
    """What a write does besides replacing state.json and the status block.

    entry is a (title, body) log entry, or a callable returning one after act
    runs; create_checkpoint is a (path, text) checkpoint written when the file
    is absent; act performs the write's Git work and returns a callable that
    undoes it, or None when a later failure must keep it; remove_checkpoint is
    a path deleted once state.json is saved.
    """

    def __init__(self, entry=None, create_checkpoint=None, remove_checkpoint=None, act=None):
        self.entry = entry
        self.create_checkpoint = create_checkpoint
        self.remove_checkpoint = remove_checkpoint
        self.act = act


def write_plan(plan_dir, label, change, guard):
    """Applies change(state) under the lock; see commit_change."""
    require_state(plan_dir)
    with locked(plan_dir):
        commit_change(plan_dir, label, change, guard)


def commit_change(plan_dir, label, change, guard):
    """Applies change(state), then its Git work, log, state, and status block; the caller holds the lock.

    change returns Effects or None. Files reach disk in the order checkpoint,
    forced-override record, Git work (act), transition entry, state.json, so
    no override or transition can land unrecorded. When the write fails before
    state.json is replaced, the log keeps only the forced-override record, the
    Git work is undone when act says how, and the files this write created are
    removed. A checkpoint to remove goes as soon as state.json lands.
    """
    state = load_state(plan_dir)
    check_plan_file(plan_dir)
    effects = change(state) or Effects()
    problems = integrity_problems(state)
    if problems:
        raise PlanError("refused: " + "; ".join(problems))
    log_path = os.path.join(plan_dir, LOG_FILE)
    original = read_text(log_path) if os.path.exists(log_path) else None
    kept = original
    if guard.overridden:
        lines = [f"Reason: {guard.reason}"] + [f"Overrode: {o}" for o in guard.overridden]
        kept = with_log_entry(original or "", f"forced `plan {label}`", "\n".join(lines))
    created, undo, logged = [], None, False
    try:
        if effects.create_checkpoint and not os.path.exists(effects.create_checkpoint[0]):
            create_checkpoint(*effects.create_checkpoint, created)
        if kept != original:
            atomic_write(log_path, kept)
        if effects.act:
            undo = effects.act()
        entry = effects.entry() if callable(effects.entry) else effects.entry
        log_text = with_log_entry(kept or "", *entry) if entry else kept
        if log_text != kept:
            atomic_write(log_path, log_text)
            logged = True
        save_state(plan_dir, state)
    except BaseException:
        if logged:
            restore_all({log_path: None if kept is None else kept.encode("utf-8")})
        if undo:
            undo()
        remove_created(created)
        raise
    if effects.remove_checkpoint and os.path.exists(effects.remove_checkpoint):
        try:
            os.remove(effects.remove_checkpoint)
        except OSError as exc:
            print(f"plan: note: could not delete {effects.remove_checkpoint}: {exc}", file=sys.stderr)
    write_plan_file(plan_dir, state)


def create_checkpoint(path, text, created):
    """Writes a new checkpoint file, appending each path it creates to created."""
    directory = os.path.dirname(path)
    if not os.path.isdir(directory):
        os.mkdir(directory)
        created.append(directory)
    atomic_write(path, text)
    created.append(path)


def remove_created(created):
    """Removes files and directories a failed write created, newest first."""
    for path in reversed(created):
        with contextlib.suppress(OSError):
            (os.rmdir if os.path.isdir(path) else os.remove)(path)


def plan_dir_of(args):
    return os.path.abspath(args.plan or os.getcwd())


def check_id(slice_id):
    if not ID_PATTERN.match(slice_id):
        raise PlanError(f"slice ID {slice_id!r} must match {ID_PATTERN.pattern}")


def parse_dependencies(values):
    if len(values) == 1 and values[0].strip().lower() == "none":
        return []
    deps = []
    for value in values:
        dep_id, _, supplies = value.partition(":")
        dep_id = dep_id.strip()
        check_id(dep_id)
        if any(d["id"] == dep_id for d in deps):
            raise PlanError(f"dependency {dep_id} is listed twice")
        deps.append({"id": dep_id, "supplies": supplies.strip()})
    return deps


def settle_status(sid, current, current_reason, requested, reason, guard):
    """Returns (status, blocked reason) after guarding a requested status change.

    current is None for a new slice. A blocked slice keeps its reason unless a
    new one is given; any other status clears it.
    """
    status = requested or current
    if status != current:
        guard.check(
            current in (None,) + EDITABLE_STATUSES and status in EDITABLE_STATUSES,
            f"slice {sid} status {current or 'new'} -> {status} is outside ready/blocked",
        )
    if status == "blocked":
        reason = reason or (current_reason if current == "blocked" else None)
        if not reason:
            raise PlanError("--status blocked requires --reason <text>")
        return status, reason
    if reason and not guard.force:
        raise PlanError("--reason applies only to a blocked slice or with --force")
    return status, None


# ---------------------------------------------------------------- commands


def cmd_init(args):
    plan_dir = os.path.abspath(args.dir)
    repo = repo_root(os.path.abspath(args.repo))
    tip = branch_tip(repo, args.target)
    os.makedirs(plan_dir, exist_ok=True)
    with locked(plan_dir):
        if os.path.exists(state_path(plan_dir)):
            raise PlanError(f"{state_path(plan_dir)} already exists; this directory already holds a plan")
        check_plan_file(plan_dir)
        state = {
            "schema": SCHEMA_VERSION,
            "repo": repo,
            "planning_revision": tip,
            "run": {"target": args.target, "target_tip": tip, "grant": None, "constraints": []},
            "slices": {},
            "decisions": {},
        }
        save_state(plan_dir, state)
        log_path = os.path.join(plan_dir, LOG_FILE)
        if not os.path.exists(log_path):
            atomic_write(log_path, "")
        write_plan_file(plan_dir, state)
    print(f"Initialized plan in {plan_dir}")


def slice_note(args):
    """Returns --note's text (reading `@path`), or None when it is not given; an empty note is refused."""
    if args.note is None:
        return None
    note = read_text_argument(args.note, "note")
    if not note.strip():
        raise PlanError("--note is empty; say why the slice is added or revised")
    return note


SLICE_ENTRY_FIELDS = (("file", "File"), ("outcome", "Outcome"), ("blocked_by", "Blocked by"), ("status", "Status"))


def slice_field_text(s, field):
    if field == "blocked_by":
        return format_dependencies(s["blocked_by"])
    if field == "status" and s["status"] == "blocked":
        return f"blocked ({s['reason']})"
    return s[field]


def slice_entry(sid, before, after, note):
    """Returns the `slice <ID> added|revised` log entry: each recorded or changed field, then the note."""
    lines = []
    for field, label in SLICE_ENTRY_FIELDS:
        now = slice_field_text(after, field)
        if before is None:
            lines.append(f"{label}: {now}")
        elif slice_field_text(before, field) != now:
            lines.append(f"{label}: {slice_field_text(before, field)} -> {now}")
    title = f"slice {sid} " + ("added" if before is None else "revised")
    return title, "\n".join((lines or ["State unchanged."]) + ["", nested_prose(note).strip("\n")])


def cmd_slice_add(args):
    check_id(args.id)
    guard = Guard(args)
    deps = parse_dependencies(args.blocked_by or [])
    note = slice_note(args)

    def change(state):
        if args.id in state["slices"]:
            raise PlanError(f"slice {args.id} already exists")
        status, reason = settle_status(args.id, None, None, args.status or "ready", args.reason, guard)
        s = state["slices"][args.id] = new_slice(args.file, args.outcome, status, reason, deps)
        return Effects(entry=slice_entry(args.id, None, s, note)) if note is not None else None

    write_plan(plan_dir_of(args), f"slice add {args.id}", change, guard)
    print(f"Added slice {args.id}")


def cmd_slice_edit(args):
    guard = Guard(args)
    deps = None if args.blocked_by is None else parse_dependencies(args.blocked_by)
    note = slice_note(args)
    reason_change = None if args.force else args.reason
    if all(v is None for v in (args.file, args.outcome, deps, args.status, reason_change, note)):
        raise PlanError("nothing to change; pass --file, --outcome, --blocked-by, --status, --reason, or --note")

    def change(state):
        s = state["slices"].get(args.id)
        if s is None:
            raise PlanError(f"slice {args.id} does not exist")
        before = dict(s)
        status, reason = settle_status(args.id, s["status"], s["reason"], args.status, args.reason, guard)
        if args.file is not None:
            s["file"] = args.file
        if args.outcome is not None:
            s["outcome"] = args.outcome
        if deps is not None:
            s["blocked_by"] = deps
        if status == "ready" and s["status"] != "ready":
            s.update(fixed_point=None, snapshot=None)  # ready means not started
        if status != "complete":
            s["landed"] = None
        s["status"], s["reason"] = status, reason
        return Effects(entry=slice_entry(args.id, before, s, note)) if note is not None else None

    write_plan(plan_dir_of(args), f"slice edit {args.id}", change, guard)
    print(f"Updated slice {args.id}")


def eligible_ids(state):
    """Ready slices whose dependencies are complete and which no constraint keeps waiting."""
    slices = state["slices"]
    return [
        sid for sid in sorted_ids(slices)
        if slices[sid]["status"] == "ready"
        and all(slices.get(d["id"], {}).get("status") == "complete" for d in slices[sid]["blocked_by"])
        and not constraint_conflicts(state, sid)
    ]


def constraint_conflicts(state, sid):
    """Returns (other ID, reason, where it runs) for each running slice constrained against sid.

    A slice runs while it is unfinished and has a worktree, or while it is in
    progress in the repository checkout.
    """
    slices, conflicts = state["slices"], []
    for c in state["run"]["constraints"]:
        if sid not in c["slices"]:
            continue
        other = c["slices"][1] if c["slices"][0] == sid else c["slices"][0]
        o = slices.get(other)
        if other == sid or not o:
            continue
        if o["worktree"] and o["status"] != "complete":
            conflicts.append((other, c["reason"], f"unfinished in worktree {o['worktree']['path']}"))
        elif o["status"] == "in-progress" and not o["worktree"]:
            conflicts.append((other, c["reason"], "in progress in the repository checkout"))
    return conflicts


def checkpoint_path(plan_dir, sid):
    return os.path.join(plan_dir, CHECKPOINT_DIR, f"{sid}.md")


def blocked_checkpoint(plan_dir, sid, fixed_point):
    """Returns a blocked slice's checkpoint path: always once started, else only when the file exists."""
    path = checkpoint_path(plan_dir, sid)
    return path if fixed_point or os.path.isfile(path) else None


def status_view(plan_dir, state):
    slices = state["slices"]
    return {
        "plan": plan_dir,
        "repo": state["repo"],
        "run": state["run"],
        "slices": slice_rows(slices),
        "eligible": eligible_ids(state),
        "in_progress": [
            {"id": sid, "checkpoint": checkpoint_path(plan_dir, sid), "fixed_point": slices[sid]["fixed_point"],
             "worktree": slices[sid]["worktree"]}
            for sid in sorted_ids(slices) if slices[sid]["status"] == "in-progress"
        ],
        "blocked": [
            {"id": sid, "reason": slices[sid]["reason"], "fixed_point": slices[sid]["fixed_point"],
             "checkpoint": blocked_checkpoint(plan_dir, sid, slices[sid]["fixed_point"]),
             "worktree": slices[sid]["worktree"]}
            for sid in sorted_ids(slices) if slices[sid]["status"] == "blocked"
        ],
    }


def worktree_text(tree):
    if not tree:
        return ""
    notes = "; notes: " + "; ".join(tree["notes"]) if tree["notes"] else ""
    return f"; worktree {tree['path']} on {tree['branch']} from {tree['base']}{notes}"


def blocked_text(row):
    """Returns a blocked row's text: the reason, then any fixed point, checkpoint, and worktree."""
    details = [f"fixed point {row['fixed_point']}"] if row["fixed_point"] else []
    if row["checkpoint"]:
        details.append(f"checkpoint {row['checkpoint']}")
    text = "; ".join(details) + worktree_text(row["worktree"])
    return f"{row['reason']}  ({text.removeprefix('; ')})" if text else row["reason"]


def render_status(view):
    run = view["run"]
    tip = f"at {run['target_tip']}" if run["target_tip"] else "(unborn)"
    grant = run["grant"]
    autonomy = "not granted" if grant is None else f"granted {grant['granted']}" + (
        f" ({grant['note']})" if grant["note"] else "")
    lines = [f"Plan: {view['plan']}", f"Repository: {view['repo']}", f"Target: {run['target']} {tip}",
             f"Autonomy: {autonomy}", ""]
    lines += render_table(view["slices"]) + [""]
    lines.append("Eligible: " + (", ".join(view["eligible"]) or "none"))
    in_progress = [f"{row['checkpoint']}  (fixed point {row['fixed_point'] or 'not recorded'}"
                   f"{worktree_text(row['worktree'])})"
                   for row in view["in_progress"]]
    blocked = [blocked_text(row) for row in view["blocked"]]
    for title, rows, texts in (("In progress", view["in_progress"], in_progress),
                               ("Blocked", view["blocked"], blocked)):
        if not rows:
            lines.append(f"{title}: none")
            continue
        lines.append(f"{title}:")
        lines += [f"  {row['id']}  {text}" for row, text in zip(rows, texts)]
    constraints = run["constraints"]
    lines.append("Constraints:" + ("" if constraints else " none"))
    lines += [f"  {', '.join(c['slices'])}  {c['reason']}" for c in constraints]
    return "\n".join(lines)


def cmd_status(args):
    plan_dir = plan_dir_of(args)
    state = load_state(plan_dir)
    view = status_view(plan_dir, state)
    if args.json:
        print(json.dumps(view, indent=2, ensure_ascii=False))
    else:
        print(render_status(view))


def cmd_next(args):
    if args.limit is not None and args.limit < 1:
        raise PlanError("--limit must be at least 1")
    state = load_state(plan_dir_of(args))
    for sid in eligible_ids(state)[: args.limit]:
        s = state["slices"][sid]
        print(f"{sid}\t{s['file']}\t{s['outcome']}")


def cmd_validate(args):
    plan_dir = plan_dir_of(args)
    problems = state_problems(load_state(plan_dir))
    if problems:
        raise PlanError(f"{len(problems)} problem(s) in {state_path(plan_dir)}:\n  " + "\n  ".join(problems))
    print("Plan is valid")


# ---------------------------------------------------------------- lifecycle


HEX_PREFIX = re.compile(r"^[0-9a-f]{7,64}$")
CHECKPOINT_TEMPLATE = "Not started.\n"
RESUMED_TEMPLATE = "Resumed with no checkpoint recorded; recover progress from Git and log.md.\n"
LOG_ENTRY_LEVEL = 3  # headings folded into a `## ` log entry start at `###`.


def fixed_point_of(repo):
    """Returns `git rev-parse HEAD`, or the empty-tree hash in an unborn repository."""
    code, head = run_git(repo, "rev-parse", "--verify", "--quiet", "HEAD")
    if code == 0 and head:
        return head
    code, tree = run_git(repo, "hash-object", "-t", "tree", os.devnull)
    if code != 0 or not tree:
        raise PlanError(f"cannot read a fixed point in {repo}")
    return tree


def dirty_snapshot(path, exclude=None):
    """Returns `git status --porcelain` of the work tree at path, unstripped ("" when clean).

    exclude is a path relative to that work tree's root left out of the report.
    Untracked files are always listed, whatever status.showUntrackedFiles says,
    since the dirt guards protect them and `git worktree remove` honours it.
    """
    args = ["--no-optional-locks", "status", "--porcelain", "--untracked-files=normal"]
    if exclude:
        args += ["--", ".", f":(exclude,literal){exclude}"]
    code, out = run_git(path, *args, strip=False)
    if code != 0:
        raise PlanError(f"cannot read `git status` in {path}; is it a Git work tree?")
    return out


def is_ancestor(repo, ancestor, descendant):
    """True when ancestor equals descendant or is reachable from it."""
    return ancestor == descendant or run_git(repo, "merge-base", "--is-ancestor", ancestor, descendant)[0] == 0


def commit_of(repo, rev):
    """Returns the full sha of the commit rev names, or None; a rev starting with `-` names none."""
    if rev.startswith("-"):
        return None
    code, full = run_git(repo, "rev-parse", "--verify", "--quiet", rev + "^{commit}")
    return full if code == 0 and full else None


def fenced(text):
    """Wraps text in a code fence longer than any backtick run inside it."""
    longest = max((len(run) for run in re.findall(r"`+", text)), default=0)
    marker = "`" * max(3, longest + 1)
    return f"{marker}text\n{text.rstrip(chr(10))}\n{marker}"


def nested_prose(text, level=LOG_ENTRY_LEVEL):
    """Shifts headings outside code fences so the shallowest sits at level, nesting text under a log entry."""
    lines = text.splitlines(keepends=True)
    headings = []
    for index, line in unfenced(lines):
        match = HEADING.match(line.rstrip("\r\n"))
        if match:
            headings.append((index, len(match.group(1))))
    shift = max(0, level - min((depth for _, depth in headings), default=level))
    for index, depth in headings:
        lines[index] = "#" * min(6, depth + shift) + lines[index][depth:]
    return "".join(lines)


def get_slice(state, sid):
    s = state["slices"].get(sid)
    if s is None:
        raise PlanError(f"slice {sid} does not exist")
    return s


def check_force_reason(args):
    """Refuses --reason on a command where it can only explain --force."""
    if args.reason and not args.force:
        raise PlanError("--reason applies only with --force")


def guard_in_place(state, sid, guard):
    """Refuses a second slice in progress in the repository checkout; slices with a worktree run elsewhere."""
    for other in sorted_ids(state["slices"]):
        o = state["slices"][other]
        if other != sid and o["status"] == "in-progress" and o["worktree"] is None:
            guard.check(False, f"slice {other} is already in progress in the repository checkout")


def cmd_start(args):
    check_force_reason(args)
    if args.note and not args.worktree:
        raise PlanError("--note applies only with --worktree")
    guard = Guard(args)
    plan_dir = plan_dir_of(args)
    outcome = {}

    def change(state):
        s = get_slice(state, args.id)
        if s["worktree"]:
            raise PlanError(f"slice {args.id} already has worktree {s['worktree']['path']} on branch "
                            f"{s['worktree']['branch']}; continue it with `plan resume` or `plan land`")
        guard.check(s["status"] == "ready", f"slice {args.id} is {s['status']}, not ready")
        for dep in s["blocked_by"]:
            status = state["slices"][dep["id"]]["status"] if dep["id"] in state["slices"] else "missing"
            guard.check(status == "complete", f"slice {args.id} depends on {dep['id']}, which is {status}, not complete")
        for other, reason, where in constraint_conflicts(state, args.id):
            guard.check(False, f"slice {args.id} is constrained against {other}, which is {where} ({reason})")
        if args.worktree:
            effects = start_in_worktree(plan_dir, state, args.id, args.note or [], guard)
            outcome["worktree"] = s["worktree"]
            return effects
        guard_in_place(state, args.id, guard)
        repo = state["repo"]
        snapshot = dirty_snapshot(repo)
        previous = s["fixed_point"]
        s.update(status="in-progress", reason=None, fixed_point=fixed_point_of(repo), snapshot=snapshot, landed=None)
        path = checkpoint_path(plan_dir, args.id)
        exists = os.path.exists(path)
        body = [f"Fixed point: {s['fixed_point']}"]
        if previous and previous != s["fixed_point"]:
            body.append(f"Replaces fixed point: {previous}")
        body.append("Dirty snapshot: clean" if snapshot == "" else "Dirty snapshot:\n\n" + fenced(snapshot))
        body.append(f"Checkpoint: {CHECKPOINT_DIR}/{args.id}.md ({'kept' if exists else 'created'})")
        return Effects(entry=(f"slice {args.id} started", "\n".join(body)),
                       create_checkpoint=(path, CHECKPOINT_TEMPLATE))

    write_plan(plan_dir, f"start {args.id}" + (" --worktree" if args.worktree else ""), change, guard)
    if args.worktree:
        tree = outcome["worktree"]
        print(f"Started slice {args.id} in worktree {tree['path']} on branch {tree['branch']} from {tree['base']}; "
              f"checkpoint {checkpoint_path(plan_dir, args.id)}")
    else:
        print(f"Started slice {args.id}; checkpoint {checkpoint_path(plan_dir, args.id)}")


def cmd_block(args):
    if not args.reason:
        raise PlanError("block requires --reason <text>")
    guard = Guard(args)

    def change(state):
        s = get_slice(state, args.id)
        was = s["status"]
        guard.check(was in ("in-progress", "ready"),
                    f"slice {args.id} is {was}; only an in-progress or ready slice is blocked")
        s.update(status="blocked", reason=args.reason, landed=None)
        return Effects(entry=(f"slice {args.id} blocked", f"Reason: {args.reason}\nWas: {was}"))

    write_plan(plan_dir_of(args), f"block {args.id}", change, guard)
    print(f"Blocked slice {args.id}")


def cmd_resume(args):
    check_force_reason(args)
    guard = Guard(args)
    plan_dir = plan_dir_of(args)
    outcome = {}

    def change(state):
        s = get_slice(state, args.id)
        guard.check(s["status"] == "blocked", f"slice {args.id} is {s['status']}, not blocked")
        started = s["fixed_point"] is not None
        if started and s["worktree"] is None:
            guard_in_place(state, args.id, guard)
        outcome["status"] = "in-progress" if started else "ready"
        s.update(status=outcome["status"], reason=None, landed=None)
        detail = f"fixed point {s['fixed_point']}" if started else "not started"
        path = checkpoint_path(plan_dir, args.id)
        body = [f"Status: {outcome['status']} ({detail})"]
        if s["worktree"]:
            body.append(f"Worktree: {s['worktree']['path']} on {s['worktree']['branch']}")
        if started and not os.path.exists(path):
            body.append(f"Checkpoint: {CHECKPOINT_DIR}/{args.id}.md (created; none was recorded)")
        return Effects(entry=(f"slice {args.id} resumed", "\n".join(body)),
                       create_checkpoint=(path, RESUMED_TEMPLATE) if started else None)

    write_plan(plan_dir, f"resume {args.id}", change, guard)
    print(f"Resumed slice {args.id} as {outcome['status']}")


def folded_prose(plan_dir, sid, evidence):
    """Returns the log lines holding the evidence and the slice's checkpoint, headings nested under the entry."""
    path = checkpoint_path(plan_dir, sid)
    body = ["Evidence:", "", nested_prose(evidence).strip("\n") or "(none)", ""]
    if os.path.isfile(path):
        body += [f"Checkpoint ({CHECKPOINT_DIR}/{sid}.md):", "", nested_prose(read_text(path)).strip("\n")]
    else:
        body.append(f"No checkpoint file {CHECKPOINT_DIR}/{sid}.md was found.")
    return body


def read_text_argument(value, what):
    """Returns an argument's text, reading `@path` (relative to the current directory) from a file."""
    if not value.startswith("@"):
        return value
    path = os.path.abspath(value[1:])
    try:
        return read_text(path)
    except OSError as exc:
        raise PlanError(f"cannot read {what} file {path}: {exc.strerror or exc}")


def landed_revision(state, s, rev, guard):
    """Resolves a landed revision, guarding that it is the fixed point or on the target branch."""
    repo, target, fixed = state["repo"], state["run"]["target"], s["fixed_point"]
    full = commit_of(repo, rev)
    if fixed and (full == fixed or (full is None and HEX_PREFIX.match(rev) and fixed.startswith(rev))):
        return fixed  # a no-code result, including the empty tree of an unborn repository
    guard.check(full is not None, f"revision {rev} is not a commit in {repo}")
    if full is None:
        return rev
    tip = commit_of(repo, f"refs/heads/{target}")
    on_target = tip is not None and is_ancestor(repo, full, tip)
    guard.check(on_target, f"revision {rev} is not the tip of {target} or its ancestor")
    return full


def advance_target_tip(state, landed):
    """Moves the recorded target tip to the live tip when every commit between them was landed.

    Each commit in `recorded..live` (all of live's history when no tip was
    recorded) must be a landed revision, and live must descend from recorded,
    so outside commits and a rewritten target keep the recorded tip. Returns
    the log line.
    """
    repo, run = state["repo"], state["run"]
    recorded, live = run["target_tip"], commit_of(repo, f"refs/heads/{run['target']}")
    if live == recorded:
        return f"Target tip: {recorded} (unchanged)"
    between = None
    if live and (recorded is None or is_ancestor(repo, recorded, live)):
        code, out = run_git(repo, "rev-list", live if recorded is None else f"{recorded}..{live}")
        between = out.split() if code == 0 else None
    if between and set(between) <= set(landed):
        run["target_tip"] = live
        return f"Target tip: {recorded or 'unborn'} -> {live}"
    return (f"Target tip: kept at {recorded or 'unborn'}; the live tip {live or '(unborn)'} holds commits "
            "this slice did not land (pass every slice commit with --rev), or the target was rewritten")


def cmd_complete(args):
    check_force_reason(args)
    guard = Guard(args)
    plan_dir = plan_dir_of(args)
    evidence = read_text_argument(args.evidence, "evidence")

    def change(state):
        s = get_slice(state, args.id)
        guard.check(s["status"] == "in-progress", f"slice {args.id} is {s['status']}, not in-progress")
        if s["worktree"]:
            guard.check(False, f"slice {args.id} runs in worktree {s['worktree']['path']}; land it with "
                        f"`plan land {args.id}`")
        landed = []
        for rev in args.rev:
            full = landed_revision(state, s, rev, guard)
            if full not in landed:
                landed.append(full)
        guard.check(evidence.strip() != "", "evidence is empty")
        path = checkpoint_path(plan_dir, args.id)
        body = [f"Landed: {', '.join(landed)}", f"Fixed point: {s['fixed_point'] or 'not recorded'}", ""]
        body += folded_prose(plan_dir, args.id, evidence)
        s.update(status="complete", reason=None, landed=landed)
        body += ["", advance_target_tip(state, landed)]
        return Effects(entry=(f"slice {args.id} complete", "\n".join(body)), remove_checkpoint=path)

    write_plan(plan_dir, f"complete {args.id}", change, guard)
    print(f"Completed slice {args.id}")


# ---------------------------------------------------------------- worktrees and landing


WORKTREE_DIR = "worktrees"


def inside(path, root):
    """Returns path relative to root when path is root or inside it, else None (both resolved)."""
    path, root = os.path.realpath(path), os.path.realpath(root)
    return os.path.relpath(path, root) if os.path.commonpath([path, root]) == root else None


def worktree_path(plan_dir, repo, sid):
    """Where slice sid's worktree goes: in the plan directory, or under the Striker state root when that is in the repository."""
    if inside(plan_dir, repo) is None:
        return os.path.join(plan_dir, WORKTREE_DIR, sid)
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    root = os.environ.get("STRIKER_ROOT") or os.path.join(state_home, "striker")
    return os.path.join(os.path.abspath(root), WORKTREE_DIR, os.path.basename(repo), os.path.basename(plan_dir), sid)


def worktree_branch(repo, plan_dir, sid):
    """Names slice sid's branch `plan/<plan directory name>/<ID>`, with characters Git refuses replaced by `-`."""
    name = re.sub(r"\.{2,}|[^A-Za-z0-9._-]+", "-", os.path.basename(plan_dir)).strip(".-") or "plan"
    branch = f"plan/{name}/{sid}"
    if run_git(repo, "check-ref-format", "--branch", branch)[0] != 0:
        raise PlanError(f"slice {sid} cannot get a branch: {branch!r} is not a valid branch name")
    return branch


def checked_out_branch(repo):
    code, head = run_git(repo, "symbolic-ref", "--quiet", "HEAD")
    return head[len("refs/heads/"):] if code == 0 and head.startswith("refs/heads/") else None


def porcelain_paths(text, limit=5):
    paths = [line[3:] for line in text.splitlines() if line.strip()]
    return ", ".join(paths[:limit]) + (f", and {len(paths) - limit} more" if len(paths) > limit else "")


def root_dirt(plan_dir, repo):
    """Returns `git status --porcelain` of the repository root, leaving out the plan directory ("" when clean)."""
    relative = inside(plan_dir, repo)
    return dirty_snapshot(repo, exclude=None if relative == "." else relative)


def worktree_dirt(path):
    """Returns `git status --porcelain` in a slice worktree, or None when the worktree is missing."""
    return dirty_snapshot(path) if os.path.isdir(path) else None


def on_target_refusal(repo, target):
    """Returns the refusal text when the repository root does not have target checked out, else None."""
    current = checked_out_branch(repo)
    if current == target:
        return None
    return f"the repository root {repo} has {current or 'a detached HEAD'} checked out, not {target}"


def guard_root(plan_dir, state, guard, check_tip=True):
    """Guards that the repository root has the target checked out at the recorded tip, clean outside the plan directory."""
    repo, run = state["repo"], state["run"]
    target, recorded = run["target"], run["target_tip"]
    refusal = on_target_refusal(repo, target)
    guard.check(refusal is None, refusal)
    live = commit_of(repo, f"refs/heads/{target}")
    if check_tip:
        guard.check(live == recorded, f"{target} is at {live or '(unborn)'}, not the recorded tip "
                    f"{recorded or '(unborn)'}; record outside commits with `plan target-tip`")
    dirt = root_dirt(plan_dir, repo)
    guard.check(dirt == "", f"the repository root {repo} has uncommitted changes outside the plan directory "
                f"({porcelain_paths(dirt)})")
    return live


def make_parents(directory, created):
    """Creates directory and its missing parents, appending each one it creates to created."""
    missing = []
    while not os.path.isdir(directory):
        missing.append(directory)
        directory = os.path.dirname(directory)
    for path in reversed(missing):
        os.mkdir(path)
        created.append(path)


def start_in_worktree(plan_dir, state, sid, notes, guard):
    """Plans `start --worktree`: a branch and worktree at the recorded target tip, created by Effects.act."""
    repo, run = state["repo"], state["run"]
    recorded = run["target_tip"]
    if recorded is None:
        raise PlanError(f"{run['target']} has no recorded tip; a worktree starts from a commit")
    guard_root(plan_dir, state, guard)
    path, branch = worktree_path(plan_dir, repo, sid), worktree_branch(repo, plan_dir, sid)
    if os.path.lexists(path):
        raise PlanError(f"{path} already exists; remove what an earlier start left there, then start again")
    if commit_of(repo, f"refs/heads/{branch}"):
        raise PlanError(f"branch {branch} already exists in {repo}; delete what an earlier start left, "
                        "then start again")
    s = state["slices"][sid]
    previous = s["fixed_point"]
    s.update(status="in-progress", reason=None, fixed_point=recorded, snapshot="", landed=None,
             worktree={"path": path, "branch": branch, "base": recorded, "notes": list(notes)})
    checkpoint = checkpoint_path(plan_dir, sid)
    exists = os.path.exists(checkpoint)

    def act():
        created = []

        def undo():
            """Removes whatever part of the worktree and branch Git made; neither existed before this start."""
            if os.path.lexists(path):
                run_git_full(repo, "worktree", "remove", "--force", path)
            if os.path.lexists(path):
                shutil.rmtree(path, ignore_errors=True)
            run_git_full(repo, "worktree", "prune")
            if commit_of(repo, f"refs/heads/{branch}"):
                code, _, err = run_git_full(repo, "branch", "-D", branch)
                if code != 0:
                    print(f"plan: error: could not delete branch {branch}: {err.strip()}", file=sys.stderr)
            if os.path.lexists(path):
                print(f"plan: error: could not remove {path}", file=sys.stderr)
            remove_created(created)

        make_parents(os.path.dirname(path), created)
        try:
            git_or_fail(repo, "worktree", "add", "--quiet", "-b", branch, path, recorded)
            s["snapshot"] = dirty_snapshot(path)
        except BaseException:
            undo()
            raise
        return undo

    def entry():
        body = [f"Worktree: {path}", f"Branch: {branch}", f"Base: {recorded}", f"Fixed point: {recorded}"]
        if previous and previous != recorded:
            body.append(f"Replaces fixed point: {previous}")
        body.append("Dirty snapshot: clean" if s["snapshot"] == "" else "Dirty snapshot:\n\n" + fenced(s["snapshot"]))
        body += [f"Note: {note}" for note in notes]
        body.append(f"Checkpoint: {CHECKPOINT_DIR}/{sid}.md ({'kept' if exists else 'created'})")
        return f"slice {sid} started", "\n".join(body)

    return Effects(entry=entry, create_checkpoint=(checkpoint, CHECKPOINT_TEMPLATE), act=act)


def revisions_between(repo, base, tip):
    """Returns the commits in base..tip (all of tip's history when base is None), oldest first."""
    code, out = run_git(repo, "rev-list", "--reverse", tip if base is None else f"{base}..{tip}")
    if code != 0:
        raise PlanError(f"cannot list the commits between {base} and {tip} in {repo}")
    return out.split()


def tip_before(repo, branch, tip):
    """Returns what branch pointed at before its reflog reached tip, or None when the reflog does not say.

    Reads the reflog's (old, new) pairs newest first and takes the old value
    of the latest move to tip that came from outside tip's descendants, so a
    commit made after reaching tip and then reset away is skipped.
    """
    code, path = run_git(repo, "rev-parse", "--git-path", f"logs/refs/heads/{branch}")
    if code != 0:
        return None
    try:
        lines = read_text(os.path.join(repo, path)).splitlines()
    except (OSError, UnicodeDecodeError):
        return None
    for line in reversed(lines):
        fields = line.split(" ", 2)
        if len(fields) < 2 or fields[1] != tip:
            continue
        old = fields[0]
        if set(old) == {"0"}:
            return None  # the branch was created at tip
        if old != tip and not is_ancestor(repo, tip, old):
            return old
    return None


def land_change(plan_dir, state, sid, evidence, guard, outcome):
    """Plans the fast-forward and bookkeeping of `plan land`; None when an earlier land already did them."""
    s = get_slice(state, sid)
    tree = s["worktree"]
    if tree is None:
        raise PlanError(f"slice {sid} has no worktree; complete a slice in the repository checkout with "
                        "`plan complete`")
    if s["status"] == "complete":
        outcome["finished"] = False
        return None
    guard.check(s["status"] == "in-progress", f"slice {sid} is {s['status']}, not in-progress")
    repo, run = state["repo"], state["run"]
    target, recorded = run["target"], run["target_tip"]
    refusal = on_target_refusal(repo, target)
    if refusal:
        raise PlanError(f"{refusal}; `plan land` fast-forwards {target} there")
    tip = commit_of(repo, f"refs/heads/{tree['branch']}")
    if tip is None:
        raise PlanError(f"branch {tree['branch']} of slice {sid} does not exist in {repo}")
    live = commit_of(repo, f"refs/heads/{target}")
    if live is None:
        raise PlanError(f"target branch {target} does not exist in {repo}")
    guard.check(evidence.strip() != "", "evidence is empty")
    dirt = worktree_dirt(tree["path"])
    guard.check(not dirt, f"worktree {tree['path']} has uncommitted changes ({porcelain_paths(dirt or '')}); "
                f"commit them to {tree['branch']} or remove them")
    act = None
    contained = is_ancestor(repo, tip, live)
    if contained and recorded != tip and (recorded is None or is_ancestor(repo, recorded, tip)):
        # An earlier land fast-forwarded the target past the recorded tip and stopped. What the target held
        # before that fast-forward must not be beyond the recorded tip, or outside commits would count as landed.
        prior = tip_before(repo, target, tip)
        if prior is None:
            guard.check(recorded is None, f"{target}'s reflog does not show where it reached {tip} from, so "
                        f"commits after the recorded tip {recorded} cannot be ruled out")
        else:
            guard.check(recorded is None or is_ancestor(repo, prior, recorded),
                        f"{target} reached {tip} from {prior}, which holds commits after the recorded tip "
                        f"{recorded}; record them with `plan target-tip {prior}` first")
        # forced past a prior beyond the recorded tip, only what the fast-forward added counts as landed
        before = prior if prior and recorded and not is_ancestor(repo, prior, recorded) else recorded
        moves = True
        forward = f"Fast-forward: none; {target} already contains {tip} (finishing an earlier `plan land`)"
    elif contained:
        guard_root(plan_dir, state, guard)  # its checkout check already passed above
        before, moves = live, False  # the branch holds nothing the target lacks
        forward = f"Fast-forward: none; {target} already contains {tip}"
    else:
        guard_root(plan_dir, state, guard)
        if not is_ancestor(repo, live, tip):
            raise PlanError(f"branch {tree['branch']} at {tip} is not a fast-forward of {target} at {live}; "
                            f"rebase it onto {live} in {tree['path']}")
        before, moves = live, True
        forward = f"Fast-forward: {target} {live} -> {tip}"

        def act():
            # the reflog entry lets a rerun after a crash confirm where the target came from
            git_or_fail(repo, "-c", "core.logAllRefUpdates=true", "merge", "--ff-only", "--quiet", tip)
            # a failure after this point keeps the fast-forward; rerunning `plan land` finishes the bookkeeping

    landed = revisions_between(repo, before, tip) or [tip]
    if moves:
        run["target_tip"] = tip
        tip_line = f"Target tip: {recorded} -> {tip}"
    else:
        tip_line = f"Target tip: kept at {recorded}"
    if live not in (tip, recorded) and is_ancestor(repo, tip, live):
        tip_line += f"; {target} is at {live}, beyond it; record outside commits with `plan target-tip`"
    s.update(status="complete", reason=None, landed=landed)
    body = [f"Landed: {', '.join(landed)}", f"Branch: {tree['branch']} at {tip}", f"Base: {tree['base']}",
            f"Fixed point: {s['fixed_point'] or 'not recorded'}", forward, tip_line, ""]
    body += folded_prose(plan_dir, sid, evidence)
    outcome.update(finished=True, tip=tip)
    return Effects(entry=(f"slice {sid} landed", "\n".join(body)), remove_checkpoint=checkpoint_path(plan_dir, sid),
                   act=act)


def removal_change(plan_dir, state, sid, guard, outcome):
    """Plans removing a landed slice's worktree and branch; None when they are already gone from the state."""
    s = get_slice(state, sid)
    tree = s["worktree"]
    if tree is None or s["status"] != "complete":
        return None
    repo, target = state["repo"], state["run"]["target"]
    branch_tip = commit_of(repo, f"refs/heads/{tree['branch']}")
    live = commit_of(repo, f"refs/heads/{target}")
    if branch_tip:
        guard.check(live is not None and is_ancestor(repo, branch_tip, live),
                    f"branch {tree['branch']} at {branch_tip} holds commits {target} lacks; land or drop them, "
                    f"then rerun `plan land {sid}`")
    dirt = worktree_dirt(tree["path"])
    guard.check(not dirt, f"worktree {tree['path']} has uncommitted changes ({porcelain_paths(dirt or '')}); "
                "they would be deleted with it")
    s["worktree"] = None
    outcome["removed"] = tree

    def act():
        if os.path.isdir(tree["path"]):
            # --force only after the guard above was overridden, so deleted changes are on record in log.md
            git_or_fail(repo, "worktree", "remove", *(["--force"] if dirt else []), tree["path"])
        else:
            run_git(repo, "worktree", "prune")
        if branch_tip:
            git_or_fail(repo, "branch", "-D", tree["branch"])
        for parent in (os.path.dirname(tree["path"]), os.path.dirname(os.path.dirname(tree["path"]))):
            try:
                os.rmdir(parent)  # only empty worktree folders go
            except OSError:
                break

    lines = [f"Worktree: {tree['path']} (removed)", f"Branch: {tree['branch']} (deleted)"]
    lines += [f"Released: {note}" for note in tree["notes"]]
    # A checkpoint left by a land stopped before deleting it was already folded into log.md.
    return Effects(entry=(f"slice {sid} worktree removed", "\n".join(lines)), act=act,
                   remove_checkpoint=checkpoint_path(plan_dir, sid))


def cmd_land(args):
    check_force_reason(args)
    plan_dir = plan_dir_of(args)
    evidence = read_text_argument(args.evidence, "evidence")
    require_state(plan_dir)
    outcome = {}
    landing, removal = Guard(args), Guard(args)
    with locked(plan_dir):
        commit_change(plan_dir, f"land {args.id}",
                      lambda state: land_change(plan_dir, state, args.id, evidence, landing, outcome), landing)
        commit_change(plan_dir, f"land {args.id}",
                      lambda state: removal_change(plan_dir, state, args.id, removal, outcome), removal)
    if outcome.get("finished"):
        print(f"Landed slice {args.id} at {outcome['tip']}")
    else:
        print(f"Slice {args.id} was already landed; finished its cleanup")
    if outcome.get("removed"):
        print(f"Removed worktree {outcome['removed']['path']} and branch {outcome['removed']['branch']}")


def require_reason(args, command):
    if not args.reason or not args.reason.strip():
        raise PlanError(f"{command} requires --reason <text>")


def cmd_constrain(args):
    require_reason(args, "constrain")
    for sid in (args.a, args.b):
        check_id(sid)
    if args.a == args.b:
        raise PlanError("a constraint names two different slices")
    guard = Guard(args)
    pair = sorted([args.a, args.b], key=natural_key)

    def change(state):
        for sid in pair:
            get_slice(state, sid)
        constraints = state["run"]["constraints"]
        existing = next((c for c in constraints if c["slices"] == pair), None)
        lines = [f"Reason: {args.reason}"]
        if existing:
            guard.check(False, f"slices {pair[0]} and {pair[1]} are already constrained ({existing['reason']})")
            lines.append(f"Replaces reason: {existing['reason']}")
            existing["reason"] = args.reason
        else:
            constraints.append({"slices": pair, "reason": args.reason})
            constraints.sort(key=lambda c: [natural_key(i) for i in c["slices"]])
        running = [sid for sid in pair if state["slices"][sid]["worktree"]
                   and state["slices"][sid]["status"] != "complete"]
        if len(running) == 2:
            lines.append("Both slices already run in worktrees; the constraint applies from their next start.")
        return Effects(entry=(f"constraint {pair[0]}, {pair[1]}", "\n".join(lines)))

    write_plan(plan_dir_of(args), f"constrain {pair[0]} {pair[1]}", change, guard)
    print(f"Constrained slices {pair[0]} and {pair[1]}")


def cmd_target_tip(args):
    require_reason(args, "target-tip")
    guard = Guard(args)
    outcome = {}

    def change(state):
        repo, run = state["repo"], state["run"]
        target, recorded = run["target"], run["target_tip"]
        full = commit_of(repo, args.sha)
        if full is None:
            raise PlanError(f"revision {args.sha} is not a commit in {repo}")
        guard.check(full != recorded, f"{full} is already the recorded tip")
        descends = recorded is None or is_ancestor(repo, recorded, full)
        guard.check(descends, f"revision {args.sha} does not descend from the recorded tip {recorded}")
        live = commit_of(repo, f"refs/heads/{target}")
        guard.check(live is not None and is_ancestor(repo, full, live),
                    f"revision {args.sha} is not the tip of {target} or its ancestor")
        lines = [f"Target tip: {recorded or 'unborn'} -> {full}"]
        if descends and full != recorded:
            lines.append(f"Commits accepted: {len(revisions_between(repo, recorded, full))}")
        lines.append(f"Reason: {args.reason}")
        run["target_tip"] = outcome["tip"] = full
        return Effects(entry=("target tip recorded", "\n".join(lines)))

    write_plan(plan_dir_of(args), "target-tip", change, guard)
    print(f"Recorded target tip {outcome['tip']}")


# ---------------------------------------------------------------- decisions and autonomy


def parse_slice_list(values):
    """Reads --slices values: IDs separated by commas or spaces, repeatable; `none` alone means no slices."""
    ids = [i for value in values for i in re.split(r"[\s,]+", value) if i]
    if len(ids) == 1 and ids[0].lower() == "none":
        return []
    if not ids:
        raise PlanError("--slices needs slice IDs, or `none` for a decision with no dependent slice")
    for i, sid in enumerate(ids):
        check_id(sid)
        if sid in ids[:i]:
            raise PlanError(f"slice {sid} is listed twice")
    return ids


def id_list(ids):
    return ", ".join(ids) or "none"


def unfinished_slices(state, ids):
    return [sid for sid in ids if state["slices"].get(sid, {}).get("status") != "complete"]


def decision_line_number(line):
    """Returns the n of a line recording decision R<n>, or None."""
    match = DECISION_LINE.match(line)
    if not match or not (match.group(1) or match.group(3) == " (" or match.group(3).startswith(":")):
        return None
    return int(match.group(2))


def next_decision_id(plan_dir, decisions):
    """Allocates the R<n> after the highest one in the index.

    The first decision of a plan continues after the highest R<n> that log.md
    records as a decision (a heading or list item starting with it, or a line
    starting `R<n>:` or `R<n> (`, outside code fences), so the prose-only decisions of an
    imported plan keep their numbers; an R<n> mentioned inside a sentence does
    not count.
    """
    if decisions:
        return f"R{max(int(did[1:]) for did in decisions) + 1}"
    log_path = os.path.join(plan_dir, LOG_FILE)
    lines = read_text(log_path).splitlines() if os.path.exists(log_path) else []
    numbers = [n for _, line in unfenced(lines) for n in [decision_line_number(line)] if n]
    return f"R{max(numbers, default=0) + 1}"


def cmd_decide(args):
    check_force_reason(args)
    guard = Guard(args)
    plan_dir = plan_dir_of(args)
    if args.id is not None and not DECISION_ID.fullmatch(args.id):
        raise PlanError(f"decision ID {args.id!r} must be R<n>, such as R1")
    slices = None if args.slices is None else parse_slice_list(args.slices)
    body = None if args.body is None else read_text_argument(args.body, "body")
    if args.id is None:
        missing = [flag for flag, value in (("--undo-cost", args.undo_cost), ("--slices", slices), ("--body", body))
                   if value is None]
        if missing:
            raise PlanError("a new decision requires " + ", ".join(missing))
    outcome = {}

    def change(state):
        decisions = state["decisions"]
        if args.id is None:
            guard.check(body.strip() != "", "body is empty")
            did = next_decision_id(plan_dir, decisions)
            decisions[did] = {"status": args.status, "undo_cost": args.undo_cost, "slices": slices,
                              "recorded": utc_now(), "updated": None}
            lines = [f"Status: {args.status}", f"Undo cost: {args.undo_cost}",
                     f"Slices: {id_list(slices)} (unfinished: {id_list(unfinished_slices(state, slices))})"]
        else:
            did, d = args.id, decisions.get(args.id)
            if d is None:
                raise PlanError(f"decision {did} does not exist")
            was = d["status"]
            # the same slices in another order revise nothing
            new_slices = None if slices is None or set(slices) == set(d["slices"]) else slices
            revises = (args.undo_cost not in (None, d["undo_cost"]) or new_slices is not None
                       or bool(body and body.strip()))
            if was == args.status:
                guard.check(was == "pending-review" and revises,
                            f"decision {did} is already {was}" + ("" if was == "approved" else
                                                                 "; pass --undo-cost, --slices, or --body to amend it"))
            else:
                guard.check(was == "pending-review", f"decision {did} is {was}; it cannot return to {args.status}")
            lines = [f"Status: {was} -> {args.status}" if was != args.status
                     else f"Status: {was}" + (" (amended)" if revises else "")]
            if args.undo_cost and args.undo_cost != d["undo_cost"]:
                lines.append(f"Undo cost: {d['undo_cost']} -> {args.undo_cost}")
            if new_slices is not None:
                lines.append(f"Slices: {id_list(d['slices'])} -> {id_list(new_slices)}")
            d.update(status=args.status, undo_cost=args.undo_cost or d["undo_cost"],
                     slices=d["slices"] if new_slices is None else new_slices, updated=utc_now())
        if body and body.strip():
            lines += ["", nested_prose(body).strip("\n")]
        outcome["id"] = did
        return Effects(entry=(f"{did} {args.status}", "\n".join(lines)))

    write_plan(plan_dir, "decide" + (f" {args.id}" if args.id else ""), change, guard)
    print(outcome["id"])


def decision_rows(state, pending):
    decisions = state["decisions"]
    ids = sorted_decision_ids(decisions)
    if pending:
        ids = [did for did in ids if decisions[did]["status"] == "pending-review"]
        ids.sort(key=lambda did: -UNDO_COSTS.index(decisions[did]["undo_cost"])
                 if decisions[did]["undo_cost"] in UNDO_COSTS else 1)
    return [{"id": did, "status": decisions[did]["status"], "undo_cost": decisions[did]["undo_cost"],
             "slices": decisions[did]["slices"], "recorded": decisions[did]["recorded"],
             "updated": decisions[did]["updated"], "unfinished": unfinished_slices(state, decisions[did]["slices"])}
            for did in ids]


def cmd_decisions(args):
    rows = decision_rows(load_state(plan_dir_of(args)), args.pending)
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return
    for row in rows:
        print("\t".join([row["id"], row["status"], row["undo_cost"], f"slices: {id_list(row['slices'])}",
                         f"unfinished: {id_list(row['unfinished'])}"]))


def cmd_grant(args):
    check_force_reason(args)
    guard = Guard(args)

    def change(state):
        run, previous = state["run"], state["run"]["grant"]
        guard.check(previous is None, f"autonomy is already granted ({previous['granted']})" if previous else "")
        run["grant"] = {"granted": utc_now(), "note": args.note or None}
        lines = [f"Granted: {run['grant']['granted']}"]
        if args.note:
            lines.append(f"Note: {args.note}")
        if previous:
            lines.append(f"Replaces grant from: {previous['granted']}")
        return Effects(entry=("autonomy granted", "\n".join(lines)))

    write_plan(plan_dir_of(args), "grant", change, guard)
    print("Granted autonomy")


def cmd_revoke(args):
    check_force_reason(args)
    guard = Guard(args)

    def change(state):
        previous = state["run"]["grant"]
        guard.check(previous is not None, "autonomy is not granted")
        state["run"]["grant"] = None
        lines = [f"Revoked grant from: {previous['granted']}" if previous else "No grant was recorded."]
        if args.note:
            lines.append(f"Note: {args.note}")
        return Effects(entry=("autonomy revoked", "\n".join(lines)))

    write_plan(plan_dir_of(args), "revoke", change, guard)
    print("Revoked autonomy")


# ---------------------------------------------------------------- import


FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
INDENTED_FENCE = re.compile(r"^\s*(`{3,}|~{3,})(.*)$")
SEPARATOR_ROW = re.compile(r"^\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?$")
UNESCAPED_PIPE = re.compile(r"(?<!\\)\|")
DEPENDENCY_GROUP = re.compile(r"^([^:]+?)\s*(?::\s*(.*))?$", re.S)
ID_LIST_SEPARATOR = re.compile(r"\s*,\s*(?:and\s+)?|\s+and\s+")
FACT_LINE = re.compile(r"^\s*(?:[-*+]\s+)?([^:|`]{1,40}):\s*(.*)$")
HEADING = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
SHA = re.compile(r"(?<![0-9A-Za-z])[0-9a-f]{7,40}(?![0-9A-Za-z])")
SNAPSHOT_WORD = re.compile(r"\bsnapshot\b", re.I)
FIXED_POINT_WORDS = ("fixed point", "starting revision", "baseline revision", "base revision")
CLEAN_WORDS = re.compile(r"\b(clean|none|empty)\b", re.I)
NO_DEPENDENCIES = ("", "none", "-", "—")

# plan.md labels, most specific first, for each repository fact import reads.
FACT_LABELS = {
    "repo": ("repository root", "repo root", "root", "repository", "repo"),
    "target": ("target branch", "branch", "branch/worktree", "target"),
    "planning_revision": ("planning revision",),
}

IMPORT_HELP = f"""\
Reads plan.md's slice table, the one table outside code fences whose header is
  {TABLE_HEADER_TEXT}
with one row per slice. Status is one of {", ".join(STATUSES)}. Blocked by is
None, or `;`-separated groups `ID: what it supplies`, where a group may name
several IDs separated by `,` or `and` (`02, 03 and 04: shared`) and may omit
the text. A blocked slice gets a reason pointing at its slice file.

Repository facts come from plan.md lines such as `- Root: <path>`,
`- Branch: <name>`, and `- Planning revision: <sha or unborn>` (a leading
backticked value or the first word). --repo and --target supply or override
the first two; the import refuses when neither source gives them. A planning
revision that abbreviates a commit is stored as its full sha, any other as
written.

log.md's `## Current checkpoint` section is removed. Its text becomes
checkpoints/<ID>.md when it names exactly one in-progress slice or, naming
none, exactly one blocked slice and a fixed point; the slice must not have a
checkpoints/<ID>.md yet. Otherwise the text is kept in log.md's import entry.
Each in-progress or blocked slice's fixed point (a sha on a `Fixed point` or
`Starting revision` line) and dirty snapshot (`clean`, backticked entries, or
a fenced block after a `snapshot` line) are read from its checkpoint into
state.json.

Refuses, changing nothing, when state.json exists, plan.md has no slice table
(the older spine.md layout is not supported), or the table has duplicate or
colliding IDs, unknown statuses, missing dependencies, or cycles. A failed
write restores every file and removes the lock file it created. Files are
written in the order checkpoint, log.md, plan.md, state.json, so a process
killed partway leaves no state.json; restore plan.md and log.md from a copy
before importing again.
"""


def import_refusal(problems):
    return PlanError("import refused, nothing changed:\n  " + "\n  ".join(problems))


def fence_opener(line, pattern=FENCE):
    """Returns the fence marker a line opens, or None."""
    match = pattern.match(line.rstrip("\r\n"))
    if not match or (match.group(1)[0] == "`" and "`" in match.group(2)):
        return None
    return match.group(1)


def closes_fence(line, marker, pattern=FENCE):
    match = pattern.match(line.rstrip("\r\n"))
    return bool(match) and match.group(1)[0] == marker[0] and len(match.group(1)) >= len(marker) \
        and not match.group(2).strip()


def unfenced(lines):
    """Yields (index, line) for lines outside fenced code blocks."""
    marker = None
    for index, line in enumerate(lines):
        if marker is None:
            marker = fence_opener(line)
            if marker is None:
                yield index, line
        elif closes_fence(line, marker):
            marker = None


def table_cells(line):
    text = line.strip()
    if not text.startswith("|"):
        return None
    cells = UNESCAPED_PIPE.split(text[1:])
    if text.endswith("|") and not text.endswith("\\|"):
        cells = cells[:-1]
    return [cell.strip().replace("\\|", "|") for cell in cells]


def is_slice_header(cells):
    return cells is not None and [" ".join(c.lower().split()) for c in cells] == [c.lower() for c in TABLE_COLUMNS]


def find_slice_tables(lines):
    """Returns [(first line, end line, [(line number, cells)])] for each slice table."""
    tables, rows, start = [], None, None
    visible = list(unfenced(lines))
    for position, (index, line) in enumerate(visible):
        if rows is not None:
            cells = table_cells(line)
            if cells is not None and index == visible[position - 1][0] + 1:
                rows.append((index + 1, cells))
                continue
            tables.append((start, visible[position - 1][0] + 1, rows))
            rows = None
        if not is_slice_header(table_cells(line)):
            continue
        following = visible[position + 1] if position + 1 < len(visible) else None
        if following and following[0] == index + 1 and SEPARATOR_ROW.match(following[1].strip()):
            start, rows = index, []
    if rows is not None:
        tables.append((start, visible[-1][0] + 1, rows))
    # The separator row is the first row collected; drop it.
    return [(first, end, body[1:]) for first, end, body in tables]


def file_cell(cell):
    link = re.fullmatch(r"\[[^\]]*\]\(([^)\s]+)\)", cell)
    if link:
        return link.group(1)
    return cell[1:-1] if len(cell) > 1 and cell[0] == cell[-1] == "`" else cell


def parse_dependency_cell(sid, cell):
    if cell.strip().lower() in NO_DEPENDENCIES:
        return [], []
    deps, problems = [], []
    for group in cell.split(";"):
        match = DEPENDENCY_GROUP.match(group.strip())
        ids = ID_LIST_SEPARATOR.split(match.group(1)) if match else []
        if not ids or not all(ID_PATTERN.match(i) for i in ids):
            problems.append(
                f"slice {sid}: cannot read dependency {group.strip()!r}; "
                "write `ID: what it supplies`, groups separated by `;`"
            )
            continue
        for dep_id in ids:
            if any(d["id"] == dep_id for d in deps):
                problems.append(f"slice {sid}: dependency {dep_id} is listed twice")
            else:
                deps.append({"id": dep_id, "supplies": (match.group(2) or "").strip()})
    return deps, problems


def parse_slice_rows(rows):
    slices, problems = {}, []
    for line_number, cells in rows:
        if len(cells) != len(TABLE_COLUMNS):
            problems.append(
                f"plan.md line {line_number}: slice table row has {len(cells)} cells; expected {len(TABLE_COLUMNS)}"
            )
            continue
        sid, file_name, outcome, deps_cell, status = cells
        if sid in slices:
            problems.append(f"slice {sid} is listed twice")
            continue
        deps, dep_problems = parse_dependency_cell(sid, deps_cell)
        problems += dep_problems
        file_name = file_cell(file_name)
        reason = f"blocked before `plan import`; see {file_name} for what resolves it" if status == "blocked" else None
        slices[sid] = new_slice(file_name, outcome, status, reason, deps)
    return slices, problems


def fact_value(raw):
    raw = raw.strip().lstrip("*_").strip()
    quoted = re.match(r"`([^`]+)`", raw)
    if quoted:
        return quoted.group(1).strip()
    word = re.match(r"[^\s;,()]+", raw)
    return word.group(0) if word else None


def repository_facts(lines):
    """Returns plan.md's repository root, target branch, and planning revision when stated."""
    found = {}
    for _, line in unfenced(lines):
        match = FACT_LINE.match(line)
        if not match:
            continue
        label = " ".join(match.group(1).strip("*_ ").lower().split())
        value = fact_value(match.group(2))
        if value and label not in found:
            found[label] = value
    return {
        fact: next((found[label] for label in labels if label in found), None)
        for fact, labels in FACT_LABELS.items()
    }


def checkpoint_section(lines):
    """Returns (start, end) line indexes of log.md's current checkpoint section, or None."""
    sections = []
    headings = [(i, HEADING.match(line)) for i, line in unfenced(lines)]
    headings = [(i, len(m.group(1)), m.group(2)) for i, m in headings if m]
    for position, (index, level, title) in enumerate(headings):
        if " ".join(title.lower().split()) != "current checkpoint":
            continue
        end = next((i for i, lvl, _ in headings[position + 1:] if lvl <= level), len(lines))
        sections.append((index, end))
    if len(sections) > 1:
        raise import_refusal([f"log.md has {len(sections)} `Current checkpoint` sections; keep one"])
    return sections[0] if sections else None


def mentions(text, sid):
    """True when text names sid as a word, not inside a date, time, version, or hash."""
    pattern = rf"(?<![A-Za-z0-9._:-]){re.escape(sid)}(?![A-Za-z0-9_-]|[.:][A-Za-z0-9])"
    return re.search(pattern, text) is not None


def resolve_revision(repo, revision):
    """Expands an abbreviated commit sha; names such as HEAD or a branch are not expanded."""
    if not SHA.fullmatch(revision):
        return None
    code, full = run_git(repo, "rev-parse", "--verify", "--quiet", revision + "^{commit}")
    return full if code == 0 and full else None


def fixed_point_in(text, repo):
    """Reads the first revision after a fixed-point label that Git resolves, or a full sha."""
    for line in text.splitlines():
        lowered = line.lower()
        hits = [lowered.index(w) + len(w) for w in FIXED_POINT_WORDS if w in lowered]
        for match in SHA.finditer(line, min(hits)) if hits else ():
            full = resolve_revision(repo, match.group(0))
            if full:
                return full
            if len(match.group(0)) == 40:
                return match.group(0)
    return None


def fenced_text(lines, start):
    """Returns the content of the fence opening at lines[start], dedented to its indent."""
    marker = fence_opener(lines[start], INDENTED_FENCE)
    indent = len(lines[start]) - len(lines[start].lstrip())
    body = []
    for entry in lines[start + 1:]:
        if closes_fence(entry, marker, INDENTED_FENCE):
            break
        body.append(entry[indent:] if entry[:indent].strip() == "" else entry.lstrip())
    return "".join(entry + "\n" for entry in body if entry.strip())


def snapshot_in(text):
    """Reads a dirty snapshot as porcelain text: "" when clean, None when not stated."""
    lines = text.splitlines()
    for index, line in enumerate(lines):
        word = SNAPSHOT_WORD.search(line)
        if not word:
            continue
        rest = line[word.end():]
        quoted = [q for q in re.findall(r"`([^`]+)`", rest) if not CLEAN_WORDS.fullmatch(q.strip())]
        if quoted:
            return "".join(q + "\n" for q in quoted)
        if CLEAN_WORDS.search(rest):
            return ""
        start = next((i for i in range(index + 1, len(lines)) if lines[i].strip()), None)
        if start is not None and fence_opener(lines[start], INDENTED_FENCE):
            return fenced_text(lines, start)
    return None


class Import:
    """The files and state one import writes, computed before any write."""

    def __init__(self, state, plan_text, log_text, checkpoint, notes):
        self.state = state
        self.plan_text = plan_text
        self.log_text = log_text
        self.checkpoint = checkpoint  # (slice ID, text) or None
        self.notes = notes


def read_slice_table(plan_dir):
    """Returns plan.md's lines and its one slice table, refusing anything else."""
    if os.path.exists(state_path(plan_dir)):
        raise import_refusal([f"{state_path(plan_dir)} already exists; this directory already holds a plan"])
    checkpoint_dir = os.path.join(plan_dir, CHECKPOINT_DIR)
    if os.path.exists(checkpoint_dir) and not os.path.isdir(checkpoint_dir):
        raise import_refusal([f"{checkpoint_dir} exists and is not a directory"])
    plan_path = os.path.join(plan_dir, PLAN_FILE)
    spine = os.path.exists(os.path.join(plan_dir, "spine.md"))
    unsupported = " This directory uses the older spine.md layout, which is not supported." if spine else ""
    if not os.path.isfile(plan_path):
        raise import_refusal([f"no {PLAN_FILE} in {plan_dir}.{unsupported}"])
    plan_text = read_text(plan_path)
    if locate_block(plan_text, plan_path) is not None:
        raise import_refusal([
            f"{plan_path} already has a generated status block but no {STATE_FILE}; "
            "after an interrupted import, restore plan.md and log.md from a copy"
        ])
    lines = plan_text.splitlines(keepends=True)
    tables = find_slice_tables(lines)
    if not tables:
        raise import_refusal([f"{plan_path} has no slice table with the header {TABLE_HEADER_TEXT}.{unsupported}"])
    if len(tables) > 1:
        raise import_refusal([f"{plan_path} has {len(tables)} slice tables; keep one"])
    return lines, tables[0]


def build_state(plan_dir, lines, table, repo_arg, target_arg):
    """Builds and checks state.json from the slice table and repository facts."""
    first, end, rows = table
    slices, problems = parse_slice_rows(rows)
    facts = repository_facts(lines[:first] + lines[end:])
    target = target_arg or facts["target"]
    for value, flag, example in ((repo_arg or facts["repo"], "--repo", "- Root: <path>"),
                                 (target, "--target", "- Branch: <name>")):
        if not value:
            problems.append(f"plan.md names no {flag[2:]} (e.g. `{example}`); pass {flag}")
    if problems:
        raise import_refusal(problems)
    if repo_arg:
        repo = repo_root(os.path.abspath(repo_arg))
    else:
        stated = os.path.expanduser(facts["repo"])
        repo = repo_root(stated if os.path.isabs(stated) else os.path.join(plan_dir, stated))
    revision = facts["planning_revision"]
    if revision == "unborn":
        revision = None
    state = {
        "schema": SCHEMA_VERSION,
        "repo": repo,
        "planning_revision": revision and (resolve_revision(repo, revision) or revision),
        "run": {"target": target, "target_tip": branch_tip(repo, target), "grant": None, "constraints": []},
        "slices": slices,
        "decisions": {},
    }
    problems = state_problems(state)
    if problems:
        raise import_refusal(problems)
    return state


def take_checkpoint(plan_dir, state):
    """Removes log.md's current checkpoint and reads started slices' fixed points.

    Returns (log text without the section, its body or None, (ID, text) to
    move or None, notes).
    """
    slices, repo = state["slices"], state["repo"]
    log_path = os.path.join(plan_dir, LOG_FILE)
    log_text = read_text(log_path) if os.path.exists(log_path) else ""
    log_lines = log_text.splitlines(keepends=True)
    section = checkpoint_section(log_lines)
    body = None
    if section:
        body = "".join(log_lines[section[0] + 1:section[1]]).strip("\n")
        log_text = "".join(log_lines[:section[0]] + log_lines[section[1]:])

    named = {status: [sid for sid in sorted_ids(slices) if slices[sid]["status"] == status
                      and body and mentions(body, sid)]
             for status in ("in-progress", "blocked")}
    owner, notes = None, []
    if len(named["in-progress"]) == 1:
        owner = named["in-progress"][0]
    elif len(named["in-progress"]) > 1:
        notes.append(f"the current checkpoint names {', '.join(named['in-progress'])}; "
                     "it stays in log.md's import entry")
    elif len(named["blocked"]) == 1 and fixed_point_in(body, repo):
        owner = named["blocked"][0]
    if owner and os.path.exists(checkpoint_path(plan_dir, owner)):
        notes.append(f"{CHECKPOINT_DIR}/{owner}.md already exists; the current checkpoint stays in "
                     "log.md's import entry")
        owner = None
    checkpoint = (owner, body + "\n") if owner else None

    for sid in sorted_ids(slices):
        if slices[sid]["status"] not in ("in-progress", "blocked"):
            continue
        if checkpoint and checkpoint[0] == sid:
            text = checkpoint[1]
        elif os.path.isfile(checkpoint_path(plan_dir, sid)):
            text = read_text(checkpoint_path(plan_dir, sid))
        else:
            text = ""
        slices[sid]["fixed_point"] = fixed_point_in(text, repo)
        slices[sid]["snapshot"] = snapshot_in(text)
        if slices[sid]["status"] == "in-progress" and slices[sid]["fixed_point"] is None:
            notes.append(f"slice {sid} is in-progress without a recorded fixed point; recover it from Git")
    return log_text, body, checkpoint, notes


def prepare_import(plan_dir, repo_arg, target_arg):
    """Reads and checks everything an import needs; raises PlanError before any write."""
    lines, table = read_slice_table(plan_dir)
    state = build_state(plan_dir, lines, table, repo_arg, target_arg)
    log_text, body, checkpoint, notes = take_checkpoint(plan_dir, state)
    run = state["run"]
    entry = [
        f"Imported {len(state['slices'])} slices from plan.md's slice table into {STATE_FILE}.",
        f"Repository: {state['repo']}; target: {run['target']} at {run['target_tip'] or 'an unborn branch'}; "
        f"planning revision: {state['planning_revision'] or 'unknown'}.",
    ]
    if checkpoint:
        entry.append(f"Moved the current checkpoint from log.md to {CHECKPOINT_DIR}/{checkpoint[0]}.md.")
    entry += [f"Note: {note}." for note in notes]
    if body and not checkpoint:
        entry += ["", "The current checkpoint at import:", "", body]
    log_text = with_log_entry(log_text, "imported by `plan import`", "\n".join(entry))

    first, end, _ = table
    tail = "\n" if lines[end - 1].endswith("\n") else ""
    plan_text = "".join(lines[:first]) + render_block(state) + tail + "".join(lines[end:])
    return Import(state, plan_text, log_text, checkpoint, notes)


def apply_import(plan_dir, prepared):
    """Writes checkpoint, log, plan, then state.json; on failure restores each file."""
    writes = []
    if prepared.checkpoint:
        writes.append((checkpoint_path(plan_dir, prepared.checkpoint[0]), prepared.checkpoint[1]))
    writes += [
        (os.path.join(plan_dir, LOG_FILE), prepared.log_text),
        (os.path.join(plan_dir, PLAN_FILE), prepared.plan_text),
        (state_path(plan_dir), state_text(prepared.state)),
    ]
    originals = {}
    for path, _ in writes:
        if os.path.exists(path):
            with open(path, "rb") as handle:
                originals[path] = handle.read()
        else:
            originals[path] = None
    checkpoint_dir = os.path.join(plan_dir, CHECKPOINT_DIR)
    made_dir = prepared.checkpoint is not None and not os.path.isdir(checkpoint_dir)
    try:
        if made_dir:
            os.mkdir(checkpoint_dir)
        for path, text in writes:
            atomic_write(path, text)
    except BaseException:
        restore_all(originals)
        if made_dir:
            with contextlib.suppress(OSError):
                os.rmdir(checkpoint_dir)
        raise


def cmd_import(args):
    plan_dir = os.path.abspath(args.dir)
    prepare_import(plan_dir, args.repo, args.target)  # refuse before the lock file exists
    with locked(plan_dir, discard_on_error=True):
        prepared = prepare_import(plan_dir, args.repo, args.target)
        apply_import(plan_dir, prepared)
    for note in prepared.notes:
        print(f"plan: note: {note}", file=sys.stderr)
    print(f"Imported {len(prepared.state['slices'])} slices into {state_path(plan_dir)}")


# ---------------------------------------------------------------- parser


def build_parser():
    parser = argparse.ArgumentParser(
        prog="plan",
        description="Own a slice plan's mechanical state: status, dependencies, "
        "eligibility, run state, worktrees, scheduling constraints, the autonomy grant, and the "
        "decision index. Run it as `python3 <path>/plan`.",
        epilog=STATE_FIELDS + "\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[plan_option()],
    )
    parser.set_defaults(plan=None)
    sub = parser.add_subparsers(dest="command", metavar="<command>")
    sub.required = True

    init = sub.add_parser(
        "init",
        help="create a plan's state.json, log.md, and status block",
        description="Create state.json in DIR (refused when it already exists), an "
        "empty log.md when absent, and the generated status block in plan.md, "
        "creating plan.md when absent and keeping its prose otherwise.",
        epilog="Writes state.json fields: schema, repo, planning_revision, run.target, run.target_tip, "
        "run.grant (null), slices, decisions ({}).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    init.add_argument("dir", help="plan directory (created when absent)")
    init.add_argument("--repo", required=True, help="Git repository the plan changes")
    init.add_argument("--target", required=True, help="branch the plan lands on")
    init.set_defaults(func=cmd_init)

    import_cmd = sub.add_parser(
        "import",
        help="convert a current-format markdown plan into state.json",
        description="Convert the plan in DIR, written in the markdown PLAN-FORMAT, into a "
        "plan owned by `plan`: write state.json, replace plan.md's slice table with the "
        "generated status block, and move log.md's current checkpoint into checkpoints/<ID>.md.",
        epilog=IMPORT_HELP + "\nWrites state.json fields: schema, repo, planning_revision, run.target, "
        "run.target_tip, run.grant (null), slices (with fixed_point and snapshot for started slices), "
        "decisions ({}).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    import_cmd.add_argument("dir", help="plan directory holding plan.md and log.md")
    import_cmd.add_argument("--repo", help="Git repository the plan changes (overrides plan.md's Root)")
    import_cmd.add_argument("--target", help="branch the plan lands on (overrides plan.md's Branch)")
    import_cmd.set_defaults(func=cmd_import)

    slice_cmd = sub.add_parser(
        "slice",
        help="add or edit a slice",
        description="Add or edit a slice's file, outcome, dependencies, or status.",
    )
    slice_sub = slice_cmd.add_subparsers(dest="slice_command", metavar="<add|edit>")
    slice_sub.required = True
    for name, func in (("add", cmd_slice_add), ("edit", cmd_slice_edit)):
        adding = name == "add"
        p = slice_sub.add_parser(
            name,
            parents=[plan_option(), force_options()],
            help=("record a new slice" if adding else "change an existing slice"),
            description=(
                "Record a new slice; duplicate IDs are refused."
                if adding
                else "Change an existing slice's file, outcome, dependencies, or status, or log why its "
                "description changed."
            )
            + " Refuses a change that leaves a missing dependency or a cycle.",
            epilog="Writes state.json fields: slices.<ID>.file, outcome, status, reason, "
            "blocked_by; regenerates the plan.md status block. With --note, appends a "
            f"`slice <ID> {'added' if adding else 'revised'}` entry to log.md listing "
            + ("the recorded fields" if adding else "each changed field as `old -> new` (or `State unchanged.` when none changed)")
            + " and the note.\n\n" + FORCE_HELP,
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        p.add_argument("id", metavar="ID", help="stable slice ID, e.g. 01")
        p.add_argument("--file", required=adding, help="slice description file, relative to the plan directory")
        p.add_argument("--outcome", required=adding, help="one-line observable outcome")
        p.add_argument(
            "--blocked-by",
            nargs="+",
            action="extend",
            metavar="ID[:SUPPLIES]",
            help="dependency and the behavior it supplies; repeatable"
            + ("" if adding else "; replaces the list, `None` clears it"),
        )
        p.add_argument(
            "--status",
            choices=STATUSES,
            help="ready (default for add) or blocked; in-progress and complete need --force",
        )
        p.add_argument(
            "--note",
            metavar="TEXT|@FILE",
            help="why the slice is " + ("added" if adding else "revised, including a revision of its prose alone")
            + ", for log.md; @path reads it from a file",
        )
        p.set_defaults(func=func)

    validate = sub.add_parser(
        "validate",
        parents=[plan_option()],
        help="check statuses, dependencies, and cycles",
        description="Exit 0 on a valid plan; otherwise exit 1 naming each unknown status, "
        "blocked slice without a reason, missing dependency, and dependency cycle.",
        epilog="Reads state.json fields: slices.<ID>.status, reason, blocked_by.",
    )
    validate.set_defaults(func=cmd_validate)

    status = sub.add_parser(
        "status",
        parents=[plan_option()],
        help="show slices, eligible work, in-progress and blocked slices, and run state",
        description="Print the slice table, eligible slices, in-progress slices with their "
        "checkpoint path and worktree, blocked slices with their reason and any checkpoint path, and the "
        "run state, including the autonomy grant and the scheduling constraints.",
        epilog="--json prints one object with keys: plan, repo, run (target, target_tip, grant, "
        "constraints), slices (each with id and the state.json slice fields), eligible, in_progress "
        "({id, checkpoint, fixed_point, worktree}), blocked ({id, reason, fixed_point, checkpoint, "
        "worktree}). A blocked slice's checkpoint is the path of its checkpoints/<ID>.md, null when it "
        "has neither a fixed point nor a checkpoints/<ID>.md file; a non-null fixed_point means the "
        "slice was started.",
    )
    status.add_argument("--json", action="store_true", help="print the view as one JSON object")
    status.set_defaults(func=cmd_status)

    next_cmd = sub.add_parser(
        "next",
        parents=[plan_option()],
        help="list slices ready to start",
        description="List ready slices whose dependencies are all complete, in ID order, "
        "one per line as ID<TAB>file<TAB>outcome, leaving out a slice constrained against a "
        "running slice: one unfinished with a worktree, or in progress in the repository checkout.",
        epilog="Reads state.json fields: slices.<ID>.status, blocked_by, file, outcome, worktree; "
        "run.constraints.",
    )
    next_cmd.add_argument("--limit", type=int, metavar="N", help="list at most N slices")
    next_cmd.set_defaults(func=cmd_next)

    add_lifecycle_commands(sub)
    add_decision_commands(sub)
    return parser


def add_lifecycle_commands(sub):
    start = sub.add_parser(
        "start",
        parents=[plan_option(), force_options(FORCE_REASON_HELP)],
        help="start a ready slice in the repository checkout or in its own worktree",
        description="Mark a ready slice in-progress after its dependencies are complete, unless it "
        "shares a constraint with a running slice (unfinished with a worktree, or in progress in the "
        "repository checkout), and create "
        "checkpoints/<ID>.md as `Not started.` when absent.\n\n"
        "In the repository checkout (the default), no other slice may be in progress there; the "
        "fixed point is `git rev-parse HEAD` (the empty-tree hash in an unborn repository) and the "
        "snapshot is `git status --porcelain` of the repository root.\n\n"
        "With --worktree, the slice gets the branch plan/<plan directory name>/<ID> and a worktree "
        "at the recorded target tip, which is its fixed point; the snapshot is the new worktree's "
        "status. The worktree goes to worktrees/<ID> in the plan directory or, when the plan "
        "directory is inside the repository, to "
        "${STRIKER_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/striker}/worktrees/<repo>/<plan>/<ID>, "
        "where <repo> and <plan> are the repository root's and the plan directory's names. Refused "
        "(guarded) when the repository root does not have the target checked out at the recorded "
        "tip or has uncommitted changes outside the plan directory; refused outright when the path "
        "or branch already exists or the target has no recorded tip.",
        epilog="Writes state.json fields: slices.<ID>.status, reason, fixed_point, snapshot, landed "
        "(null), and worktree ({path, branch, base, notes}) with --worktree; appends a `slice <ID> "
        "started` entry to log.md. A forced start of a started slice records a new fixed point and "
        "logs the one it replaces; a slice that records a worktree is not started again.\n\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    start.add_argument("id", metavar="ID", help="slice ID")
    start.add_argument("--worktree", action="store_true", help="run the slice in its own branch and worktree")
    start.add_argument("--note", action="append", metavar="TEXT",
                       help="resource note for the worktree (port, database, cache); repeatable; only with --worktree")
    start.set_defaults(func=cmd_start)

    block = sub.add_parser(
        "block",
        parents=[plan_option(), force_options("why the slice is blocked (required); with --force, also "
                                              "why the guard is overridden")],
        help="block an in-progress or ready slice",
        description="Move an in-progress or ready slice to blocked with --reason, keeping its fixed "
        "point, snapshot, and checkpoint.",
        epilog="Writes state.json fields: slices.<ID>.status, reason, landed (null); appends a "
        "`slice <ID> blocked` entry to log.md.\n\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    block.add_argument("id", metavar="ID", help="slice ID")
    block.set_defaults(func=cmd_block)

    resume = sub.add_parser(
        "resume",
        parents=[plan_option(), force_options(FORCE_REASON_HELP)],
        help="resume a blocked slice",
        description="Move a blocked slice back to in-progress when it had started (its fixed point "
        "is recorded), otherwise to ready. Resuming to in-progress keeps the fixed point, snapshot, "
        "and worktree, and creates checkpoints/<ID>.md when absent; for a slice without a worktree "
        "it is refused while another slice is in progress in the repository checkout.",
        epilog="Writes state.json fields: slices.<ID>.status, reason, landed (null); appends a "
        "`slice <ID> resumed` entry to log.md.\n\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    resume.add_argument("id", metavar="ID", help="slice ID")
    resume.set_defaults(func=cmd_resume)

    complete = sub.add_parser(
        "complete",
        parents=[plan_option(), force_options(FORCE_REASON_HELP)],
        help="complete an in-progress slice with landed revisions and evidence",
        description="Mark an in-progress slice complete; a slice with a worktree is landed with "
        "`plan land` instead. Each --rev must be the target branch's tip "
        "or its ancestor, or equal the slice's fixed point for a no-code result; evidence must be "
        "non-empty. Appends the landed revisions, the evidence, and checkpoints/<ID>.md to log.md "
        "under a `slice <ID> complete` entry, with headings shifted to nest under it, then deletes "
        "the checkpoint file.",
        epilog="Writes state.json fields: slices.<ID>.status, reason, landed (full shas), and "
        "run.target_tip, moved to the live tip only when that tip descends from it and every "
        "commit between them is a --rev; otherwise the tip is kept and the log entry says so. "
        "The evidence and the checkpoint are prose and go to log.md only.\n\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    complete.add_argument("id", metavar="ID", help="slice ID")
    complete.add_argument("--rev", required=True, action="append", metavar="SHA",
                          help="landed revision; repeat it for every commit the slice landed")
    complete.add_argument("--evidence", required=True, metavar="TEXT|@FILE",
                          help="acceptance evidence, or @path to read it from a file")
    complete.set_defaults(func=cmd_complete)

    land = sub.add_parser(
        "land",
        parents=[plan_option(), force_options(FORCE_REASON_HELP)],
        help="fast-forward the target to a worktree slice's branch and finish the slice",
        description="Land an in-progress slice that has a worktree, after its branch was rebased onto "
        "the target tip. Fast-forwards the target branch in the repository root to the slice "
        "branch, records the commits it adds as landed, appends a `slice <ID> landed` entry with "
        "the evidence and checkpoints/<ID>.md (headings nested) to log.md and deletes the "
        "checkpoint, moves the recorded target tip to the slice branch, marks the slice complete, "
        "then removes the worktree and branch with a `slice <ID> worktree removed` entry.\n\n"
        "Guarded refusals: the slice is not in-progress, the evidence is empty, the worktree has "
        "uncommitted changes, the repository root has uncommitted changes outside the plan "
        "directory, the target tip differs from the recorded tip, or, at removal, the branch holds "
        "commits the target lacks. Refused outright: the slice has no worktree, the repository root "
        "does not have the target checked out, the slice branch or the target branch does not "
        "exist, or the branch is not a fast-forward of the target.\n\n"
        "Resuming: when the target already contains the slice branch's tip, as after a land that "
        "stopped after its fast-forward, a rerun skips the fast-forward and finishes the "
        "bookkeeping, refusing (guarded) when the target's reflog shows it held commits after the "
        "recorded tip just before reaching the branch tip, or does not show where it came from; for a complete slice whose worktree is still recorded, it only removes the "
        "worktree and branch (and a leftover checkpoint), without using --evidence. The branch is "
        "deleted only when the target contains it. A land killed after writing its log entry but "
        "before state.json leaves that entry in log.md; the rerun appends a complete one.",
        epilog="Writes state.json fields: slices.<ID>.status, reason, landed (the commits between the "
        "target tip and the branch tip, oldest first; the branch tip when there are none), worktree "
        "(null once removed), and run.target_tip.\n\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    land.add_argument("id", metavar="ID", help="slice ID")
    land.add_argument("--evidence", required=True, metavar="TEXT|@FILE",
                      help="verification and review evidence for the rebased branch, or @path to read it from a file")
    land.set_defaults(func=cmd_land)

    constrain = sub.add_parser(
        "constrain",
        parents=[plan_option(), force_options("why the two slices never run at once (required); with "
                                              "--force, also why the guard is overridden")],
        help="record that two slices never run at once",
        description="Record a symmetric scheduling constraint between slices A and B, kept apart from "
        "dependencies. While one of them runs (unfinished with a worktree, or in progress in the "
        "repository checkout), `plan next` omits the other and `plan start` refuses it. Constraining an already constrained pair is a guarded "
        "refusal; forced, it replaces the reason.",
        epilog="Writes state.json field: run.constraints; appends a `constraint <A>, <B>` entry to "
        "log.md.\n\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    constrain.add_argument("a", metavar="A", help="slice ID")
    constrain.add_argument("b", metavar="B", help="slice ID")
    constrain.set_defaults(func=cmd_constrain)

    target_tip = sub.add_parser(
        "target-tip",
        parents=[plan_option(), force_options("why the target tip moves (required); with --force, also "
                                              "why the guard is overridden")],
        help="accept outside commits on the target branch as the recorded tip",
        description="Record SHA as the target tip after commits made outside the plan. Guarded "
        "refusals: SHA does not descend from the recorded tip, is not the target's tip or its "
        "ancestor, or already is the recorded tip. A revision that is not a commit is refused outright.",
        epilog="Writes state.json field: run.target_tip; appends a `target tip recorded` entry with the "
        "reason to log.md.\n\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    target_tip.add_argument("sha", metavar="SHA", help="revision to record as the target tip")
    target_tip.set_defaults(func=cmd_target_tip)


def add_decision_commands(sub):
    decide = sub.add_parser(
        "decide",
        parents=[plan_option(), force_options(FORCE_REASON_HELP)],
        help="record a decision, or move one from pending-review to approved",
        description="Without R<n>, record a new decision: allocate the next R<n> (after the highest in "
        "the index; the plan's first decision continues after the highest R<n> that log.md lists "
        "as a decision: a heading or list item starting with it, or a line starting `R<n>:` or "
        "`R<n> (`), store its status, undo cost, and dependent "
        "slices, append --body to log.md under an `R<n> <status>` entry, and print the ID. With "
        "R<n>, update that decision: pending-review may move to approved, or stay pending-review "
        "when the update amends it; approving an approved decision, returning it to pending-review, "
        "or restating a status without amending anything is refused. An update may revise "
        "--undo-cost and --slices and append --body.",
        epilog="Writes state.json fields: decisions.<R>.status, undo_cost, slices, recorded, updated. "
        "Unknown decision IDs and slice IDs are refused, also with --force; an empty --body for a "
        "new decision is a guarded refusal.\n\n" + FORCE_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    decide.add_argument("id", nargs="?", metavar="R<n>", help="decision to update; omit to record a new one")
    decide.add_argument("--status", required=True, choices=DECISION_STATUSES, help="pending-review or approved")
    decide.add_argument("--undo-cost", choices=UNDO_COSTS,
                        help="cost of undoing the decision: low, medium, high, or irreversible "
                        "(required for a new decision)")
    decide.add_argument("--slices", action="append", metavar="IDS",
                        help="dependent slice IDs, separated by commas or spaces; repeatable; `none` for no slice "
                        "(required for a new decision)")
    decide.add_argument("--body", metavar="TEXT|@FILE",
                        help="the decision's prose for log.md, or @path to read it from a file "
                        "(required for a new decision)")
    decide.set_defaults(func=cmd_decide)

    decisions = sub.add_parser(
        "decisions",
        parents=[plan_option()],
        help="list decisions with their dependent and unfinished slices",
        description="List every decision in ID order, one per line as ID<TAB>status<TAB>undo cost"
        "<TAB>slices: …<TAB>unfinished: …, where unfinished names dependent slices not yet complete. "
        "--pending lists only pending-review decisions, costliest to undo first (irreversible, high, "
        "medium, low), then by ID.",
        epilog="--json prints a list of objects with keys: id, status, undo_cost, slices, recorded, "
        "updated, unfinished. Each decision's prose is in log.md under its `R<n>` entries.",
    )
    decisions.add_argument("--pending", action="store_true", help="only pending-review decisions, costliest first")
    decisions.add_argument("--json", action="store_true", help="print the rows as one JSON list")
    decisions.set_defaults(func=cmd_decisions)

    for name, func, summary, text, note_help in (
        ("grant", cmd_grant, "record the run's autonomy grant",
         "Record the run's autonomy grant in run.grant with the current UTC time and an `autonomy granted` "
         "log entry; refused while a grant is recorded. `plan status` shows it.",
         "the grant's terms, stored in run.grant and log.md"),
        ("revoke", cmd_revoke, "clear the run's autonomy grant",
         "Clear run.grant with an `autonomy revoked` log entry; refused when no grant is recorded.",
         "why the grant ends, for log.md"),
    ):
        p = sub.add_parser(
            name,
            parents=[plan_option(), force_options(FORCE_REASON_HELP)],
            help=summary,
            description=text,
            epilog="Writes state.json field: run.grant.\n\n" + FORCE_HELP,
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        p.add_argument("--note", metavar="TEXT", help=note_help)
        p.set_defaults(func=func)


def plan_option():
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument(
        "--plan",
        default=argparse.SUPPRESS,
        metavar="DIR",
        help="plan directory (default: the current directory)",
    )
    return parent


FORCE_REASON_HELP = "why --force overrides a guard (only with --force)"


def force_options(reason_help="why the slice is blocked (with --status blocked) and/or why --force overrides a guard"):
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument("--force", action="store_true", help="override a guarded refusal (needs --reason)")
    parent.add_argument("--reason", metavar="TEXT", help=reason_help)
    return parent


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except (PlanError, OSError, UnicodeDecodeError) as exc:
        print(f"plan: error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
