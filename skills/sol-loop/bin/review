#!/usr/bin/env python3
"""review: deterministic GPT Sol review runner for the sol-loop skill.

Python 3.9+, standard library only. The agent keeps every engineering judgment
(scoping, triage, fixes, pushback, and shipping); this CLI owns prompt assembly,
model/effort defaults, read-only Codex execution, retries, resume fallback with
prior findings, JSONL thread/cumulative-usage extraction, verdict validation,
diff stats, and session receipts.
"""
from __future__ import annotations

import argparse
import contextlib
import copy
import datetime
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from typing import Any

SCHEMA_VERSION = 1
STATE_FILE = "state.json"

DEFAULT_CONFIG: dict[str, Any] = {
    "model": "gpt-6.2-sol",
    "effort": "xhigh",
    "thread_mode": "resume",
    "max_rounds": 3,
    "extended_max_rounds": 5,
    "timeout_seconds": 900,
    "codex_bin": "codex",
}

VALID_THREAD_MODES = ("resume", "fresh")

VERDICT_LINE_RE = re.compile(
    r"^\s*(?:\*\*|__|`+)?VERDICT:\s*(APPROVE|CHANGES)(?:\*\*|__|`+)?\s*$",
    re.IGNORECASE,
)
LIST_PREFIX_RE = r"(?:(?:[-*+]|\d+[.)])\s+)?"
ID_GROUP_RE = (
    r"(?:\*\*|__|`+)?[SR]\d+(?:\*\*|__|`+)?"
    r"(?:\s*(?:,\s*and\b|,|\band\b)\s*(?:\*\*|__|`+)?[SR]\d+(?:\*\*|__|`+)?)*"
)
FINDING_LINE_RE = re.compile(
    rf"^\s*{LIST_PREFIX_RE}(?:\*\*|__|`+)?[SR]\d+(?:\*\*|__|`+)?\s+\[(blocker|should|nit)\](?:\s|:|$)",
    re.IGNORECASE,
)
RESOLVED_LINE_RE = re.compile(
    rf"^(?P<head>\s*{LIST_PREFIX_RE}{ID_GROUP_RE}"
    r"(?:\s+\[(?:blocker|should|nit)\])?)"
    r"\s*(?:[:—–-]\s*)?(?:\*\*|__|`+)?resolved\b",
    re.IGNORECASE,
)
DEFERRED_LINE_RE = re.compile(
    rf"^(?P<head>\s*{LIST_PREFIX_RE}{ID_GROUP_RE}"
    r"(?:\s+\[(?:blocker|should|nit)\])?)"
    r"\s*(?:[:—–-]\s*)?(?:\*\*|__|`+)?(?:deferred|declined|waived)\b",
    re.IGNORECASE,
)
STILL_OPEN_LINE_RE = re.compile(
    rf"^(?P<head>\s*{LIST_PREFIX_RE}{ID_GROUP_RE}"
    r"(?:\s+\[(?:blocker|should|nit)\])?)"
    r"\s*(?:[:—–-]\s*)?(?:\*\*|__|`+)?still\s+open\b",
    re.IGNORECASE,
)
FINDING_ID_RE = re.compile(r"\b[SR]\d+\b", re.IGNORECASE)
NIT_TAG_RE = re.compile(r"\[nit\]", re.IGNORECASE)

CONTRADICTORY_APPROVE_ERR = (
    "contradictory APPROVE verdict alongside blocker, should, or still-open findings"
)
CONTRADICTORY_COERCE_WARNING = (
    "Sol returned APPROVE alongside blocker, should, or still-open findings even after format retry; "
    "treated conservatively as CHANGES"
)

UNAVAILABLE_PATTERNS: tuple[tuple[str, re.Pattern[str]], ...] = (
    (
        "authentication error",
        re.compile(
            r"not\s+logged\s+in|login\s+required|please\s+log\s*in|codex\s+login|"
            r"unauthorized|\b401\b|invalid\s+api[\s_-]*key|missing\s+api[\s_-]*key|"
            r"authentication\s+failed|sign\s+in\s+required",
            re.IGNORECASE,
        ),
    ),
    (
        "unsupported or rejected model",
        re.compile(
            r"model[\s_-]+not[\s_-]+found|unsupported\s+model|unknown\s+model|invalid\s+model|"
            r"model\b[^\n]*\bdoes\s+not\s+exist|model\b[^\n]*\bnot\s+available|"
            r"model\b[^\n]*\bnot\s+supported",
            re.IGNORECASE,
        ),
    ),
    (
        "network or sandbox blocked",
        re.compile(
            r"operation\s+not\s+permitted|network\s+is\s+unreachable|"
            r"could\s+not\s+resolve\s+host|name\s+or\s+service\s+not\s+known|"
            r"nodename\s+nor\s+servname|failed\s+to\s+lookup\s+address|"
            r"connection\s+refused|\benotfound\b|\beai_again\b|\beconnrefused\b|"
            r"\benetunreach\b|network\s+(?:access\s+)?(?:is\s+)?disabled|"
            r"sandbox\b[^\n]*\b(?:block|denied|prevent|disallow)",
            re.IGNORECASE,
        ),
    ),
)

BLOCKED_HINT = "Stop and report blocker_reason to the user. Do not substitute another model."


class UsageError(Exception):
    """Caller invocation, input, or configuration error (exits 2, stderr only)."""


def utc_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_positive_int(value: Any, label: str) -> int:
    if isinstance(value, bool):
        raise UsageError(f"{label} must be a positive integer")
    try:
        parsed = int(value)
    except (TypeError, ValueError) as exc:
        raise UsageError(f"{label} must be a positive integer: {value!r}") from exc
    if parsed < 1:
        raise UsageError(f"{label} must be >= 1, got {parsed}")
    return parsed


def resolve_config(args: argparse.Namespace) -> dict[str, Any]:
    cfg = copy.deepcopy(DEFAULT_CONFIG)

    env_map = (
        ("SOL_LOOP_MODEL", "model"),
        ("SOL_LOOP_EFFORT", "effort"),
        ("SOL_LOOP_THREAD_MODE", "thread_mode"),
        ("SOL_LOOP_MAX_ROUNDS", "max_rounds"),
        ("SOL_LOOP_EXTENDED_MAX_ROUNDS", "extended_max_rounds"),
        ("SOL_LOOP_TIMEOUT", "timeout_seconds"),
        ("SOL_LOOP_CODEX_BIN", "codex_bin"),
    )
    for env_name, key in env_map:
        raw_val = os.environ.get(env_name)
        if raw_val is not None and raw_val != "":
            cfg[key] = raw_val

    cli_map = (
        ("model", "model"),
        ("effort", "effort"),
        ("thread_mode", "thread_mode"),
        ("max_rounds", "max_rounds"),
        ("timeout", "timeout_seconds"),
        ("codex_bin", "codex_bin"),
    )
    for attr, key in cli_map:
        val = getattr(args, attr, None)
        if val is not None:
            cfg[key] = val

    if not isinstance(cfg["model"], str) or not cfg["model"].strip():
        raise UsageError("model must be a non-empty string")
    if not isinstance(cfg["effort"], str) or not cfg["effort"].strip():
        raise UsageError("effort must be a non-empty string")
    if not isinstance(cfg["thread_mode"], str) or cfg["thread_mode"] not in VALID_THREAD_MODES:
        raise UsageError(
            f"unsupported thread_mode {cfg['thread_mode']!r}; expected one of: {', '.join(VALID_THREAD_MODES)}"
        )

    cfg["max_rounds"] = parse_positive_int(cfg["max_rounds"], "max_rounds")
    cfg["extended_max_rounds"] = parse_positive_int(cfg["extended_max_rounds"], "extended_max_rounds")
    if cfg["max_rounds"] > cfg["extended_max_rounds"]:
        raise UsageError(
            f"max_rounds ({cfg['max_rounds']}) exceeds extended_max_rounds ({cfg['extended_max_rounds']}); "
            "raise SOL_LOOP_EXTENDED_MAX_ROUNDS to allow a higher ceiling"
        )
    cfg["timeout_seconds"] = parse_positive_int(cfg["timeout_seconds"], "timeout_seconds")
    if not isinstance(cfg["codex_bin"], str) or not cfg["codex_bin"].strip():
        raise UsageError("codex_bin must be a non-empty string")

    return cfg


def atomic_write_text(path: str, content: str) -> None:
    parent = os.path.dirname(path) or "."
    os.makedirs(parent, exist_ok=True)
    tmp_path = f"{path}.tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8", newline="") as fh:
        fh.write(content)
    os.replace(tmp_path, path)


def atomic_write_json(path: str, data: dict[str, Any]) -> None:
    atomic_write_text(path, json.dumps(data, indent=2, sort_keys=False) + "\n")


def read_text_arg(
    inline_val: str | None,
    file_val: str | None,
    label: str,
    required: bool,
    stdin_used: list[bool],
) -> str | None:
    if inline_val is not None and file_val is not None:
        raise UsageError(f"pass either --{label} or --{label}-file, not both")
    if inline_val is not None:
        text = inline_val
    elif file_val is not None:
        if file_val == "-":
            if stdin_used[0]:
                raise UsageError("stdin ('-') can only be used for one input argument")
            stdin_used[0] = True
            text = sys.stdin.read()
        else:
            try:
                with open(file_val, "r", encoding="utf-8") as fh:
                    text = fh.read()
            except OSError as exc:
                raise UsageError(f"cannot read --{label}-file {file_val}: {exc}") from exc
    else:
        if required:
            raise UsageError(f"--{label} or --{label}-file is required")
        return None

    if required and not text.strip():
        raise UsageError(f"{label} must not be empty")
    return text.rstrip("\n")


def is_subpath(child: str, parent: str) -> bool:
    child_real = os.path.realpath(child)
    parent_real = os.path.realpath(parent)
    try:
        return os.path.commonpath([child_real, parent_real]) == parent_real
    except ValueError:
        return False


def normalize_repo_paths(paths: list[str], repo_path: str) -> list[str]:
    repo_real = os.path.realpath(repo_path)
    result: list[str] = []
    seen: set[str] = set()
    for raw in paths:
        if not raw:
            continue
        item = raw
        if os.path.isabs(item) and is_subpath(item, repo_real):
            item = os.path.relpath(os.path.realpath(item), repo_real)
        item = item.replace(os.sep, "/")
        if item.startswith("./"):
            item = item[2:]
        if item and item not in seen:
            seen.add(item)
            result.append(item)
    return result


def resolve_git_base(repo_path: str, base: str) -> str:
    """Verify repo_path is a git work tree and pin base to an immutable commit or tree SHA."""
    try:
        inside = subprocess.run(
            ["git", "-C", repo_path, "rev-parse", "--is-inside-work-tree"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise UsageError(f"failed to verify git repository {repo_path}: {exc}") from exc
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        raise UsageError(f"--repo is not inside a git working tree: {repo_path}")

    for rev_expr in (f"{base}^{{commit}}", f"{base}^{{tree}}"):
        try:
            check = subprocess.run(
                ["git", "-C", repo_path, "rev-parse", "--verify", "--quiet", rev_expr],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=15,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise UsageError(f"failed to verify --base {base!r} in {repo_path}: {exc}") from exc
        if check.returncode == 0 and check.stdout.strip():
            return check.stdout.strip()

    raise UsageError(f"--base {base!r} does not resolve to a valid git commit or tree in {repo_path}")


def list_all_changed_and_untracked(repo_path: str, base: str) -> tuple[list[str], list[str], bool]:
    """Return (tracked_changed, untracked_non_ignored, untracked_ok) relative to base."""
    tracked: list[str] = []
    untracked: list[str] = []
    untracked_ok = False
    try:
        diff_proc = subprocess.run(
            ["git", "-C", repo_path, "diff", "--name-only", "-z", base],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
            check=False,
        )
        if diff_proc.returncode == 0:
            tracked = [p for p in diff_proc.stdout.split("\0") if p]
    except (OSError, subprocess.TimeoutExpired):
        pass

    try:
        untracked_proc = subprocess.run(
            ["git", "-C", repo_path, "ls-files", "-z", "--others", "--exclude-standard"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
            check=False,
        )
        if untracked_proc.returncode == 0:
            untracked = [p for p in untracked_proc.stdout.split("\0") if p]
            untracked_ok = True
    except (OSError, subprocess.TimeoutExpired):
        pass

    return tracked, untracked, untracked_ok


def split_tracked_and_untracked(
    repo_path: str, base: str, scoped_paths: list[str]
) -> tuple[list[str], list[str], bool]:
    """Return (diff_paths, untracked, git_checked) for explicitly scoped paths.

    Paths removed from the index via `git rm --cached` remain untracked on disk
    while still existing in `base`; include them in both diff_paths and untracked.
    """
    if not scoped_paths:
        return [], [], False
    try:
        proc = subprocess.run(
            ["git", "--literal-pathspecs", "-C", repo_path, "ls-files", "-z", "--others", "--", *scoped_paths],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return scoped_paths, [], False

    if proc.returncode != 0:
        return scoped_paths, [], False

    untracked_set = {entry for entry in proc.stdout.split("\0") if entry}
    in_base_set: set[str] = set()
    if untracked_set:
        try:
            base_proc = subprocess.run(
                [
                    "git",
                    "--literal-pathspecs",
                    "-C",
                    repo_path,
                    "ls-tree",
                    "-r",
                    "--name-only",
                    "-z",
                    base,
                    "--",
                    *scoped_paths,
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=15,
                check=False,
            )
            if base_proc.returncode != 0:
                return scoped_paths, [], False
            in_base_set = {entry for entry in base_proc.stdout.split("\0") if entry}
        except (OSError, subprocess.TimeoutExpired):
            return scoped_paths, [], False

    diff_paths = [p for p in scoped_paths if (p not in untracked_set) or (p in in_base_set)]
    untracked = [p for p in scoped_paths if p in untracked_set]
    return diff_paths, untracked, True


def discover_repo_rules(repo_path: str, reference_paths: list[str]) -> list[str]:
    candidates_order: list[str] = []
    seen: set[str] = set()

    def check_dir(rel_dir: str) -> None:
        abs_dir = repo_path if not rel_dir else os.path.join(repo_path, rel_dir)
        for filename in ("AGENTS.md", "CLAUDE.md"):
            full = os.path.join(abs_dir, filename)
            if os.path.isfile(full):
                rel = filename if not rel_dir else f"{rel_dir}/{filename}"
                if rel not in seen:
                    seen.add(rel)
                    candidates_order.append(rel)

    check_dir("")
    copilot_rel = ".github/copilot-instructions.md"
    if os.path.isfile(os.path.join(repo_path, ".github", "copilot-instructions.md")):
        seen.add(copilot_rel)
        candidates_order.append(copilot_rel)

    for rel_path in reference_paths:
        dirname = os.path.dirname(rel_path)
        if not dirname or dirname == ".":
            continue
        parts = [p for p in dirname.split("/") if p and p != "."]
        cur = ""
        for part in parts:
            cur = part if not cur else f"{cur}/{part}"
            check_dir(cur)

    return candidates_order


def format_git_pathspec(path: str) -> str:
    if path.startswith(":") or any(ch in path for ch in "*?["):
        return shlex.quote(f":(literal){path}")
    return shlex.quote(path)


def format_display_path(path: str) -> str:
    if path != path.strip() or "," in path:
        return shlex.quote(path)
    return path


def render_inspect_lines(repo_path: str, base: str, scoped_paths: list[str]) -> list[str]:
    lines: list[str] = []
    if scoped_paths:
        tracked, untracked, git_checked = split_tracked_and_untracked(repo_path, base, scoped_paths)
        if git_checked:
            if tracked:
                quoted = " ".join(format_git_pathspec(p) for p in tracked)
                lines.append(f"- git diff {shlex.quote(base)} -- {quoted}")
            if untracked:
                formatted = ", ".join(format_display_path(p) for p in untracked)
                lines.append(f"- read untracked scoped files directly: {formatted}")
        else:
            quoted = " ".join(format_git_pathspec(p) for p in scoped_paths)
            lines.append(f"- git diff {shlex.quote(base)} -- {quoted}")
            lines.append("- read any untracked scoped files directly")
    else:
        _, untracked, untracked_ok = list_all_changed_and_untracked(repo_path, base)
        lines.append(f"- git diff {shlex.quote(base)}")
        if untracked_ok:
            if untracked:
                formatted = ", ".join(format_display_path(p) for p in untracked)
                lines.append(f"- read untracked files directly: {formatted}")
        else:
            lines.append("- read any untracked files directly")
    return lines


def compute_diff_stat(repo_path: str, base: str, scoped_paths: list[str]) -> dict[str, Any]:
    """Return tracked shortstat plus untracked file/line counts for before/after reporting."""
    shortstat = ""
    untracked_files: list[str] = []

    if scoped_paths:
        tracked, untracked_files, git_checked = split_tracked_and_untracked(repo_path, base, scoped_paths)
        diff_cmd = (
            ["git", "--literal-pathspecs", "-C", repo_path, "diff", "--shortstat", base, "--", *tracked]
            if (git_checked and tracked)
            else (
                None
                if git_checked
                else ["git", "--literal-pathspecs", "-C", repo_path, "diff", "--shortstat", base, "--", *scoped_paths]
            )
        )
    else:
        _, untracked_files, _ = list_all_changed_and_untracked(repo_path, base)
        diff_cmd = ["git", "-C", repo_path, "diff", "--shortstat", base]

    if diff_cmd is not None:
        try:
            proc = subprocess.run(
                diff_cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=15,
                check=False,
            )
            if proc.returncode == 0:
                shortstat = proc.stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            pass

    untracked_lines = 0
    for rel in untracked_files:
        full = os.path.join(repo_path, rel)
        if not os.path.isfile(full):
            continue
        try:
            with open(full, "rb") as fh:
                raw = fh.read()
            if raw:
                untracked_lines += raw.count(b"\n") + (0 if raw.endswith(b"\n") else 1)
        except OSError:
            pass

    return {
        "tracked_shortstat": shortstat or "0 files changed",
        "untracked_files": len(untracked_files),
        "untracked_lines": untracked_lines,
    }


def build_round1_prompt(
    repo_path: str,
    base: str,
    scoped_paths: list[str],
    rules: list[str],
    intent: str,
    out_of_scope: str,
    checks: str,
) -> str:
    scope_line = ", ".join(format_display_path(p) for p in scoped_paths) if scoped_paths else "all changes from base"
    rules_line = ", ".join(rules) if rules else "none found"
    inspect_lines = render_inspect_lines(repo_path, base, scoped_paths)
    inspect_lines.append("- read surrounding callers/code and the listed repo rules")
    inspect_block = "\n".join(inspect_lines)

    return (
        "Review only. Do not edit, commit, push, comment on PRs, or start subagents.\n"
        f"Repo: {repo_path}\n"
        f"Base: {base}\n"
        f"Scope: {scope_line}\n"
        f"Repo rules: {rules_line}\n"
        "Intent:\n"
        f"{intent}\n\n"
        "Out of scope:\n"
        f"{out_of_scope}\n\n"
        "Checks:\n"
        f"{checks}\n\n"
        "Inspect:\n"
        f"{inspect_block}\n\n"
        "Check the change in one pass:\n"
        "1. Bugs, broken callers, regressions, security/auth/data-loss/concurrency defects, and edge cases within intent.\n"
        "2. Mismatch with intent or out-of-scope boundaries; flag missing proof where checks do not cover the changed behavior.\n"
        "3. Breaches of documented repo rules; skip style unless it hides a bug.\n"
        "4. Smallest-change discipline: flag dead code, tests, or guards the intent does not need.\n\n"
        "Severity:\n"
        "- blocker = intended case wrong, security/auth/data-loss/concurrency defect, or mandatory repo rule breach.\n"
        "- should = real bug callers will hit within intent, or missing proof for intended behavior.\n"
        "- nit = other paths, rare edge case, small perf, extra compat, style, or out-of-scope suggestion.\n\n"
        "Reply concisely (findings only; omit praise):\n"
        "VERDICT: APPROVE or CHANGES (use APPROVE only when zero blocker or should findings exist)\n"
        "S1 [blocker|should|nit] <file>:<line> <claim>. Fix: <smallest suggestion>\n"
    )


def build_round_n_prompt(
    round_num: int,
    repo_path: str,
    base: str,
    scoped_paths: list[str],
    changed_paths: list[str],
    ledger: str,
    checks: str,
) -> str:
    changed_line = (
        ", ".join(format_display_path(p) for p in changed_paths)
        if changed_paths
        else "none (no files modified since previous round)"
    )
    inspect_block = "\n".join(render_inspect_lines(repo_path, base, scoped_paths))
    return (
        f"Round {round_num} review update.\n\n"
        "Ledger:\n"
        f"{ledger}\n\n"
        f"Paths modified or added since previous round: {changed_line}\n"
        "Inspect:\n"
        f"{inspect_block}\n\n"
        "Updated checks:\n"
        f"{checks}\n\n"
        "Review open IDs and changed code only. Mark each open ID one of:\n"
        "- `resolved` (fixed or rebutted)\n"
        "- `deferred: <reason>` (accepted decline, nit, or manual/out-of-scope follow-up that does not block approval)\n"
        "- `still open: <reason>` (unresolved `blocker` or `should` that still blocks approval)\n\n"
        "Report any new defect introduced by the fixes, and end with `VERDICT: APPROVE` "
        "(only when zero `blocker`, `should`, or `still open` items remain) or `VERDICT: CHANGES` "
        "(whenever any `blocker`, `should`, or `still open` item remains).\n"
    )


def build_validation_retry_note(parse_err: str) -> str:
    return (
        f"Format correction required (previous reply failed validation: {parse_err}):\n"
        "- Use `resolved` for fixed or rebutted IDs.\n"
        "- Use `deferred: <reason>` for accepted declines, nits, or manual/out-of-scope follow-ups that do not block approval.\n"
        "- Use `still open: <reason>` only for unresolved `blocker` or `should` items that still block approval.\n"
        "- End with `VERDICT: APPROVE` only when zero `blocker`, `should`, or `still open` items remain; "
        "otherwise end with `VERDICT: CHANGES`.\n"
    )


def build_resume_correction_prompt(parse_err: str) -> str:
    return (
        f"Your previous reply failed validation: {parse_err}.\n"
        "Re-emit only the corrected status lines, any new findings, and the final VERDICT line for this round "
        "(do not re-run checks or expand scope):\n"
        "- Use `resolved` for fixed or rebutted IDs.\n"
        "- Use `deferred: <reason>` for accepted declines, nits, or manual/out-of-scope follow-ups that do not block approval.\n"
        "- Use `still open: <reason>` only for unresolved `blocker` or `should` items that still block approval.\n"
        "- End with `VERDICT: APPROVE` only when zero `blocker`, `should`, or `still open` items remain; "
        "otherwise end with `VERDICT: CHANGES`.\n"
    )


def unwrap_error_payload(raw: Any, outer: dict[str, Any] | None = None) -> str | None:
    parts: list[str] = []
    codes: list[str] = []

    def collect(obj: Any) -> None:
        if isinstance(obj, str):
            cleaned = obj.strip()
            if not cleaned:
                return
            if cleaned.startswith("{"):
                try:
                    parsed = json.loads(cleaned)
                except json.JSONDecodeError:
                    parts.append(cleaned)
                    return
                if isinstance(parsed, dict):
                    collect(parsed)
                    return
            parts.append(cleaned)
        elif isinstance(obj, dict):
            code = obj.get("code")
            if isinstance(code, str) and code.strip():
                codes.append(code.strip())
            status = obj.get("status")
            if isinstance(status, int) and not isinstance(status, bool):
                codes.append(str(status))
            err = obj.get("error")
            if err is not None:
                collect(err)
            msg = obj.get("message")
            if isinstance(msg, str) and msg.strip():
                collect(msg)

    if outer is not None:
        code = outer.get("code")
        if isinstance(code, str) and code.strip():
            codes.append(code.strip())
        status = outer.get("status")
        if isinstance(status, int) and not isinstance(status, bool):
            codes.append(str(status))
        outer_msg = outer.get("message")
        if isinstance(outer_msg, str) and outer_msg.strip() and outer_msg is not raw:
            collect(outer_msg)
    collect(raw)

    if not parts and not codes:
        return None
    msg_text = "; ".join(dict.fromkeys(parts))
    extra = list(dict.fromkeys(codes))
    if msg_text and extra:
        return f"{msg_text} ({', '.join(extra)})"
    return msg_text or ", ".join(extra)


def is_numeric_usage_value(value: Any) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def is_monotonic_usage_ge(curr: dict[str, Any], prev: dict[str, Any]) -> bool:
    shared = [
        k
        for k in curr
        if k in prev and is_numeric_usage_value(curr[k]) and is_numeric_usage_value(prev[k])
    ]
    return bool(shared) and all(curr[k] >= prev[k] for k in shared)


def parse_codex_jsonl(jsonl_path: str) -> tuple[str | None, dict[str, Any] | None, list[str]]:
    """Extract (thread_id, usage, error_messages) from codex exec --json output."""
    thread_id: str | None = None
    usage_events: list[dict[str, Any]] = []
    errors: list[str] = []

    if not os.path.isfile(jsonl_path):
        return None, None, []

    with open(jsonl_path, "r", encoding="utf-8", errors="replace") as fh:
        for raw_line in fh:
            line = raw_line.strip()
            if not line or not line.startswith("{"):
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(event, dict):
                continue

            etype = event.get("type")
            if etype == "thread.started":
                tid = event.get("thread_id")
                if isinstance(tid, str) and tid.strip():
                    thread_id = tid.strip()
            elif etype == "turn.completed":
                usage = event.get("usage")
                if isinstance(usage, dict) and usage:
                    usage_events.append(usage)
            elif etype == "error":
                unwrapped = unwrap_error_payload(event.get("message"), outer=event)
                if unwrapped:
                    errors.append(unwrapped)
            elif etype == "turn.failed":
                unwrapped = unwrap_error_payload(event.get("error"), outer=event)
                if unwrapped:
                    errors.append(unwrapped)

    usage_merged: dict[str, Any] | None = None
    if len(usage_events) == 1:
        usage_merged = usage_events[0]
    elif len(usage_events) > 1:
        if all(
            is_monotonic_usage_ge(usage_events[i], usage_events[i - 1])
            for i in range(1, len(usage_events))
        ):
            usage_merged = usage_events[-1]
        else:
            merged: dict[str, Any] = {}
            for ev in usage_events:
                for k, v in ev.items():
                    if is_numeric_usage_value(v):
                        merged[k] = merged.get(k, 0) + v
                    else:
                        merged[k] = v
            usage_merged = merged

    return thread_id, usage_merged, errors


def parse_review_response(text: str) -> tuple[str | None, dict[str, int], bool, str | None]:
    """Return (verdict, findings_summary, nit_only, error_reason).

    Ignores fenced code blocks when scanning for VERDICT lines.
    """
    stripped = text.strip()
    empty_counts = {"blocker": 0, "should": 0, "nit": 0, "still_open": 0, "deferred": 0}
    if not stripped:
        return None, empty_counts, False, "empty review output"

    verdicts: set[str] = set()
    counts = dict(empty_counts)
    in_fence = False
    unclassified_lines = 0

    for line in stripped.splitlines():
        s = line.strip()
        if s.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence or not s:
            continue

        vm = VERDICT_LINE_RE.match(s)
        if vm:
            verdicts.add(vm.group(1).upper())
            continue

        if RESOLVED_LINE_RE.match(s):
            continue

        dm = DEFERRED_LINE_RE.match(s)
        if dm:
            counts["deferred"] += max(1, len(FINDING_ID_RE.findall(dm.group("head"))))
            continue

        fm = FINDING_LINE_RE.match(s)
        if fm:
            sev = fm.group(1).lower()
            counts[sev] += 1
            sm = STILL_OPEN_LINE_RE.match(s)
            if sm and sev != "nit":
                counts["still_open"] += max(1, len(FINDING_ID_RE.findall(sm.group("head"))))
            continue

        sm = STILL_OPEN_LINE_RE.match(s)
        if sm:
            id_count = max(1, len(FINDING_ID_RE.findall(sm.group("head"))))
            if NIT_TAG_RE.search(sm.group("head")):
                counts["nit"] += id_count
            else:
                counts["still_open"] += id_count
            continue

        unclassified_lines += 1

    if not verdicts:
        return None, counts, False, "missing VERDICT: line"
    if len(verdicts) > 1:
        return None, counts, False, "ambiguous output containing both APPROVE and CHANGES verdicts"

    verdict = next(iter(verdicts))
    if verdict == "APPROVE" and (counts["blocker"] > 0 or counts["should"] > 0 or counts["still_open"] > 0):
        return None, counts, False, CONTRADICTORY_APPROVE_ERR
    nit_only = (
        verdict == "CHANGES"
        and counts["blocker"] == 0
        and counts["should"] == 0
        and counts["still_open"] == 0
        and counts["nit"] > 0
        and unclassified_lines == 0
    )
    return verdict, counts, nit_only, None


def classify_unavailable_error(stderr_text: str, jsonl_errors: list[str]) -> str | None:
    lines = [
        line.strip()
        for part in [stderr_text, *jsonl_errors]
        if part
        for line in part.splitlines()
        if line.strip()
    ]
    if not lines:
        return None
    combined = "\n".join(lines)
    for label, pattern in UNAVAILABLE_PATTERNS:
        if pattern.search(combined):
            matched_line = next((line for line in lines if pattern.search(line)), lines[0])
            if len(matched_line) > 200:
                matched_line = matched_line[:197] + "..."
            return f"{label}: {matched_line}"
    return None


def summarize_error(
    returncode: int | None, stderr_text: str, jsonl_errors: list[str], detail: str | None
) -> str:
    if detail:
        return detail
    for source in (*jsonl_errors, *(stderr_text.splitlines() if stderr_text else [])):
        cleaned = source.strip()
        if cleaned:
            if len(cleaned) > 200:
                cleaned = cleaned[:197] + "..."
            return f"exit {returncode}: {cleaned}" if returncode is not None else cleaned
    return f"codex exited with code {returncode}"


def archive_attempt_files(paths: dict[str, str], round_num: int, attempt_idx: int) -> None:
    for path in paths.values():
        if not path or not os.path.exists(path):
            continue
        directory, name = os.path.split(path)
        prefix = f"r{round_num}."
        if name.startswith(prefix):
            archived = os.path.join(directory, f"r{round_num}-attempt{attempt_idx}.{name[len(prefix):]}")
            os.replace(path, archived)


def run_codex_invocation(
    cfg: dict[str, Any],
    repo_path: str,
    session_dir: str,
    round_num: int,
    prompt_path: str,
    prompt_text: str,
    resume_thread_id: str | None,
) -> dict[str, Any]:
    codex_bin = cfg["codex_bin"]
    model = cfg["model"]
    effort = cfg["effort"]
    timeout_seconds = cfg["timeout_seconds"]

    response_path = os.path.join(session_dir, f"r{round_num}.md")
    stderr_path = os.path.join(session_dir, f"r{round_num}.stderr.log")
    log_path = os.path.join(session_dir, f"r{round_num}.jsonl")

    for stale in (response_path, stderr_path, log_path):
        if os.path.exists(stale):
            os.remove(stale)

    artifacts = {
        "prompt": prompt_path,
        "response": response_path,
        "log": log_path,
        "stderr": stderr_path,
    }

    if resume_thread_id:
        cmd = [
            codex_bin,
            "exec",
            "resume",
            resume_thread_id,
            "-m",
            model,
            "-c",
            f"model_reasoning_effort={effort}",
            "-c",
            'sandbox_mode="read-only"',
            "--json",
            "-o",
            response_path,
            prompt_text,
        ]
    else:
        cmd = [
            codex_bin,
            "exec",
            "-C",
            repo_path,
            "-m",
            model,
            "-c",
            f"model_reasoning_effort={effort}",
            "-s",
            "read-only",
            "--json",
            "-o",
            response_path,
            prompt_text,
        ]

    proc: subprocess.CompletedProcess[Any] | None = None
    timed_out = False
    try:
        with open(log_path, "w", encoding="utf-8") as log_fh, open(stderr_path, "w", encoding="utf-8") as err_fh:
            proc = subprocess.run(
                cmd,
                cwd=repo_path,
                stdin=subprocess.DEVNULL,
                stdout=log_fh,
                stderr=err_fh,
                timeout=timeout_seconds,
                check=False,
            )
    except FileNotFoundError:
        return {
            "ok": False,
            "unavailable": True,
            "reason": f"{codex_bin} CLI not found in PATH",
            "artifacts": artifacts,
            "thread_id": None,
            "usage": None,
        }
    except PermissionError as exc:
        return {
            "ok": False,
            "unavailable": True,
            "reason": f"cannot execute {codex_bin}: {exc}",
            "artifacts": artifacts,
            "thread_id": None,
            "usage": None,
        }
    except subprocess.TimeoutExpired:
        timed_out = True

    stderr_text = ""
    if os.path.isfile(stderr_path):
        with open(stderr_path, "r", encoding="utf-8", errors="replace") as fh:
            stderr_text = fh.read()

    thread_id, usage, jsonl_errors = parse_codex_jsonl(log_path)

    if timed_out:
        unavail = classify_unavailable_error(stderr_text, jsonl_errors)
        return {
            "ok": False,
            "unavailable": unavail is not None,
            "reason": unavail or f"Sol review timed out after {timeout_seconds}s",
            "artifacts": artifacts,
            "thread_id": thread_id,
            "usage": usage,
        }

    assert proc is not None
    if proc.returncode != 0:
        unavail = classify_unavailable_error(stderr_text, jsonl_errors)
        return {
            "ok": False,
            "unavailable": unavail is not None,
            "reason": unavail or summarize_error(proc.returncode, stderr_text, jsonl_errors, None),
            "artifacts": artifacts,
            "thread_id": thread_id,
            "usage": usage,
        }

    response_text = ""
    if os.path.isfile(response_path):
        with open(response_path, "r", encoding="utf-8", errors="replace") as fh:
            response_text = fh.read()

    verdict, findings_summary, nit_only, parse_err = parse_review_response(response_text)
    if parse_err is not None or verdict is None:
        unavail = classify_unavailable_error(stderr_text, jsonl_errors)
        is_format_error = unavail is None and bool(response_text.strip())
        is_contradictory = is_format_error and parse_err == CONTRADICTORY_APPROVE_ERR
        return {
            "ok": False,
            "unavailable": unavail is not None,
            "format_error": is_format_error,
            "parse_error": parse_err,
            "contradictory_approve": is_contradictory,
            "findings_summary": findings_summary,
            "findings": response_text.rstrip("\n"),
            "reason": unavail or summarize_error(proc.returncode, stderr_text, jsonl_errors, parse_err),
            "artifacts": artifacts,
            "thread_id": thread_id,
            "usage": usage,
        }

    return {
        "ok": True,
        "unavailable": False,
        "format_error": False,
        "contradictory_approve": False,
        "reason": None,
        "verdict": verdict,
        "findings_summary": findings_summary,
        "nit_only": nit_only,
        "findings": response_text.rstrip("\n"),
        "artifacts": artifacts,
        "thread_id": thread_id,
        "usage": usage,
    }


def coerce_contradictory_approve(result: dict[str, Any]) -> dict[str, Any]:
    """Downgrade a persistent contradictory APPROVE + blocking items into a conservative CHANGES result."""
    if result.get("ok") or not result.get("contradictory_approve"):
        return result
    return {
        "ok": True,
        "unavailable": False,
        "format_error": False,
        "contradictory_approve": False,
        "reason": None,
        "verdict": "CHANGES",
        "verdict_coerced": True,
        "verdict_warning": CONTRADICTORY_COERCE_WARNING,
        "findings_summary": result["findings_summary"],
        "nit_only": False,
        "findings": result["findings"],
        "artifacts": result["artifacts"],
        "thread_id": result["thread_id"],
        "usage": result["usage"],
    }


def record_attempt_usage(
    attempt_usages: list[dict[str, Any] | None],
    inv_result: dict[str, Any],
    thread_totals: dict[str, dict[str, Any]],
    *,
    resumed_thread_id: str | None = None,
) -> None:
    raw_usage = inv_result["usage"]
    if not (isinstance(raw_usage, dict) and raw_usage):
        if not inv_result["unavailable"]:
            attempt_usages.append(None)
        return

    active_thread = resumed_thread_id or inv_result.get("thread_id")
    if resumed_thread_id and active_thread and active_thread in thread_totals:
        prev = thread_totals[active_thread]
        if is_monotonic_usage_ge(raw_usage, prev):
            delta: dict[str, Any] = {}
            new_total = dict(prev)
            for k, v in raw_usage.items():
                if is_numeric_usage_value(v):
                    prev_val = prev.get(k, 0) if is_numeric_usage_value(prev.get(k)) else 0
                    delta[k] = v - prev_val
                    new_total[k] = v
                else:
                    delta[k] = v
                    new_total[k] = v
            thread_totals[active_thread] = new_total
            attempt_usages.append(delta)
            return

        new_total = dict(prev)
        for k, v in raw_usage.items():
            if is_numeric_usage_value(v):
                prev_val = prev.get(k, 0) if is_numeric_usage_value(prev.get(k)) else 0
                new_total[k] = prev_val + v
            else:
                new_total[k] = v
        thread_totals[active_thread] = new_total
        attempt_usages.append(dict(raw_usage))
        return

    if active_thread:
        thread_totals[active_thread] = dict(raw_usage)
    attempt_usages.append(dict(raw_usage))


def sum_usage_entries(usages: list[dict[str, Any] | None]) -> tuple[dict[str, Any] | None, bool, int]:
    """Return (usage_total, all_exposed, exposed_count) across attempt usage dicts."""
    if not usages:
        return None, False, 0

    total: dict[str, Any] = {}
    exposed = 0
    for usage in usages:
        if isinstance(usage, dict) and usage:
            exposed += 1
            for k, v in usage.items():
                if is_numeric_usage_value(v):
                    total[k] = total.get(k, 0) + v
    if exposed == 0:
        return None, False, 0
    return total, exposed == len(usages), exposed


def aggregate_usage(
    rounds: list[dict[str, Any]],
    failed_attempt_usages: list[dict[str, Any] | None] | None = None,
) -> tuple[dict[str, Any] | None, bool, int]:
    """Return (usage_total, usage_complete, usage_exposed_rounds)."""
    attempt_usages: list[dict[str, Any] | None] = []
    exposed_rounds = 0
    for entry in rounds:
        per_attempt = entry.get("attempt_usages")
        if isinstance(per_attempt, list) and per_attempt:
            attempt_usages.extend(per_attempt)
            if any(isinstance(u, dict) and u for u in per_attempt):
                exposed_rounds += 1
        else:
            usage = entry.get("usage")
            attempt_usages.append(usage)
            if isinstance(usage, dict) and usage:
                exposed_rounds += 1

    if failed_attempt_usages:
        attempt_usages.extend(failed_attempt_usages)

    total, all_exposed, _ = sum_usage_entries(attempt_usages)
    return total, all_exposed, exposed_rounds


@contextlib.contextmanager
def session_lock(session_dir: str):
    state_path = os.path.join(session_dir, STATE_FILE)
    if not os.path.isfile(state_path):
        raise UsageError(f"session state not found: {state_path}")
    lock_path = os.path.join(session_dir, ".review.lock")
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise UsageError(f"another review command is already running on session {session_dir}") from exc
        try:
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def load_session_state(session_dir: str) -> dict[str, Any]:
    state_path = os.path.join(session_dir, STATE_FILE)
    if not os.path.isfile(state_path):
        raise UsageError(f"session state not found: {state_path}")
    try:
        with open(state_path, "r", encoding="utf-8") as fh:
            state = json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        raise UsageError(f"cannot read session state {state_path}: {exc}") from exc
    if not isinstance(state, dict) or state.get("schema") != SCHEMA_VERSION:
        raise UsageError(f"invalid or unsupported session state in {state_path}")
    return state


def save_session_state(session_dir: str, state: dict[str, Any]) -> None:
    state["updated_at"] = utc_now()
    atomic_write_json(os.path.join(session_dir, STATE_FILE), state)


def emit_json(payload: dict[str, Any]) -> int:
    sys.stdout.write(json.dumps(payload, indent=2) + "\n")
    return 0


def build_fresh_followup_prompt(
    state: dict[str, Any],
    round_n_prompt: str,
    after_resume_failure: bool,
) -> str:
    with open(state["round1_prompt_path"], "r", encoding="utf-8", newline="") as fh:
        r1_prompt = fh.read()
    r1_sep = "\n" if r1_prompt.endswith("\n") else "\n\n"

    prior_sections: list[str] = []
    for entry in state.get("rounds", []):
        resp_path = entry.get("artifacts", {}).get("response")
        if resp_path and os.path.isfile(resp_path):
            with open(resp_path, "r", encoding="utf-8", errors="replace") as fh:
                resp_text = fh.read().strip()
            if resp_text:
                prior_sections.append(f"Round {entry['round']} findings:\n{resp_text}")

    prior_block = ""
    if prior_sections:
        prior_block = "---\nPrior round findings:\n\n" + "\n\n".join(prior_sections) + "\n\n"

    header = (
        "Follow-up round (fresh thread after resume failed):"
        if after_resume_failure
        else "Follow-up round:"
    )
    return f"{r1_prompt}{r1_sep}{prior_block}---\n{header}\n\n{round_n_prompt}"


def cmd_start(args: argparse.Namespace) -> int:
    cfg = resolve_config(args)
    repo_path = os.path.abspath(args.repo or os.getcwd())
    if not os.path.isdir(repo_path):
        raise UsageError(f"--repo is not an existing directory: {repo_path}")

    base = args.base.strip()
    if not base:
        raise UsageError("--base must not be empty")
    base = resolve_git_base(repo_path, base)

    stdin_used = [False]
    intent = read_text_arg(args.intent, args.intent_file, "intent", required=True, stdin_used=stdin_used)
    out_of_scope = read_text_arg(
        args.out_of_scope, args.out_of_scope_file, "out-of-scope", required=False, stdin_used=stdin_used
    )
    checks = read_text_arg(args.checks, args.checks_file, "checks", required=True, stdin_used=stdin_used)
    assert intent is not None and checks is not None
    if not out_of_scope or not out_of_scope.strip():
        out_of_scope = "none specified"

    scoped_paths = normalize_repo_paths(args.paths or [], repo_path)
    if scoped_paths:
        rule_search_paths = scoped_paths
    else:
        tracked_changed, untracked_changed, _ = list_all_changed_and_untracked(repo_path, base)
        rule_search_paths = [*tracked_changed, *untracked_changed]

    auto_rules = [] if args.no_auto_rules else discover_repo_rules(repo_path, rule_search_paths)
    extra_rules = normalize_repo_paths(args.rules, repo_path) if args.rules else []
    rules = list(dict.fromkeys([*auto_rules, *extra_rules]))

    if args.session_dir:
        session_dir = os.path.abspath(args.session_dir)
        if is_subpath(session_dir, repo_path):
            raise UsageError(f"--session-dir must be outside the repository: {session_dir}")
        if os.path.exists(session_dir):
            if not os.path.isdir(session_dir):
                raise UsageError(f"--session-dir exists and is not a directory: {session_dir}")
            if os.listdir(session_dir):
                raise UsageError(f"--session-dir must be empty: {session_dir}")
        else:
            os.makedirs(session_dir, exist_ok=True)
    else:
        session_dir = tempfile.mkdtemp(prefix="sol-loop-")

    initial_diff_stat = compute_diff_stat(repo_path, base, scoped_paths)
    prompt_text = build_round1_prompt(repo_path, base, scoped_paths, rules, intent, out_of_scope, checks)
    prompt_path = os.path.join(session_dir, "r1-prompt.txt")
    atomic_write_text(prompt_path, prompt_text)

    state: dict[str, Any] = {
        "schema": SCHEMA_VERSION,
        "created_at": utc_now(),
        "updated_at": utc_now(),
        "repo": repo_path,
        "base": base,
        "scoped_paths": scoped_paths,
        "rules": rules,
        "round1_prompt_path": prompt_path,
        "config": cfg,
        "max_rounds": cfg["max_rounds"],
        "budget_extensions": [],
        "initial_diff_stat": initial_diff_stat,
        "thread_id": None,
        "thread_usage_totals": {},
        "rounds_completed": 0,
        "status": "in_progress",
        "blocker_reason": None,
        "failed_attempt_usages": [],
        "rounds": [],
    }
    save_session_state(session_dir, state)

    result = run_codex_invocation(
        cfg=cfg,
        repo_path=repo_path,
        session_dir=session_dir,
        round_num=1,
        prompt_path=prompt_path,
        prompt_text=prompt_text,
        resume_thread_id=None,
    )
    attempt_usages: list[dict[str, Any] | None] = []
    thread_totals = state["thread_usage_totals"]
    record_attempt_usage(attempt_usages, result, thread_totals)

    retried = False
    if not result["ok"] and not result["unavailable"]:
        retried = True
        first_reason = result["reason"]
        retry_prompt_path = prompt_path
        retry_prompt_text = prompt_text
        if result.get("format_error") and result.get("parse_error"):
            retry_prompt_text = f"{prompt_text.rstrip()}\n\n{build_validation_retry_note(result['parse_error'])}"
            retry_prompt_path = os.path.join(session_dir, "r1-retry-prompt.txt")
            atomic_write_text(retry_prompt_path, retry_prompt_text)
        archive_attempt_files(
            {k: v for k, v in result["artifacts"].items() if k != "prompt"},
            round_num=1,
            attempt_idx=1,
        )
        result = run_codex_invocation(
            cfg=cfg,
            repo_path=repo_path,
            session_dir=session_dir,
            round_num=1,
            prompt_path=retry_prompt_path,
            prompt_text=retry_prompt_text,
            resume_thread_id=None,
        )
        record_attempt_usage(attempt_usages, result, thread_totals)
        result = coerce_contradictory_approve(result)
        if not result["ok"]:
            result["reason"] = f"attempt 1: {first_reason}; retry: {result['reason']}"

    round_usage, _, _ = sum_usage_entries(attempt_usages)

    if not result["ok"]:
        state["status"] = "blocked"
        state["blocker_reason"] = result["reason"]
        if attempt_usages:
            state["failed_attempt_usages"].extend(attempt_usages)
        save_session_state(session_dir, state)
        return emit_json(
            {
                "status": "blocked",
                "session": session_dir,
                "round": 1,
                "max_rounds": state["max_rounds"],
                "model": cfg["model"],
                "effort": cfg["effort"],
                "unavailable": result["unavailable"],
                "retried": retried,
                "usage": round_usage,
                "blocker_reason": result["reason"],
                "next_action": BLOCKED_HINT,
                "artifacts": result["artifacts"],
            }
        )

    state["thread_id"] = result["thread_id"]
    state["rounds_completed"] = 1
    state["status"] = "ok"
    state["blocker_reason"] = None
    round_record: dict[str, Any] = {
        "round": 1,
        "mode": "fresh",
        "retried": retried,
        "verdict": result["verdict"],
        "findings_summary": result["findings_summary"],
        "nit_only": result["nit_only"],
        "usage": round_usage,
        "attempt_usages": attempt_usages,
        "thread_id": result["thread_id"],
        "artifacts": result["artifacts"],
    }
    if result.get("verdict_coerced"):
        round_record["verdict_coerced"] = True
        round_record["verdict_warning"] = result["verdict_warning"]
    state["rounds"].append(round_record)
    save_session_state(session_dir, state)

    payload: dict[str, Any] = {
        "status": "ok",
        "session": session_dir,
        "round": 1,
        "max_rounds": state["max_rounds"],
        "extended_max_rounds": cfg["extended_max_rounds"],
        "model": cfg["model"],
        "effort": cfg["effort"],
        "mode": "fresh",
        "retried": retried,
        "verdict": result["verdict"],
        "findings_summary": result["findings_summary"],
        "nit_only": result["nit_only"],
        "usage": round_usage,
        "diff_stat": initial_diff_stat,
        "artifacts": result["artifacts"],
        "findings": result["findings"],
    }
    if result.get("verdict_coerced"):
        payload["verdict_coerced"] = True
        payload["verdict_warning"] = result["verdict_warning"]
    return emit_json(payload)


def cmd_reply(args: argparse.Namespace) -> int:
    session_dir = os.path.abspath(args.session)
    with session_lock(session_dir):
        return _run_reply_locked(session_dir, args)


def _run_reply_locked(session_dir: str, args: argparse.Namespace) -> int:
    state = load_session_state(session_dir)

    if state["rounds_completed"] < 1:
        raise UsageError("cannot reply before Round 1 has completed in this session")
    if state.get("status") == "blocked":
        raise UsageError("session already ended in blocked state; report the blocker instead of replying")

    cfg = copy.deepcopy(state["config"])
    if args.timeout is not None:
        cfg["timeout_seconds"] = parse_positive_int(args.timeout, "timeout")

    if args.max_rounds is not None:
        new_max = parse_positive_int(args.max_rounds, "max_rounds")
        if new_max < state["max_rounds"]:
            raise UsageError(
                f"--max-rounds ({new_max}) cannot be lower than current session max_rounds ({state['max_rounds']})"
            )
        if new_max > state["max_rounds"]:
            ext_limit = max(cfg.get("extended_max_rounds", DEFAULT_CONFIG["extended_max_rounds"]), state["max_rounds"])
            if new_max > ext_limit:
                raise UsageError(
                    f"--max-rounds ({new_max}) exceeds configured extended_max_rounds ({ext_limit})"
                )
            reason = (args.extend_reason or "").strip()
            if not reason:
                raise UsageError("--extend-reason is required when raising --max-rounds")
            state["budget_extensions"].append(
                {
                    "from": state["max_rounds"],
                    "to": new_max,
                    "reason": reason,
                    "at": utc_now(),
                }
            )
            state["max_rounds"] = new_max

    if state["rounds_completed"] >= state["max_rounds"]:
        state["status"] = "budget_exhausted"
        save_session_state(session_dir, state)
        return emit_json(
            {
                "status": "budget_exhausted",
                "session": session_dir,
                "round": state["rounds_completed"],
                "max_rounds": state["max_rounds"],
                "extended_max_rounds": cfg.get("extended_max_rounds", DEFAULT_CONFIG["extended_max_rounds"]),
                "model": cfg["model"],
                "effort": cfg["effort"],
                "next_action": "Stop and present both sides to the user; budget end is not approval.",
            }
        )

    stdin_used = [False]
    ledger = read_text_arg(args.ledger, args.ledger_file, "ledger", required=True, stdin_used=stdin_used)
    checks = read_text_arg(args.checks, args.checks_file, "checks", required=False, stdin_used=stdin_used)
    assert ledger is not None
    if checks is None or not checks.strip():
        checks = "unchanged from previous round"

    repo_path = state["repo"]
    base = state["base"]
    changed_paths = normalize_repo_paths(args.changed_paths or [], repo_path)

    # When reviewing scoped paths, append any newly modified/added paths so fixes and tests stay visible.
    scoped_paths = list(state.get("scoped_paths", []))
    if scoped_paths and changed_paths:
        scoped_set = set(scoped_paths)
        for path in changed_paths:
            if path not in scoped_set:
                scoped_set.add(path)
                scoped_paths.append(path)
        state["scoped_paths"] = scoped_paths

    next_round = state["rounds_completed"] + 1
    prompt_text = build_round_n_prompt(
        round_num=next_round,
        repo_path=repo_path,
        base=base,
        scoped_paths=scoped_paths,
        changed_paths=changed_paths,
        ledger=ledger,
        checks=checks,
    )
    prompt_path = os.path.join(session_dir, f"r{next_round}-prompt.txt")
    atomic_write_text(prompt_path, prompt_text)

    thread_id = state.get("thread_id")
    thread_totals = state.setdefault("thread_usage_totals", {})
    force_fresh = bool(args.fresh) or cfg.get("thread_mode", "resume") == "fresh"
    can_resume = False if force_fresh else bool(thread_id)

    mode = "resume" if can_resume else "fresh"
    retried = False
    attempt_usages: list[dict[str, Any] | None] = []

    if can_resume:
        result = run_codex_invocation(
            cfg=cfg,
            repo_path=repo_path,
            session_dir=session_dir,
            round_num=next_round,
            prompt_path=prompt_path,
            prompt_text=prompt_text,
            resume_thread_id=thread_id,
        )
        record_attempt_usage(attempt_usages, result, thread_totals, resumed_thread_id=thread_id)
        if not result["ok"] and not result["unavailable"]:
            retried = True
            resume_reason = result["reason"]
            archive_attempt_files(
                {k: v for k, v in result["artifacts"].items() if k != "prompt"},
                round_num=next_round,
                attempt_idx=1,
            )
            if result.get("format_error") and result.get("parse_error"):
                # Thread is live; send a short format correction on the same resumed thread.
                active_tid = result["thread_id"] or thread_id
                correction_prompt = build_resume_correction_prompt(result["parse_error"])
                correction_path = os.path.join(session_dir, f"r{next_round}-correction-prompt.txt")
                atomic_write_text(correction_path, correction_prompt)
                result = run_codex_invocation(
                    cfg=cfg,
                    repo_path=repo_path,
                    session_dir=session_dir,
                    round_num=next_round,
                    prompt_path=correction_path,
                    prompt_text=correction_prompt,
                    resume_thread_id=active_tid,
                )
                record_attempt_usage(attempt_usages, result, thread_totals, resumed_thread_id=active_tid)
                result = coerce_contradictory_approve(result)
                if not result["ok"]:
                    result["reason"] = f"attempt 1: {resume_reason}; format retry: {result['reason']}"
            else:
                mode = "resume-fallback"
                combined_prompt = build_fresh_followup_prompt(state, prompt_text, after_resume_failure=True)
                combined_path = os.path.join(session_dir, f"r{next_round}-fresh-prompt.txt")
                atomic_write_text(combined_path, combined_prompt)

                result = run_codex_invocation(
                    cfg=cfg,
                    repo_path=repo_path,
                    session_dir=session_dir,
                    round_num=next_round,
                    prompt_path=combined_path,
                    prompt_text=combined_prompt,
                    resume_thread_id=None,
                )
                record_attempt_usage(attempt_usages, result, thread_totals)
                result = coerce_contradictory_approve(result)
                if not result["ok"]:
                    result["reason"] = f"resume failed ({resume_reason}); fresh thread failed ({result['reason']})"
    else:
        combined_prompt = build_fresh_followup_prompt(state, prompt_text, after_resume_failure=False)
        combined_path = os.path.join(session_dir, f"r{next_round}-fresh-prompt.txt")
        atomic_write_text(combined_path, combined_prompt)
        result = run_codex_invocation(
            cfg=cfg,
            repo_path=repo_path,
            session_dir=session_dir,
            round_num=next_round,
            prompt_path=combined_path,
            prompt_text=combined_prompt,
            resume_thread_id=None,
        )
        record_attempt_usage(attempt_usages, result, thread_totals)
        if not result["ok"] and not result["unavailable"]:
            retried = True
            first_reason = result["reason"]
            retry_path = combined_path
            retry_prompt = combined_prompt
            if result.get("format_error") and result.get("parse_error"):
                retry_prompt = f"{combined_prompt.rstrip()}\n\n{build_validation_retry_note(result['parse_error'])}"
                retry_path = os.path.join(session_dir, f"r{next_round}-fresh-retry-prompt.txt")
                atomic_write_text(retry_path, retry_prompt)
            archive_attempt_files(
                {k: v for k, v in result["artifacts"].items() if k != "prompt"},
                round_num=next_round,
                attempt_idx=1,
            )
            result = run_codex_invocation(
                cfg=cfg,
                repo_path=repo_path,
                session_dir=session_dir,
                round_num=next_round,
                prompt_path=retry_path,
                prompt_text=retry_prompt,
                resume_thread_id=None,
            )
            record_attempt_usage(attempt_usages, result, thread_totals)
            result = coerce_contradictory_approve(result)
            if not result["ok"]:
                result["reason"] = f"attempt 1: {first_reason}; retry: {result['reason']}"

    round_usage, _, _ = sum_usage_entries(attempt_usages)

    if not result["ok"]:
        state["status"] = "blocked"
        state["blocker_reason"] = result["reason"]
        if attempt_usages:
            state.setdefault("failed_attempt_usages", []).extend(attempt_usages)
        save_session_state(session_dir, state)
        return emit_json(
            {
                "status": "blocked",
                "session": session_dir,
                "round": next_round,
                "max_rounds": state["max_rounds"],
                "model": cfg["model"],
                "effort": cfg["effort"],
                "mode": mode,
                "unavailable": result["unavailable"],
                "retried": retried,
                "usage": round_usage,
                "blocker_reason": result["reason"],
                "next_action": BLOCKED_HINT,
                "artifacts": result["artifacts"],
            }
        )

    if mode == "resume":
        if result["thread_id"]:
            state["thread_id"] = result["thread_id"]
    else:
        state["thread_id"] = result["thread_id"]

    state["rounds_completed"] = next_round
    state["status"] = "ok"
    state["blocker_reason"] = None
    round_record: dict[str, Any] = {
        "round": next_round,
        "mode": mode,
        "retried": retried,
        "verdict": result["verdict"],
        "findings_summary": result["findings_summary"],
        "nit_only": result["nit_only"],
        "usage": round_usage,
        "attempt_usages": attempt_usages,
        "thread_id": state.get("thread_id"),
        "artifacts": result["artifacts"],
    }
    if result.get("verdict_coerced"):
        round_record["verdict_coerced"] = True
        round_record["verdict_warning"] = result["verdict_warning"]
    state["rounds"].append(round_record)
    save_session_state(session_dir, state)

    payload: dict[str, Any] = {
        "status": "ok",
        "session": session_dir,
        "round": next_round,
        "max_rounds": state["max_rounds"],
        "extended_max_rounds": cfg.get("extended_max_rounds", DEFAULT_CONFIG["extended_max_rounds"]),
        "model": cfg["model"],
        "effort": cfg["effort"],
        "mode": mode,
        "retried": retried,
        "verdict": result["verdict"],
        "findings_summary": result["findings_summary"],
        "nit_only": result["nit_only"],
        "usage": round_usage,
        "artifacts": result["artifacts"],
        "findings": result["findings"],
    }
    if result.get("verdict_coerced"):
        payload["verdict_coerced"] = True
        payload["verdict_warning"] = result["verdict_warning"]
    return emit_json(payload)


def cmd_receipt(args: argparse.Namespace) -> int:
    session_dir = os.path.abspath(args.session)
    state = load_session_state(session_dir)
    cfg = state["config"]
    rounds = state.get("rounds", [])
    last = rounds[-1] if rounds else None
    usage_total, usage_complete, usage_exposed_rounds = aggregate_usage(
        rounds, state.get("failed_attempt_usages")
    )
    final_diff_stat = compute_diff_stat(state["repo"], state["base"], state.get("scoped_paths", []))

    return emit_json(
        {
            "session": session_dir,
            "repo": state["repo"],
            "base": state["base"],
            "scoped_paths": state.get("scoped_paths", []),
            "model": cfg["model"],
            "effort": cfg["effort"],
            "thread_mode": cfg.get("thread_mode", "resume"),
            "status": state["status"],
            "rounds_completed": state["rounds_completed"],
            "max_rounds": state["max_rounds"],
            "extended_max_rounds": cfg.get("extended_max_rounds", DEFAULT_CONFIG["extended_max_rounds"]),
            "budget_extensions": state.get("budget_extensions", []),
            "final_verdict": last["verdict"] if last else None,
            "nit_only": last["nit_only"] if last else False,
            "blocker_reason": state.get("blocker_reason"),
            "initial_diff_stat": state.get("initial_diff_stat"),
            "final_diff_stat": final_diff_stat,
            "usage_total": usage_total,
            "usage_complete": usage_complete,
            "usage_exposed_rounds": usage_exposed_rounds,
            "response_paths": [r["artifacts"]["response"] for r in rounds],
            "rounds": [
                {
                    "round": r["round"],
                    "mode": r["mode"],
                    "verdict": r["verdict"],
                    "findings_summary": r["findings_summary"],
                    "nit_only": r["nit_only"],
                    **(
                        {
                            "verdict_coerced": True,
                            "verdict_warning": r.get("verdict_warning"),
                        }
                        if r.get("verdict_coerced")
                        else {}
                    ),
                    "usage": r["usage"],
                    "response": r["artifacts"]["response"],
                }
                for r in rounds
            ],
        }
    )


def build_parser() -> argparse.ArgumentParser:
    epilog = (
        "Defaults: model=gpt-6.2-sol, effort=xhigh, thread_mode=resume, max_rounds=3 (extendable to 5), timeout=900s.\n"
        "Overrides: CLI flags > SOL_LOOP_* env vars > defaults.\n"
        "Exit codes: 0 = structured JSON outcome on stdout (status: ok | blocked | budget_exhausted); "
        "2 = usage or input error on stderr."
    )
    parser = argparse.ArgumentParser(
        prog="review",
        description="Deterministic GPT Sol review runner for the sol-loop skill.",
        epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_start = sub.add_parser("start", help="Run Round 1 Sol review and create a session directory")
    p_start.add_argument("--repo", help="Absolute path of target repo (default: current directory)")
    p_start.add_argument("--base", required=True, help="Base git SHA, ref, or empty tree for the review diff")
    p_start.add_argument("--intent", help="Intent summary (1-2 sentences or brief)")
    p_start.add_argument("--intent-file", help="Path to intent file ('-' for stdin)")
    p_start.add_argument("--out-of-scope", help="Out-of-scope summary (optional)")
    p_start.add_argument("--out-of-scope-file", help="Path to out-of-scope file ('-' for stdin)")
    p_start.add_argument("--checks", help="Covering check commands and pass/fail results (or missing/pre-failing note)")
    p_start.add_argument("--checks-file", help="Path to checks file ('-' for stdin)")
    p_start.add_argument(
        "--path",
        "--paths",
        dest="paths",
        nargs="+",
        action="extend",
        help="Scoped file paths when isolating this change from unrelated dirty files (omit to review all changes from base)",
    )
    p_start.add_argument(
        "--rule",
        "--rules",
        dest="rules",
        nargs="+",
        action="extend",
        help="Additional repo rule files (merged with auto-discovered rules unless --no-auto-rules is set)",
    )
    p_start.add_argument("--no-auto-rules", action="store_true", help="Skip automatic AGENTS.md/CLAUDE.md discovery")
    p_start.add_argument("--model", help="Sol model override (default: gpt-6.2-sol)")
    p_start.add_argument("--effort", help="Reasoning effort override (default: xhigh)")
    p_start.add_argument(
        "--thread-mode",
        choices=VALID_THREAD_MODES,
        help="Multi-round thread strategy: resume (default) or fresh per round",
    )
    p_start.add_argument("--max-rounds", type=int, help="Maximum review rounds (default: 3)")
    p_start.add_argument("--timeout", type=int, help="Per-round timeout in seconds (default: 900)")
    p_start.add_argument("--codex-bin", help="Path or name of codex CLI binary")
    p_start.add_argument("--session-dir", help="Optional empty directory outside repo for session artifacts")
    p_start.set_defaults(func=cmd_start)

    p_reply = sub.add_parser("reply", help="Run Round N delta review on an existing session")
    p_reply.add_argument("--session", required=True, help="Session directory returned by 'start'")
    p_reply.add_argument("--ledger", help="Updated findings ledger text (fixed/disagree/declined + evidence)")
    p_reply.add_argument("--ledger-file", help="Path to updated ledger file ('-' for stdin)")
    p_reply.add_argument(
        "--changed-path",
        "--changed-paths",
        dest="changed_paths",
        nargs="+",
        action="extend",
        help="Paths modified or added since the previous round (omit if none changed)",
    )
    p_reply.add_argument("--checks", help="Updated check commands and pass/fail results")
    p_reply.add_argument("--checks-file", help="Path to updated checks file ('-' for stdin)")
    p_reply.add_argument("--max-rounds", type=int, help="Raise session max rounds (e.g. 5 for security/concurrency)")
    p_reply.add_argument("--extend-reason", help="Reason for raising --max-rounds (required when extending budget)")
    p_reply.add_argument(
        "--fresh",
        action="store_true",
        help="Start a fresh Sol thread for this round instead of resuming",
    )
    p_reply.add_argument("--timeout", type=int, help="Override timeout in seconds for this round")
    p_reply.set_defaults(func=cmd_reply)

    p_receipt = sub.add_parser("receipt", help="Print structured review receipt and before/after diff stats")
    p_receipt.add_argument("--session", required=True, help="Session directory returned by 'start'")
    p_receipt.set_defaults(func=cmd_receipt)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
        return args.func(args)
    except UsageError as exc:
        sys.stderr.write(f"review: error: {exc}\n")
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
